<?php
/**
 * @file
 * Tests for the DropBridge module.
 */

/**
 * Tests for inbound email settings and webhook token handling.
 */
class DropBridgeInboundSettingsTest extends BackdropWebTestCase {

  public static function getInfo() {
    return array(
      'name'        => 'DropBridge Inbound Settings',
      'description' => 'Webhook token can be saved, cleared, and empty token disables webhook.',
      'group'       => 'DropBridge',
    );
  }

  public function setUp() {
    parent::setUp('dropbridge');
  }

  /**
   * Webhook token can be set and cleared via the settings form.
   */
  public function testWebhookTokenCanBeSetAndCleared() {
    $admin = $this->backdropCreateUser(array('administer site configuration'));
    $this->backdropLogin($admin);

    // Set a token.
    $edit = array(
      'webhook_token' => 'my-secret-token',
    );
    $this->backdropPost('drop/settings/inbound', $edit, t('Save settings'));
    $this->assertText('Inbound email settings saved', 'Settings saved with token.');

    $token = config_get('dropbridge.inbound', 'webhook_token');
    $this->assertEqual('my-secret-token', $token, 'Token is stored in config.');

    // Clear the token.
    $edit = array(
      'webhook_token' => '',
    );
    $this->backdropPost('drop/settings/inbound', $edit, t('Save settings'));
    $this->assertText('Inbound email settings saved', 'Settings saved after clearing token.');

    $token = config_get('dropbridge.inbound', 'webhook_token');
    $this->assertTrue(empty($token), 'Token is empty in config after clearing.');
  }

  /**
   * When no webhook token is configured, the inbound email webhook is disabled.
   *
   * Verifies the config-level guard: if webhook_token is empty, the webhook
   * function would reject POSTs. We check the config rather than calling the
   * function directly because it uses backdrop_exit().
   */
  public function testEmptyTokenDisablesWebhook() {
    // Ensure token is empty by default.
    $token = config_get('dropbridge.inbound', 'webhook_token');
    $this->assertTrue(empty($token), 'Default webhook token is empty.');

    // Verify the inbound webhook route exists.
    $item = menu_get_item('dropbridge/inbound-email');
    $this->assertTrue(!empty($item), 'Inbound email webhook route is registered.');
  }
}
