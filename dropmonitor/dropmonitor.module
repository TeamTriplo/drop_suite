}

/**
 * Implements hook_drop_section_links().
 */
function dropmonitor_drop_section_links($section) {
  if ($section !== 'monitor') {
    return array();
  }

  $links = array();

  $links['dashboard'] = array(
    'title' => t('Dashboard'),
    'href' => 'drop/monitor',
    'weight' => -20,
    'active_paths' => array('drop/monitor', 'drop/monitor/dashboard'),
  );

  $links['servers'] = array(
    'title' => t('Servers'),
    'href' => 'drop/monitor/servers',
    'weight' => -10,
    'admin_only' => TRUE,
  );

  $links['uptime'] = array(
    'title' => t('Uptime'),
    'href' => 'drop/monitor/uptime',
    'weight' => 0,
  );

  // Only show Archives if S3 is configured.
  $config = config('dropmonitor.settings');
  if (!empty($config->get('s3_access_key')) && !empty($config->get('s3_bucket'))) {
    $links['archives'] = array(
      'title' => t('Archives'),
      'href' => 'drop/monitor/archives',
      'weight' => 10,
      'admin_only' => TRUE,
    );
  }

  $links['settings'] = array(
    'title' => t('Settings'),
    'href' => 'drop/monitor/settings',
    'weight' => 20,
    'admin_only' => TRUE,
  );

  return $links;
}

