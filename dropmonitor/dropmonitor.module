/**
 * Menu loader for %dropmonitor_server.
 */
function dropmonitor_server_load($sid) {
  $server = db_select('dropmonitor_server', 's')
    ->fields('s')
    ->condition('sid', $sid)
    ->execute()
    ->fetchObject();
  return $server ?: FALSE;
}

/**
 * Title callback for server detail page.
 */
function dropmonitor_server_title($server) {
  return check_plain($server->label);
}

/**
 * Implements hook_cron().
 */
function dropmonitor_cron() {
  // Server checks (Linode API, HTTP, agent) — run on configurable interval.
  $config = config('dropmonitor.settings');
  $interval = $config->get('check_interval');
  $last_server_check = state_get('dropmonitor_last_cron', 0);

  if ((REQUEST_TIME - $last_server_check) >= $interval) {
    module_load_include('inc', 'dropmonitor', 'dropmonitor.checks');
    dropmonitor_run_all_checks();
    state_set('dropmonitor_last_cron', REQUEST_TIME);
  }

  // Uptime checks — run frequently; per-project intervals are enforced inside.
  $last_uptime = state_get('dropmonitor_last_uptime', 0);
  if ((REQUEST_TIME - $last_uptime) >= 240) { // At least 4 minutes apart.
    module_load_include('inc', 'dropmonitor', 'dropmonitor.uptime');
    if (db_table_exists('dropmonitor_uptime')) {
      dropmonitor_run_uptime_checks();
      state_set('dropmonitor_last_uptime', REQUEST_TIME);
    }
  }

  // Purge old uptime "up" records daily.
  $last_purge = state_get('dropmonitor_last_purge', 0);
  if ((REQUEST_TIME - $last_purge) >= 86400) {
    module_load_include('inc', 'dropmonitor', 'dropmonitor.uptime');
    dropmonitor_uptime_purge(14);
    state_set('dropmonitor_last_purge', REQUEST_TIME);
  }
}

/**
 * Uptime check endpoint — called by system cron every 5 minutes.
 *
 * Per-project check intervals are enforced inside the check function.
 * Example crontab entry:
 *   *​/5 * * * * curl -s "https://support.simplo.site/drop/monitor/uptime-check?token=SECRET"
 */
function dropmonitor_uptime_check_endpoint() {
  $config = config('dropmonitor.settings');
  $token = $config->get('uptime_token');

  if (empty($token) || !isset($_GET['token']) || $_GET['token'] !== $token) {
    backdrop_add_http_header('Status', '403 Forbidden');
    backdrop_json_output(array('error' => 'Invalid token'));
    backdrop_exit();
  }

  module_load_include('inc', 'dropmonitor', 'dropmonitor.uptime');
  dropmonitor_run_uptime_checks();

  backdrop_json_output(array('status' => 'ok', 'time' => REQUEST_TIME));
  backdrop_exit();
}

// -------------------------------------------------------------------------
// Helper functions.
// -------------------------------------------------------------------------

/**
 * Returns all active servers.
 */
function dropmonitor_get_servers($active_only = TRUE) {
  $query = db_select('dropmonitor_server', 's')
    ->fields('s')
    ->orderBy('weight')
    ->orderBy('label');
  if ($active_only) {
    $query->condition('active', 1);
  }
  return $query->execute()->fetchAll();
}

/**
 * Returns the latest check results for a server, keyed by check_type.
 */
function dropmonitor_get_checks($sid) {
  return db_select('dropmonitor_check', 'c')
    ->fields('c')
    ->condition('sid', $sid)
    ->execute()
    ->fetchAllAssoc('check_type');
}

/**
 * Saves a check result (upserts on sid + check_type).
 */
function dropmonitor_save_check($sid, $check_type, $status, $data = array()) {
  db_merge('dropmonitor_check')
    ->key(array(
      'sid' => $sid,
      'check_type' => $check_type,
    ))
    ->fields(array(
      'status' => $status,
      'data' => json_encode($data),
      'checked' => REQUEST_TIME,
    ))
    ->execute();
}

/**
 * Returns a status label with CSS class.
 */
function dropmonitor_status_badge($status) {
  $labels = array(
    'ok' => t('OK'),
    'warning' => t('Warning'),
    'critical' => t('Critical'),
    'error' => t('Error'),
    'unknown' => t('Unknown'),
  );
  $label = isset($labels[$status]) ? $labels[$status] : $labels['unknown'];
  return '<span class="dropmonitor-status dropmonitor-status-' . $status . '">' . $label . '</span>';
}

/**
 * Returns the worst status from an array of check results.
 */
function dropmonitor_overall_status($checks) {
  $severity = array('ok' => 0, 'warning' => 1, 'critical' => 2, 'error' => 3);
  $worst = 'ok';
  foreach ($checks as $check) {
    $s = $check->status;
    if (isset($severity[$s]) && $severity[$s] > $severity[$worst]) {
      $worst = $s;
    }
  }
  return $worst;
}

/**
 * Syncs servers from Linode API.
 *
 * Fetches all instances from Linode, creates new servers, and updates
 * metadata for existing ones.
 *
 * @return array
 *   Array with 'added' and 'updated' counts.
 */
function dropmonitor_sync_servers_from_linode() {
  $config = config('dropmonitor.settings');
  $api_token = $config->get('linode_api_token');

  if (empty($api_token)) {
    watchdog('dropmonitor', 'Linode sync failed: No API token configured.', array(), WATCHDOG_WARNING);
    return array(
      'added' => 0,
      'updated' => 0,
      'error' => 'No Linode API token configured.',
    );
  }

  watchdog('dropmonitor', 'Starting Linode API sync.', array(), WATCHDOG_INFO);

  module_load_include('inc', 'dropmonitor', 'dropmonitor.checks');
  $instances = _dropmonitor_linode_api('linode/instances', $api_token);

  if (!$instances || !isset($instances['data'])) {
    watchdog('dropmonitor', 'Linode sync failed: API returned no data. Response: @response', array(
      '@response' => print_r($instances, TRUE),
    ), WATCHDOG_ERROR);
    return array(
      'added' => 0,
      'updated' => 0,
      'error' => 'Failed to fetch servers from Linode API.',
    );
  }

  $added = 0;
  $updated = 0;

  foreach ($instances['data'] as $instance) {
    $linode_id = $instance['id'];

    // Extract metadata.
    $disk_size = isset($instance['specs']['disk']) ? $instance['specs']['disk'] / 1024 : NULL;
    $memory = isset($instance['specs']['memory']) ? $instance['specs']['memory'] : NULL;
    $vcpus = isset($instance['specs']['vcpus']) ? $instance['specs']['vcpus'] : NULL;
    $region = isset($instance['region']) ? $instance['region'] : NULL;
    $linode_type = isset($instance['type']) ? $instance['type'] : NULL;
    $linode_status = isset($instance['status']) ? $instance['status'] : NULL;
    $ipv4 = isset($instance['ipv4'][0]) ? $instance['ipv4'][0] : NULL;
    $label = isset($instance['label']) ? $instance['label'] : 'Linode ' . $linode_id;

    // Convert Linode created timestamp to Unix time.
    $linode_created = NULL;
    if (isset($instance['created'])) {
      $linode_created = strtotime($instance['created']);
    }

    // Check if server already exists.
    $existing = db_select('dropmonitor_server', 's')
      ->fields('s')
      ->condition('linode_id', $linode_id)
      ->execute()
      ->fetchObject();

    if ($existing) {
      // Update metadata.
      db_update('dropmonitor_server')
        ->fields(array(
          'disk_size' => $disk_size,
          'memory' => $memory,
          'vcpus' => $vcpus,
          'region' => $region,
          'linode_type' => $linode_type,
          'linode_status' => $linode_status,
          'ipv4' => $ipv4,
          'linode_created' => $linode_created,
        ))
        ->condition('linode_id', $linode_id)
        ->execute();
      $updated++;
    }
    else {
      // Create new server with placeholder site_url.
      $site_url = !empty($ipv4) ? 'http://' . $ipv4 : 'http://localhost';
      db_insert('dropmonitor_server')
        ->fields(array(
          'label' => $label,
          'linode_id' => $linode_id,
          'site_url' => $site_url,
          'agent_url' => '',
          'agent_token' => '',
          'active' => 1,
          'weight' => 0,
          'created' => REQUEST_TIME,
          'disk_size' => $disk_size,
          'memory' => $memory,
          'vcpus' => $vcpus,
          'region' => $region,
          'linode_type' => $linode_type,
          'linode_status' => $linode_status,
          'ipv4' => $ipv4,
          'linode_created' => $linode_created,
        ))
        ->execute();
      $added++;
    }
  }

  watchdog('dropmonitor', 'Linode sync complete: @added added, @updated updated out of @total instances.', array(
    '@added' => $added,
    '@updated' => $updated,
    '@total' => count($instances['data']),
  ), WATCHDOG_INFO);

  return array(
    'added' => $added,
    'updated' => $updated,
  );
}
