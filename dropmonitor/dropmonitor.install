<?php
/**
 * @file
 * Install, update, and uninstall functions for Drop Monitor.
 */

/**
 * Implements hook_schema().
 */
function dropmonitor_schema() {
  $schema = array();

  // Servers to monitor.
  $schema['dropmonitor_server'] = array(
    'description' => 'Servers monitored by Drop Monitor.',
    'fields' => array(
      'sid' => array(
        'description' => 'Primary key.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'label' => array(
        'description' => 'Human-readable server label.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ),
      'linode_id' => array(
        'description' => 'Linode instance ID (optional).',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ),
      'site_url' => array(
        'description' => 'Primary site URL for HTTP checks.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ),
      'agent_url' => array(
        'description' => 'Status agent script URL (e.g. https://example.com/status.php).',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ),
      'agent_token' => array(
        'description' => 'Shared secret token for the status agent.',
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
        'default' => '',
      ),
      'active' => array(
        'description' => 'Whether this server is actively monitored.',
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 1,
      ),
      'weight' => array(
        'description' => 'Sort weight for display order.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
      'created' => array(
        'description' => 'Unix timestamp when added.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
      'disk_size' => array(
        'description' => 'Disk allocation in GB from Linode.',
        'type' => 'int',
        'not null' => FALSE,
      ),
      'memory' => array(
        'description' => 'RAM in MB from Linode.',
        'type' => 'int',
        'not null' => FALSE,
      ),
      'vcpus' => array(
        'description' => 'CPU cores from Linode.',
        'type' => 'int',
        'not null' => FALSE,
      ),
      'region' => array(
        'description' => 'Linode region (e.g., us-west, us-southeast).',
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
      ),
      'linode_type' => array(
        'description' => 'Instance type from Linode (e.g., g6-standard-2).',
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
      ),
      'linode_status' => array(
        'description' => 'Server status from Linode (running, offline, etc).',
        'type' => 'varchar',
        'length' => 32,
        'not null' => FALSE,
      ),
      'ipv4' => array(
        'description' => 'Primary IPv4 address from Linode.',
        'type' => 'varchar',
        'length' => 45,
        'not null' => FALSE,
      ),
      'linode_created' => array(
        'description' => 'Unix timestamp when created on Linode.',
        'type' => 'int',
        'not null' => FALSE,
      ),
    ),
    'primary key' => array('sid'),
    'indexes' => array(
      'active' => array('active'),
    ),
  );

  // Check results — one row per server per check type.
  $schema['dropmonitor_check'] = array(
    'description' => 'Latest check results per server.',
    'fields' => array(
      'cid' => array(
        'description' => 'Primary key.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'sid' => array(
        'description' => 'Server ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'check_type' => array(
        'description' => 'Type of check: http, agent, linode.',
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => '',
      ),
      'status' => array(
        'description' => 'Result status: ok, warning, critical, error.',
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
        'default' => '',
      ),
      'data' => array(
        'description' => 'JSON-encoded check result data.',
        'type' => 'text',
        'size' => 'medium',
        'not null' => FALSE,
      ),
      'checked' => array(
        'description' => 'Unix timestamp of this check.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
    ),
    'primary key' => array('cid'),
    'unique keys' => array(
      'server_type' => array('sid', 'check_type'),
    ),
    'indexes' => array(
      'sid' => array('sid'),
    ),
  );

  return $schema;
}

/**
 * Add Linode metadata columns to dropmonitor_server table.
 */
function dropmonitor_update_7001(&$sandbox) {
  $spec = array(
    'description' => 'Disk allocation in GB from Linode.',
    'type' => 'int',
    'not null' => FALSE,
  );
  if (!db_field_exists('dropmonitor_server', 'disk_size')) {
    db_add_field('dropmonitor_server', 'disk_size', $spec);
  }

  $spec = array(
    'description' => 'RAM in MB from Linode.',
    'type' => 'int',
    'not null' => FALSE,
  );
  if (!db_field_exists('dropmonitor_server', 'memory')) {
    db_add_field('dropmonitor_server', 'memory', $spec);
  }

  $spec = array(
    'description' => 'CPU cores from Linode.',
    'type' => 'int',
    'not null' => FALSE,
  );
  if (!db_field_exists('dropmonitor_server', 'vcpus')) {
    db_add_field('dropmonitor_server', 'vcpus', $spec);
  }

  $spec = array(
    'description' => 'Linode region (e.g., us-west, us-southeast).',
    'type' => 'varchar',
    'length' => 64,
    'not null' => FALSE,
  );
  if (!db_field_exists('dropmonitor_server', 'region')) {
    db_add_field('dropmonitor_server', 'region', $spec);
  }

  $spec = array(
    'description' => 'Instance type from Linode (e.g., g6-standard-2).',
    'type' => 'varchar',
    'length' => 64,
    'not null' => FALSE,
  );
  if (!db_field_exists('dropmonitor_server', 'linode_type')) {
    db_add_field('dropmonitor_server', 'linode_type', $spec);
  }

  $spec = array(
    'description' => 'Server status from Linode (running, offline, etc).',
    'type' => 'varchar',
    'length' => 32,
    'not null' => FALSE,
  );
  if (!db_field_exists('dropmonitor_server', 'linode_status')) {
    db_add_field('dropmonitor_server', 'linode_status', $spec);
  }

  $spec = array(
    'description' => 'Primary IPv4 address from Linode.',
    'type' => 'varchar',
    'length' => 45,
    'not null' => FALSE,
  );
  if (!db_field_exists('dropmonitor_server', 'ipv4')) {
    db_add_field('dropmonitor_server', 'ipv4', $spec);
  }

  $spec = array(
    'description' => 'Unix timestamp when created on Linode.',
    'type' => 'int',
    'not null' => FALSE,
  );
  if (!db_field_exists('dropmonitor_server', 'linode_created')) {
    db_add_field('dropmonitor_server', 'linode_created', $spec);
  }
}
