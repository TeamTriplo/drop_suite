<?php
/**
 * @file
 * Install, update, and uninstall functions for Drop Monitor.
 */

/**
 * Implements hook_install().
 */
function dropmonitor_install() {
  drop_base_grant_admin_permissions('dropmonitor');
}

/**
 * Implements hook_schema().
 */
function dropmonitor_schema() {
  $schema = array();

  // Servers to monitor.
  $schema['dropmonitor_server'] = array(
    'description' => 'Servers monitored by Drop Monitor.',
    'fields' => array(
      'sid' => array(
        'description' => 'Primary key.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'label' => array(
        'description' => 'Human-readable server label.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ),
      'linode_id' => array(
        'description' => 'Linode instance ID (optional).',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ),
      'site_url' => array(
        'description' => 'Primary site URL for HTTP checks.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ),
      'agent_url' => array(
        'description' => 'Status agent script URL (e.g. https://example.com/status.php).',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ),
      'agent_token' => array(
        'description' => 'Shared secret token for the status agent.',
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
        'default' => '',
      ),
      'active' => array(
        'description' => 'Whether this server is actively monitored.',
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 1,
      ),
      'weight' => array(
        'description' => 'Sort weight for display order.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
      'created' => array(
        'description' => 'Unix timestamp when added.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
      'disk_size' => array(
        'description' => 'Disk allocation in GB from Linode.',
        'type' => 'int',
        'not null' => FALSE,
      ),
      'memory' => array(
        'description' => 'RAM in MB from Linode.',
        'type' => 'int',
        'not null' => FALSE,
      ),
      'vcpus' => array(
        'description' => 'CPU cores from Linode.',
        'type' => 'int',
        'not null' => FALSE,
      ),
      'region' => array(
        'description' => 'Linode region (e.g., us-west, us-southeast).',
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
      ),
      'linode_type' => array(
        'description' => 'Instance type from Linode (e.g., g6-standard-2).',
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
      ),
      'linode_status' => array(
        'description' => 'Server status from Linode (running, offline, etc).',
        'type' => 'varchar',
        'length' => 32,
        'not null' => FALSE,
      ),
      'ipv4' => array(
        'description' => 'Primary IPv4 address from Linode.',
        'type' => 'varchar',
        'length' => 45,
        'not null' => FALSE,
      ),
      'origin_ip' => array(
        'description' => 'Origin IP to bypass CDN (e.g. Cloudflare) for agent checks.',
        'type' => 'varchar',
        'length' => 45,
        'not null' => TRUE,
        'default' => '',
      ),
      'linode_created' => array(
        'description' => 'Unix timestamp when created on Linode.',
        'type' => 'int',
        'not null' => FALSE,
      ),
    ),
    'primary key' => array('sid'),
    'indexes' => array(
      'active' => array('active'),
    ),
  );

  // Check results — one row per server per check type.
  $schema['dropmonitor_check'] = array(
    'description' => 'Latest check results per server.',
    'fields' => array(
      'cid' => array(
        'description' => 'Primary key.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'sid' => array(
        'description' => 'Server ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'check_type' => array(
        'description' => 'Type of check: http, agent, linode.',
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => '',
      ),
      'status' => array(
        'description' => 'Result status: ok, warning, critical, error.',
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
        'default' => '',
      ),
      'data' => array(
        'description' => 'JSON-encoded check result data.',
        'type' => 'text',
        'size' => 'medium',
        'not null' => FALSE,
      ),
      'checked' => array(
        'description' => 'Unix timestamp of this check.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
    ),
    'primary key' => array('cid'),
    'unique keys' => array(
      'server_type' => array('sid', 'check_type'),
    ),
    'indexes' => array(
      'sid' => array('sid'),
    ),
  );

  // Uptime log — one row per check per project.
  $schema['dropmonitor_uptime'] = array(
    'description' => 'Uptime check log for project websites.',
    'fields' => array(
      'uid' => array(
        'description' => 'Primary key.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'pid' => array(
        'description' => 'Project ID from drop_project.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'status' => array(
        'description' => '1 = up, 0 = down.',
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 1,
      ),
      'response_code' => array(
        'description' => 'HTTP response code.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
      'response_ms' => array(
        'description' => 'Response time in milliseconds.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
      'checked' => array(
        'description' => 'Unix timestamp of this check.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
    ),
    'primary key' => array('uid'),
    'indexes' => array(
      'pid' => array('pid'),
      'pid_checked' => array('pid', 'checked'),
      'status' => array('status'),
    ),
  );

  // Active outage alerts — one row per project per team member.
  $schema['dropmonitor_alert'] = array(
    'description' => 'Active outage alerts for team members.',
    'fields' => array(
      'aid' => array(
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'pid' => array(
        'description' => 'Project ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'uid' => array(
        'description' => 'User ID to notify.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'is_read' => array(
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ),
      'created' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
    ),
    'primary key' => array('aid'),
    'indexes' => array(
      'uid_read' => array('uid', 'is_read'),
      'pid' => array('pid'),
    ),
  );

  return $schema;
}

/**
 * Add Linode metadata columns to dropmonitor_server table.
 */
function dropmonitor_update_1001() {
  $spec = array(
    'description' => 'Disk allocation in GB from Linode.',
    'type' => 'int',
    'not null' => FALSE,
  );
  if (!db_field_exists('dropmonitor_server', 'disk_size')) {
    db_add_field('dropmonitor_server', 'disk_size', $spec);
  }

  $spec = array(
    'description' => 'RAM in MB from Linode.',
    'type' => 'int',
    'not null' => FALSE,
  );
  if (!db_field_exists('dropmonitor_server', 'memory')) {
    db_add_field('dropmonitor_server', 'memory', $spec);
  }

  $spec = array(
    'description' => 'CPU cores from Linode.',
    'type' => 'int',
    'not null' => FALSE,
  );
  if (!db_field_exists('dropmonitor_server', 'vcpus')) {
    db_add_field('dropmonitor_server', 'vcpus', $spec);
  }

  $spec = array(
    'description' => 'Linode region (e.g., us-west, us-southeast).',
    'type' => 'varchar',
    'length' => 64,
    'not null' => FALSE,
  );
  if (!db_field_exists('dropmonitor_server', 'region')) {
    db_add_field('dropmonitor_server', 'region', $spec);
  }

  $spec = array(
    'description' => 'Instance type from Linode (e.g., g6-standard-2).',
    'type' => 'varchar',
    'length' => 64,
    'not null' => FALSE,
  );
  if (!db_field_exists('dropmonitor_server', 'linode_type')) {
    db_add_field('dropmonitor_server', 'linode_type', $spec);
  }

  $spec = array(
    'description' => 'Server status from Linode (running, offline, etc).',
    'type' => 'varchar',
    'length' => 32,
    'not null' => FALSE,
  );
  if (!db_field_exists('dropmonitor_server', 'linode_status')) {
    db_add_field('dropmonitor_server', 'linode_status', $spec);
  }

  $spec = array(
    'description' => 'Primary IPv4 address from Linode.',
    'type' => 'varchar',
    'length' => 45,
    'not null' => FALSE,
  );
  if (!db_field_exists('dropmonitor_server', 'ipv4')) {
    db_add_field('dropmonitor_server', 'ipv4', $spec);
  }

  $spec = array(
    'description' => 'Unix timestamp when created on Linode.',
    'type' => 'int',
    'not null' => FALSE,
  );
  if (!db_field_exists('dropmonitor_server', 'linode_created')) {
    db_add_field('dropmonitor_server', 'linode_created', $spec);
  }
}

/**
 * Create dropmonitor_uptime table for project uptime monitoring.
 */
function dropmonitor_update_1002() {
  if (!db_table_exists('dropmonitor_uptime')) {
    $schema = dropmonitor_schema();
    db_create_table('dropmonitor_uptime', $schema['dropmonitor_uptime']);
  }
  return t('Created uptime monitoring table.');
}

/**
 * Add origin_ip column to dropmonitor_server for CDN bypass.
 */
function dropmonitor_update_1004() {
  if (!db_field_exists('dropmonitor_server', 'origin_ip')) {
    db_add_field('dropmonitor_server', 'origin_ip', array(
      'description' => 'Origin IP to bypass CDN (e.g. Cloudflare) for agent checks.',
      'type' => 'varchar',
      'length' => 45,
      'not null' => TRUE,
      'default' => '',
    ));
  }
  return t('Added origin IP field for CDN bypass.');
}

/**
 * Create dropmonitor_alert table for outage notifications.
 */
function dropmonitor_update_1003() {
  if (!db_table_exists('dropmonitor_alert')) {
    $schema = dropmonitor_schema();
    db_create_table('dropmonitor_alert', $schema['dropmonitor_alert']);
  }
  return t('Created outage alert table.');
}
