<?php
/**
 * @file
 * Install, update, and uninstall functions for the Drop Suite module.
 */

/**
 * Implements hook_schema().
 */
function drop_suite_schema() {
  $schema = array();

  $schema['drop_project'] = array(
    'description' => 'Projects used across the Drop Suite for tickets, time tracking, and monitoring.',
    'fields' => array(
      'pid' => array(
        'type'     => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'name' => array(
        'type'     => 'varchar',
        'length'   => 255,
        'not null' => TRUE,
        'default'  => '',
        'description' => 'Project name.',
      ),
      'color' => array(
        'type'     => 'varchar',
        'length'   => 7,
        'not null' => TRUE,
        'default'  => '#1565c0',
        'description' => 'Display color as a CSS hex value.',
      ),
      'active' => array(
        'type'     => 'int',
        'size'     => 'tiny',
        'not null' => TRUE,
        'default'  => 1,
        'description' => '1 = active, 0 = archived.',
      ),
      'cid' => array(
        'description' => 'Optional linked CRM contact ID.',
        'type'        => 'int',
        'unsigned'    => TRUE,
        'not null'    => FALSE,
        'default'     => NULL,
      ),
      'prefix' => array(
        'description' => 'Short prefix for ticket numbers, e.g. TRIP for TRIP-42.',
        'type'        => 'varchar',
        'length'      => 10,
        'not null'    => FALSE,
        'default'     => NULL,
      ),
      'ticket_counter' => array(
        'description' => 'Auto-incrementing counter for ticket labels within this project.',
        'type'        => 'int',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
        'default'     => 0,
      ),
      'site_url' => array(
        'description' => 'Website URL for the project (used by uptime monitoring).',
        'type'        => 'varchar',
        'length'      => 255,
        'not null'    => TRUE,
        'default'     => '',
      ),
      // Platform/health_url/gentle_monitor/check_interval/server_sid/
      // agent_site_key columns are now owned by dropmonitor. See
      // dropmonitor_install(); on sites where dropmonitor is enabled the
      // columns are added idempotently. drop_suite no longer declares them
      // because they're useless without dropmonitor.
      'uid' => array(
        'type'     => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default'  => 0,
      ),
      'created' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'changed' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
    ),
    'primary key' => array('pid'),
    'indexes' => array(
      'uid'    => array('uid'),
      'active' => array('active'),
      'cid'    => array('cid'),
    ),
  );

  return $schema;
}

/**
 * Implements hook_install().
 */
function drop_suite_install() {
  // Rebuild the menu router first so that drop/settings (defined in
  // drop_suite_menu()) is a known path. Without this, menu_link_save()
  // silently fails because it can't find a matching router_path.
  menu_rebuild();

  // Create a "Drop Suite" link in the primary navigation menu.
  $item = array(
    'link_title' => 'Drop Suite',
    'link_path'  => 'drop/settings',
    'weight'     => 50,
  );
  $mlid = menu_link_save($item);

  // Silent on success — the install just finished, admin knows.
  // Only report if the menu link couldn't be created.
  if (!$mlid) {
    backdrop_set_message(t('Failed to create Drop Suite menu link. The path drop/settings may not be registered yet.'), 'warning');
  }

  // Switch the default layout to the Drop Suite layout template, then add
  // Drop Suite blocks to the TOP region.
  _drop_suite_setup_default_layout();

  // Grant drop_suite's own permissions to the site administrator role.
  drop_suite_grant_admin_permissions('drop_suite');

  // Home-page navigation is handled by the Drop Start setup wizard, which
  // emits its own post-install message. Nothing else to set up here.
}

/**
 * Switches the default layout to the Drop Suite template and sets up the
 * TOP region with Drop Suite blocks.
 *
 * - Changes the layout template to drop_suite
 * - Removes the "Page title combo" block
 * - Adds: Page title, Drop Navigation, Drop Pin Action, Drop Section Navigation
 */
function _drop_suite_setup_default_layout() {
  _drop_suite_setup_drop_pages_layout();
  _drop_suite_revert_default_layout_template();
}

/**
 * Creates or updates the drop_pages layout — the dedicated layout for
 * /drop/* paths. Switches to drop_suite template, installs the standard
 * Drop blocks in TOP, reorders tabs, dedupes positions. Idempotent.
 *
 * Layout matching for this layout is handled by
 * drop_suite_layout_load_by_router_item_alter() rather than a path field,
 * because drop/* covers 300+ concrete router paths that can't be enumerated
 * up front.
 */
function _drop_suite_setup_drop_pages_layout() {
  $layout = layout_load('drop_pages');
  if (!$layout) {
    // Seed a fresh layout. path is NULL because the alter hook picks it.
    $layout = new Layout(array(
      'name'            => 'drop_pages',
      'title'           => 'Drop Suite pages',
      'description'     => 'Layout used for all /drop/* paths. Selected via drop_suite_layout_load_by_router_item_alter().',
      'module'          => 'drop_suite',
      'layout_template' => 'drop_suite',
      'path'            => NULL,
      'weight'          => -10,
      'settings'        => array(
        'title'         => '',
        'title_display' => 'default',
        'title_block'   => NULL,
      ),
      'positions'       => array(),
      'content'         => array(),
    ));
  }

  // Switch to the Drop Suite template (safe on re-save too).
  $layout->layout_template = 'drop_suite';

  // Ensure the positions array has all Drop Suite regions.
  foreach (array('header', 'navigation', 'messages', 'top', 'content', 'sidebar', 'bottom', 'footer') as $region) {
    if (!isset($layout->positions[$region])) {
      $layout->positions[$region] = array();
    }
  }

  // Remove blocks we don't want in the Drop Suite layout.
  _drop_suite_remove_blocks_by_plugin($layout, array(
    'system:page_components:title_combo',
    'drop_suite:drop_pin_action',
  ));

  // Ensure the required blocks are present in the TOP region.
  $wanted = array(
    'system:page_components:tabs',
    'system:page_components:messages',
    'system:page_components:action_links',
    'system:page_components:title',
    'drop_suite:drop_nav',
    'drop_suite:drop_section_nav',
  );
  foreach ($wanted as $plugin) {
    _drop_suite_ensure_block_in_region($layout, $plugin, 'top');
  }

  // Header region: site header (logo + site name + user menu) and main-menu
  // dropdown. Added idempotently so existing user customizations survive.
  $header_uuid = _drop_suite_ensure_block_in_region($layout, 'system:header', 'header');
  if ($header_uuid && isset($layout->content[$header_uuid])) {
    $layout->content[$header_uuid]->settings['block_settings'] = array(
      'menu'        => 'user-menu',
      'logo'        => 1,
      'site_name'   => 1,
      'site_slogan' => 0,
    );
  }
  $main_menu_uuid = _drop_suite_ensure_block_in_region($layout, 'system:main-menu', 'header');
  if ($main_menu_uuid && isset($layout->content[$main_menu_uuid])) {
    $layout->content[$main_menu_uuid]->settings['title_display'] = 'none';
    $layout->content[$main_menu_uuid]->settings['block_settings'] = array(
      'menu_name'   => 'main-menu',
      'style'       => 'dropdown',
      'level'       => '1',
      'depth'       => '0',
      'expand_all'  => 0,
      'clickdown'   => '0',
      'toggle'      => 1,
      'toggle_text' => 'Menu',
      'collapse'    => 'default',
      'accordion'   => 0,
    );
  }

  // Ensure the CONTENT region has the main content block, otherwise the
  // page body won't render. New drop_pages layouts need this explicitly;
  // existing ones already have it.
  if (empty($layout->positions['content'])) {
    $layout->addBlock('system', 'main', 'content');
  }

  _drop_suite_reorder_tabs_below_section_nav($layout);
  _drop_suite_move_title_to_end_of_top($layout);
  _drop_suite_dedupe_layout_positions($layout);
  _drop_suite_strip_orphan_regions($layout);

  $layout->save();
  // Intentionally no message — layout setup is a mechanical implementation
  // detail admins don't need to acknowledge. The wizard prompt from
  // drop_start_install() is the useful post-install pointer.
}

/**
 * Moves the page_components:title block in the TOP region to the last
 * position in that region. Idempotent.
 *
 * Title after tabs matches how Drop Suite pages visually lay out (page
 * title floats below the nav chrome, right above the content area).
 */
function _drop_suite_move_title_to_end_of_top($layout) {
  if (empty($layout->positions['top'])) {
    return;
  }
  $title_uuid = NULL;
  foreach ($layout->content as $uuid => $block) {
    if (isset($block->plugin) && $block->plugin === 'system:page_components:title') {
      $title_uuid = $uuid;
      break;
    }
  }
  if (!$title_uuid) {
    return;
  }
  $positions = $layout->positions['top'];
  $idx = array_search($title_uuid, $positions, TRUE);
  if ($idx === FALSE) {
    return;
  }
  // Already last?
  if ($idx === count($positions) - 1) {
    return;
  }
  array_splice($positions, $idx, 1);
  $positions[] = $title_uuid;
  $layout->positions['top'] = $positions;
}

/**
 * Reverts the default Backdrop layout: switches template back to
 * moscone_flipped (the stock default) and strips Drop-specific blocks.
 * Keeps all non-Drop blocks in place so existing custom placements survive.
 */
function _drop_suite_revert_default_layout_template() {
  $layout = layout_load('default');
  if (!$layout) {
    return;
  }

  // Only revert if we had switched it — avoid clobbering sites that picked
  // a different template on purpose.
  if ($layout->layout_template === 'drop_suite') {
    $layout->layout_template = 'moscone_flipped';
  }

  // Strip Drop-specific blocks from default so they only render on drop/*.
  $stripped = _drop_suite_remove_blocks_by_plugin($layout, array(
    'drop_suite:drop_nav',
    'drop_suite:drop_section_nav',
    'drop_suite:drop_pin_action',
    'drop_start:wizard_progress',
  ));

  _drop_suite_dedupe_layout_positions($layout);
  $layout->save();
  // No message on success — this helper runs during install + update
  // migrations where admins don't need a "we changed a layout" notice.
}

/**
 * Idempotent add: ensures a block with the given plugin exists in a region.
 *
 * @param Layout $layout
 *   Layout object (loaded via layout_load).
 * @param string $plugin
 *   Plugin identifier in the form "module:delta". Delta may contain colons
 *   (e.g. "system:page_components:tabs") — everything after the first colon
 *   is treated as the delta.
 * @param string $region
 *   Region machine name.
 *
 * @return string|null
 *   The new block's UUID if added, or NULL if a block with this plugin was
 *   already present anywhere in the layout.
 */
function _drop_suite_ensure_block_in_region($layout, $plugin, $region) {
  foreach ($layout->content as $block) {
    if (isset($block->plugin) && $block->plugin === $plugin) {
      return NULL;
    }
  }
  $colon  = strpos($plugin, ':');
  $module = substr($plugin, 0, $colon);
  $delta  = substr($plugin, $colon + 1);
  $block  = $layout->addBlock($module, $delta, $region);
  return isset($block->uuid) ? $block->uuid : NULL;
}

/**
 * Removes any blocks in the layout whose plugin matches the given list.
 *
 * @param Layout $layout
 *   Layout object (loaded via layout_load).
 * @param array $plugins
 *   List of plugin identifiers ("module:delta") to remove. Matches all
 *   occurrences — in case a block was accidentally added twice.
 *
 * @return int
 *   Number of blocks removed.
 */
function _drop_suite_remove_blocks_by_plugin($layout, array $plugins) {
  $plugins = array_flip($plugins);
  $removed = 0;
  foreach ($layout->content as $uuid => $block) {
    if (isset($block->plugin) && isset($plugins[$block->plugin])) {
      $layout->removeBlock($uuid);
      $removed++;
    }
  }
  return $removed;
}

/**
 * Moves the page_components:tabs block in the TOP region so it renders
 * immediately after drop_suite:drop_section_nav. Idempotent — if either
 * block is missing or the order is already correct, does nothing.
 *
 * Used by drop_suite_install and the corresponding update hook so existing
 * sites self-heal on bee updb.
 */
function _drop_suite_reorder_tabs_below_section_nav($layout) {
  if (empty($layout->positions['top'])) {
    return;
  }
  $tabs_uuid = NULL;
  $snav_uuid = NULL;
  foreach ($layout->content as $uuid => $block) {
    if (!isset($block->plugin)) {
      continue;
    }
    if ($block->plugin === 'system:page_components:tabs') {
      $tabs_uuid = $uuid;
    }
    elseif ($block->plugin === 'drop_suite:drop_section_nav') {
      $snav_uuid = $uuid;
    }
  }
  if (!$tabs_uuid || !$snav_uuid) {
    return;
  }
  // Defensive: drop any existing occurrences of the tabs UUID, then insert
  // exactly once, immediately after drop_section_nav. This self-heals
  // layouts that accumulated duplicate position references from earlier
  // template switches or addBlock races.
  $positions = array_values(array_diff($layout->positions['top'], array($tabs_uuid)));
  $snav_pos  = array_search($snav_uuid, $positions, TRUE);
  if ($snav_pos === FALSE) {
    // Section nav not in TOP; leave tabs out too and bail.
    $layout->positions['top'] = $positions;
    return;
  }
  array_splice($positions, $snav_pos + 1, 0, array($tabs_uuid));
  $layout->positions['top'] = $positions;
}

/**
 * Removes positions keys that don't correspond to any region in the layout's
 * template. Any blocks placed in those orphan regions are also removed.
 *
 * Orphan regions otherwise render as empty stubs in the layout editor (an
 * unlabeled "MANAGE BLOCKS" row above the first real region), because the
 * editor iterates $layout->positions rather than the template's regions.
 *
 * @return int
 *   Number of orphan regions removed.
 */
function _drop_suite_strip_orphan_regions($layout) {
  $template = layout_get_layout_template_info($layout->layout_template);
  if (empty($template['regions'])) {
    return 0;
  }
  $valid = $template['regions'];
  $removed = 0;
  foreach (array_keys($layout->positions) as $region) {
    if (!isset($valid[$region])) {
      foreach ($layout->positions[$region] as $uuid) {
        unset($layout->content[$uuid]);
      }
      unset($layout->positions[$region]);
      $removed++;
    }
  }
  return $removed;
}

/**
 * De-duplicates UUIDs within each region's positions array. Keeps the first
 * occurrence of each UUID and drops the rest. Safe to call on any layout.
 *
 * @return int
 *   Number of duplicate references removed across all regions.
 */
function _drop_suite_dedupe_layout_positions($layout) {
  $removed = 0;
  foreach ($layout->positions as $region => $uuids) {
    $seen = array();
    $clean = array();
    foreach ($uuids as $uuid) {
      if (isset($seen[$uuid])) {
        $removed++;
        continue;
      }
      $seen[$uuid] = TRUE;
      $clean[] = $uuid;
    }
    if ($clean !== $uuids) {
      $layout->positions[$region] = $clean;
    }
  }
  return $removed;
}

/**
 * Establish schema version baseline for Drop Suite.
 *
 * The drop_project table already exists (created by drop_crm). This update
 * registers Drop Suite as the schema owner going forward.
 */
function drop_suite_update_1000() {
  return t('Drop Suite now owns the drop_project table schema.');
}

/**
 * Schema version bump (menu link now created in hook_install only).
 */
function drop_suite_update_1100() {
  // No-op. Drop Suite menu link is only created on fresh installs.
}

/**
 * Add platform and health_url columns to drop_project.
 */
function drop_suite_update_1200() {
  if (!db_field_exists('drop_project', 'platform')) {
    db_add_field('drop_project', 'platform', array(
      'description' => 'CMS platform: backdrop, drupal, wordpress, or other.',
      'type'        => 'varchar',
      'length'      => 20,
      'not null'    => TRUE,
      'default'     => '',
    ));
  }
  if (!db_field_exists('drop_project', 'health_url')) {
    db_add_field('drop_project', 'health_url', array(
      'description' => 'Custom health check URL. If empty, auto-calculated from site_url + platform.',
      'type'        => 'varchar',
      'length'      => 255,
      'not null'    => TRUE,
      'default'     => '',
    ));
  }
  if (!db_field_exists('drop_project', 'gentle_monitor')) {
    db_add_field('drop_project', 'gentle_monitor', array(
      'type'    => 'int',
      'size'    => 'tiny',
      'not null' => TRUE,
      'default' => 0,
    ));
  }
  if (!db_field_exists('drop_project', 'check_interval')) {
    db_add_field('drop_project', 'check_interval', array(
      'type'    => 'int',
      'size'    => 'small',
      'not null' => TRUE,
      'default' => 5,
    ));
  }
}

/**
 * Import the drop_projects view if it doesn't exist.
 */
function drop_suite_update_1201() {
  $view = views_get_view('drop_projects');
  if (!$view) {
    $module_path = backdrop_get_path('module', 'drop_suite');
    $config_path = $module_path . '/config/views.view.drop_projects.json';
    if (file_exists($config_path)) {
      $data = json_decode(file_get_contents($config_path), TRUE);
      $config = config('views.view.drop_projects');
      $config->setData($data);
      $config->save();
      return t('Imported the drop_projects view.');
    }
  }
  return t('drop_projects view already exists.');
}

/**
 * Add server_sid and agent_site_key columns to drop_project.
 */
function drop_suite_update_1202() {
  if (!db_field_exists('drop_project', 'server_sid')) {
    db_add_field('drop_project', 'server_sid', array(
      'description' => 'Linked Drop Monitor server ID.',
      'type'        => 'int',
      'unsigned'    => TRUE,
      'not null'    => FALSE,
      'default'     => NULL,
    ));
    db_add_index('drop_project', 'server_sid', array('server_sid'));
  }
  if (!db_field_exists('drop_project', 'agent_site_key')) {
    db_add_field('drop_project', 'agent_site_key', array(
      'description' => 'Site key from the monitoring agent.',
      'type'        => 'varchar',
      'length'      => 255,
      'not null'    => TRUE,
      'default'     => '',
    ));
  }
}

/**
 * Bump default narrow_page_width from 900 to 1000 (fits 3 settings cards across).
 *
 * Only migrates sites still holding the old default; leaves custom values alone.
 */
function drop_suite_update_1203() {
  $config = config('drop_suite.settings');
  if ((int) $config->get('narrow_page_width') === 900) {
    $config->set('narrow_page_width', 1000);
    $config->save();
  }
}

/**
 * Reorder the TOP region so Local Tasks renders below Drop Section Nav.
 *
 * Previously the page_components:tabs block sat at position 0 of the TOP
 * region, causing the View/Edit tabs bar to render above the main Drop Nav.
 * Per the Drop Suite style guide's Navigation section, tabs belong below
 * both navs and above the page title. Runs across every layout that uses
 * the Drop Suite template and has both tabs and drop_section_nav blocks.
 * Idempotent — re-running is a no-op.
 */
function drop_suite_update_1204() {
  $layouts = layout_load_all();
  $updated = array();
  foreach ($layouts as $name => $layout) {
    if ($layout->layout_template !== 'drop_suite') {
      continue;
    }
    $before = isset($layout->positions['top']) ? $layout->positions['top'] : array();
    _drop_suite_reorder_tabs_below_section_nav($layout);
    $after = isset($layout->positions['top']) ? $layout->positions['top'] : array();
    if ($before !== $after) {
      $layout->save();
      $updated[] = $name;
    }
  }
  if ($updated) {
    return t('Reordered the Local Tasks block in @count Drop Suite layout(s): @list.', array(
      '@count' => count($updated),
      '@list'  => implode(', ', $updated),
    ));
  }
  return t('No Drop Suite layouts needed reordering.');
}

/**
 * De-duplicate block-position references across all layouts.
 *
 * Backdrop's layout API allows a single UUID to be referenced multiple
 * times in the same region's positions array, which triggers the "block
 * has incorrectly been positioned multiple times" warning. This update
 * cleans up any such duplicates. Seen in the wild on sites where a
 * template switch + manual layout edits produced an extra position
 * reference for the page_components:tabs block.
 */
function drop_suite_update_1206() {
  $cleaned = array();
  foreach (layout_load_all() as $name => $layout) {
    $removed = _drop_suite_dedupe_layout_positions($layout);
    if ($removed > 0) {
      $layout->save();
      $cleaned[] = $name . ' (' . $removed . ')';
    }
  }
  if ($cleaned) {
    return t('Removed duplicate position references in: @list.', array('@list' => implode(', ', $cleaned)));
  }
  return t('No layouts had duplicate position references.');
}

/**
 * Remove the deprecated drop_pin_action block from all layouts.
 *
 * Pin/unpin for reports now renders inside the Page Local Actions list via
 * hook_menu_local_tasks_alter(). The standalone block is no longer
 * registered. This update strips any placements from existing layouts so
 * they don't render as empty/missing.
 */
function drop_suite_update_1205() {
  $cleaned = array();
  foreach (layout_load_all() as $name => $layout) {
    $removed = _drop_suite_remove_blocks_by_plugin($layout, array('drop_suite:drop_pin_action'));
    if ($removed > 0) {
      $layout->save();
      $cleaned[] = $name . ' (' . $removed . ')';
    }
  }
  if ($cleaned) {
    return t('Removed deprecated drop_pin_action block from: @list.', array(
      '@list' => implode(', ', $cleaned),
    ));
  }
  return t('No layouts contained the deprecated drop_pin_action block.');
}


/**
 * Split Drop Suite layout out of the default layout.
 *
 * Previously _drop_suite_setup_default_layout() switched the site's default
 * layout to the drop_suite template, which meant every page on the site
 * (contact pages, nodes, user profiles, etc.) rendered inside the Drop
 * Suite chrome. Now we create a dedicated drop_pages layout that only
 * applies to /drop/* paths via hook_layout_load_by_router_item_alter(),
 * and revert the default layout to a stock template so non-Drop pages
 * render normally.
 *
 * This update creates drop_pages if missing, then reverts default. Both
 * helpers are idempotent.
 */
function drop_suite_update_1207() {
  _drop_suite_setup_drop_pages_layout();
  _drop_suite_revert_default_layout_template();
  return t('Migrated Drop Suite blocks from default layout to a dedicated drop_pages layout.');
}

/**
 * Add site header + main-menu blocks to the drop_pages layout header
 * region and move the page title to the end of the top region.
 *
 * These were manually placed on the dev site during the drop_pages
 * layout polish pass; capturing them in code so fresh installs and
 * existing sites catch up. _drop_suite_setup_drop_pages_layout() is
 * idempotent and preserves any customizations the site admin has
 * made to the header blocks' settings.
 */
function drop_suite_update_1208() {
  _drop_suite_setup_drop_pages_layout();
  return t('Added system:header and system:main-menu to drop_pages header region; moved title to end of top region.');
}

/**
 * Strip Drop Suite nav blocks from admin_default, strip orphan regions from
 * drop_pages.
 *
 * Earlier layout-shuffling work left two stale artifacts on some sites:
 *   - admin_default acquired drop_suite:drop_nav and drop_suite:drop_section_nav
 *     in its top region, which made the Drop Suite primary nav render on
 *     /admin/* pages where it doesn't belong.
 *   - drop_pages carried a positions entry for a "title" region inherited
 *     from a previous template; the drop_suite template has no "title"
 *     region, so it rendered as an empty stub ("MANAGE BLOCKS" label with
 *     no content) at the top of the layout editor.
 *
 * Both fixes are idempotent — safe on sites that never had the artifacts.
 */
function drop_suite_update_1209() {
  $admin = layout_load('admin_default');
  if ($admin) {
    $removed = _drop_suite_remove_blocks_by_plugin($admin, array(
      'drop_suite:drop_nav',
      'drop_suite:drop_section_nav',
    ));
    $orphans = _drop_suite_strip_orphan_regions($admin);
    if ($removed || $orphans) {
      _drop_suite_dedupe_layout_positions($admin);
      $admin->save();
    }
  }
  $drop_pages = layout_load('drop_pages');
  if ($drop_pages) {
    $orphans = _drop_suite_strip_orphan_regions($drop_pages);
    if ($orphans) {
      $drop_pages->save();
    }
  }
  return t('Stripped Drop Suite nav blocks and orphan regions from admin_default and drop_pages layouts.');
}
