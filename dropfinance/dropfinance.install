/**
 * Create drop_vendor, drop_revenue, and drop_expense tables.
 */
function dropfinance_update_1000() {
  $schema = dropfinance_schema();

  if (!db_table_exists('drop_vendor')) {
    db_create_table('drop_vendor', $schema['drop_vendor']);
  }
  if (!db_table_exists('drop_revenue')) {
    db_create_table('drop_revenue', $schema['drop_revenue']);
  }
  if (!db_table_exists('drop_expense')) {
    db_create_table('drop_expense', $schema['drop_expense']);
  }
}

/**
 * Create drop_transaction table.
 */
function dropfinance_update_1001() {
  $schema = dropfinance_schema();
  if (!db_table_exists('drop_transaction')) {
    db_create_table('drop_transaction', $schema['drop_transaction']);
  }
}

/**
 * Create drop_invoice table for FreshBooks invoice data.
 */
function dropfinance_update_1002() {
  $schema = dropfinance_schema();
  if (!db_table_exists('drop_invoice')) {
    db_create_table('drop_invoice', $schema['drop_invoice']);
  }
}

/**
 * Create drop_revenue_pipeline table for one-off project revenue.
 */
function dropfinance_update_1003() {
  $schema = dropfinance_schema();
  if (!db_table_exists('drop_revenue_pipeline')) {
    db_create_table('drop_revenue_pipeline', $schema['drop_revenue_pipeline']);
  }
}
