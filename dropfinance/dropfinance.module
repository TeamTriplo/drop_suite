/**
 * Implements hook_menu_local_tasks_alter().
 *
 * Strip admin tabs from finance landing pages.
 */
function dropfinance_menu_local_tasks_alter(&$data, $router_item, $root_path) {
  if ($root_path === 'drop/finance') {
    if (!empty($data['tabs'][0]['output'])) {
      $data['tabs'][0]['output'] = array();
    }
  }
}

/**
 * Returns frequency options for revenue/expense lines.
 *
 * @return array
 *   Keyed array of frequency machine names to labels.
 */
function dropfinance_frequency_options() {
  return array(
    'monthly'   => t('Monthly'),
    'quarterly' => t('Quarterly'),
    'annual'    => t('Annual'),
    'once'      => t('One-time'),
  );
}

/**
 * Returns the monthly equivalent multiplier for a frequency.
 *
 * @param string $frequency
 *   The frequency key.
 *
 * @return float
 *   The monthly multiplier (e.g. quarterly = 1/3).
 */
function _dropfinance_monthly_multiplier($frequency) {
  switch ($frequency) {
    case 'quarterly':
      return 1.0 / 3.0;
    case 'annual':
      return 1.0 / 12.0;
    case 'once':
      return 1.0;
    case 'monthly':
    default:
      return 1.0;
  }
}
