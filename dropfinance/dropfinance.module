<?php
/**
 * @file
 * Drop Finance module: budgeting, invoicing, and client data import.
 */

/**
 * Implements hook_autoload_info().
 */
function dropfinance_autoload_info() {
  return array(
    'DropVendor'            => 'dropfinance.entity.inc',
    'DropVendorController'  => 'dropfinance.entity.inc',
    'DropRevenue'           => 'dropfinance.entity.inc',
    'DropRevenueController' => 'dropfinance.entity.inc',
    'DropExpense'               => 'dropfinance.entity.inc',
    'DropExpenseController'     => 'dropfinance.entity.inc',
    'DropTransaction'           => 'dropfinance.entity.inc',
    'DropTransactionController' => 'dropfinance.entity.inc',
  );
}

/**
 * Implements hook_entity_info().
 */
function dropfinance_entity_info() {
  $info = array();

  $info['drop_vendor'] = array(
    'label'            => t('Vendor'),
    'plural label'     => t('Vendors'),
    'description'      => t('A vendor or supplier.'),
    'entity class'     => 'DropVendor',
    'controller class' => 'DropVendorController',
    'base table'       => 'drop_vendor',
    'fieldable'        => FALSE,
    'entity keys'      => array(
      'id'    => 'vid',
      'label' => 'name',
    ),
    'uri callback'     => 'entity_class_uri',
    'access callback'  => 'dropfinance_entity_access',
    'module'           => 'dropfinance',
  );

  $info['drop_revenue'] = array(
    'label'            => t('Revenue Line'),
    'plural label'     => t('Revenue Lines'),
    'description'      => t('An expected income stream.'),
    'entity class'     => 'DropRevenue',
    'controller class' => 'DropRevenueController',
    'base table'       => 'drop_revenue',
    'fieldable'        => FALSE,
    'entity keys'      => array(
      'id'    => 'rid',
      'label' => 'label',
    ),
    'uri callback'     => 'entity_class_uri',
    'access callback'  => 'dropfinance_entity_access',
    'module'           => 'dropfinance',
  );

  $info['drop_expense'] = array(
    'label'            => t('Expense Line'),
    'plural label'     => t('Expense Lines'),
    'description'      => t('An expected cost or payment.'),
    'entity class'     => 'DropExpense',
    'controller class' => 'DropExpenseController',
    'base table'       => 'drop_expense',
    'fieldable'        => FALSE,
    'entity keys'      => array(
      'id'    => 'eid',
      'label' => 'label',
    ),
    'uri callback'     => 'entity_class_uri',
    'access callback'  => 'dropfinance_entity_access',
    'module'           => 'dropfinance',
  );

  $info['drop_transaction'] = array(
    'label'            => t('Transaction'),
    'plural label'     => t('Transactions'),
    'description'      => t('A bank transaction record.'),
    'entity class'     => 'DropTransaction',
    'controller class' => 'DropTransactionController',
    'base table'       => 'drop_transaction',
    'fieldable'        => FALSE,
    'entity keys'      => array(
      'id'    => 'tid',
      'label' => 'description',
    ),
    'uri callback'     => 'entity_class_uri',
    'access callback'  => 'dropfinance_entity_access',
    'module'           => 'dropfinance',
  );

  return $info;
}

/**
 * Access callback for Drop Finance entities.
 */
function dropfinance_entity_access($op, $entity = NULL, $account = NULL) {
  return user_access('administer dropfinance', $account);
}

/**
 * Implements hook_permission().
 */
function dropfinance_permission() {
  return array(
    'administer dropfinance' => array(
      'title' => t('Administer Drop Finance'),
      'description' => t('Configure finance settings and run data imports.'),
    ),
  );
}

