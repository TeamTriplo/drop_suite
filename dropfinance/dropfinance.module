      'href'   => 'drop/finance/expenses',
      'weight' => 10,
    ),
    'pnl' => array(
      'title'  => t('P&L'),
      'href'   => 'drop/finance/pnl',
      'weight' => 11,
    ),
    'transactions' => array(
      'title'  => t('Transactions'),
      'href'   => 'drop/finance/transactions',
      'weight' => 12,
    ),
    'vendors' => array(
      'title'  => t('Vendors'),
      'href'   => 'drop/finance/vendors',
      'weight' => 15,
    ),
    'import' => array(
      'title'  => t('Import'),
      'href'   => 'drop/finance/import',
      'weight' => 20,
    ),
    'settings' => array(
      'title'      => t('Settings'),
      'href'       => 'drop/finance/settings',
      'weight'     => 25,
      'admin_only' => TRUE,
