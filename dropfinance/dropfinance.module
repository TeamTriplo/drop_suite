/**
 * Menu loader: load a vendor entity by ID.
 */
function dropfinance_vendor_load($vid) {
  $entities = entity_load('drop_vendor', array((int) $vid));
  return $entities ? reset($entities) : FALSE;
}

/**
 * Menu loader: load a revenue entity by ID.
 */
function dropfinance_revenue_load($rid) {
  $entities = entity_load('drop_revenue', array((int) $rid));
  return $entities ? reset($entities) : FALSE;
}

/**
 * Menu loader: load an expense entity by ID.
 */
function dropfinance_expense_load($eid) {
  $entities = entity_load('drop_expense', array((int) $eid));
  return $entities ? reset($entities) : FALSE;
}

/**
 * Menu loader: load a transaction entity by ID.
 */
function dropfinance_transaction_load($tid) {
  $entities = entity_load('drop_transaction', array((int) $tid));
  return $entities ? reset($entities) : FALSE;
}

