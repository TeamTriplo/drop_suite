<?php
/**
 * @file
 * Install, update, and uninstall hooks for DropDocs.
 */

/**
 * Implements hook_install().
 *
 * Creates the doc_tags vocabulary, doc content type, its tag field, and
 * registers doc as a book-allowed content type so the core Book module
 * handles navigation and ordering.
 */
function dropdocs_install() {
  // Create doc_tags vocabulary.
  $vocabulary = new TaxonomyVocabulary(array(
    'name'         => t('Doc Tags'),
    'machine_name' => 'doc_tags',
    'description'  => t('Tags for DropDocs documentation pages.'),
  ));
  taxonomy_vocabulary_save($vocabulary);

  // Create doc content type.
  $type = node_type_set_defaults(array(
    'type'        => 'doc',
    'name'        => t('Doc'),
    'base'        => 'node_content',
    'description' => t('An internal documentation or wiki page.'),
    'custom'      => 1,
    'modified'    => 1,
    'locked'      => 0,
    'settings'    => array(
      'promote_enabled'  => FALSE,
      'promote_default'  => FALSE,
      'sticky_enabled'   => FALSE,
      'sticky_default'   => FALSE,
      'revision_enabled' => TRUE,
      'revision_default' => TRUE,
      'node_preview'     => 1,
      'status_default'   => TRUE,
    ),
  ));
  node_type_save($type);
  node_add_body_field($type, t('Content'));

  // Field: field_doc_tags — taxonomy term reference to doc_tags.
  if (!field_info_field('field_doc_tags')) {
    field_create_field(array(
      'field_name'  => 'field_doc_tags',
      'type'        => 'taxonomy_term_reference',
      'cardinality' => FIELD_CARDINALITY_UNLIMITED,
      'settings'    => array(
        'allowed_values' => array(
          array('vocabulary' => 'doc_tags', 'parent' => 0),
        ),
      ),
    ));
  }
  field_create_instance(array(
    'field_name'  => 'field_doc_tags',
    'entity_type' => 'node',
    'bundle'      => 'doc',
    'label'       => t('Tags'),
    'required'    => FALSE,
    'widget'      => array(
      'type' => 'taxonomy_autocomplete',
    ),
    'display' => array(
      'default' => array(
        'label' => 'above',
        'type'  => 'taxonomy_term_reference_link',
      ),
    ),
  ));

  // Register 'doc' as a book-allowed content type.
  _dropdocs_register_book_type();

  // Install the node/% doc layout with book navigation sidebar.
  _dropdocs_install_layout();

  drop_base_grant_admin_permissions('dropdocs');

  // Grant the book-content view permission to authenticated users so the
  // default policy is "logged-in users can read docs; anonymous cannot".
  // Site architects can revoke this on the permissions page if they want
  // tighter access.
  user_role_grant_permissions('authenticated', array('view drop docs book content'));
}

/**
 * Helper: install the dropdocs layout config from the module's config dir.
 *
 * Copies config/layout.layout.dropdocs.json into active config if it isn't
 * already present. Idempotent and safe to call from both hook_install and
 * update hooks for existing installs.
 */
function _dropdocs_install_layout() {
  $config = config('layout.layout.dropdocs');
  if (!$config->isNew()) {
    return;
  }
  $source = backdrop_get_path('module', 'dropdocs') . '/config/layout.layout.dropdocs.json';
  if (!file_exists($source)) {
    return;
  }
  $data = json_decode(file_get_contents($source), TRUE);
  if (!is_array($data)) {
    return;
  }
  unset($data['_config_name']);
  foreach ($data as $key => $value) {
    $config->set($key, $value);
  }
  $config->save();
  if (function_exists('layout_reset_caches')) {
    layout_reset_caches();
  }
}

/**
 * Helper: add 'doc' to book.settings.book_allowed_types if not already there.
 */
function _dropdocs_register_book_type() {
  $book_config = config('book.settings');
  $allowed = $book_config->get('book_allowed_types');
  if (!is_array($allowed)) {
    $allowed = array('book');
  }
  if (!in_array('doc', $allowed, TRUE)) {
    $allowed[] = 'doc';
    $book_config->set('book_allowed_types', $allowed);
    $book_config->save();
  }
}

/**
 * Create the dropdocs_weight table for existing installs (legacy).
 *
 * Superseded by dropdocs_update_1002 which drops the table after migrating
 * weights into the book outline. Kept in place so existing sites that only
 * ran 1001 before upgrading still get a valid migration path through 1002.
 */
function dropdocs_update_1001() {
  if (!db_table_exists('dropdocs_weight')) {
    db_create_table('dropdocs_weight', array(
      'description' => 'Per-sibling display weight for doc nodes.',
      'fields' => array(
        'nid'    => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE),
        'weight' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      ),
      'primary key' => array('nid'),
    ));
  }
}

/**
 * Migrate DropDocs to the core Book module.
 *
 * Enables book, registers 'doc' as a book-allowed type, creates a synthetic
 * "Documentation" root node, enrols every existing doc as a first-level child
 * ordered by the legacy dropdocs_weight table, then drops the legacy
 * field_doc_parent field and dropdocs_weight table.
 */
function dropdocs_update_1002() {
  if (!module_exists('book')) {
    module_enable(array('book'));
  }

  _dropdocs_register_book_type();

  // Collect all existing doc nids. Use a stable order: legacy parent first
  // (so top-level docs come before former children), then legacy weight,
  // then title.
  $results = db_query("
    SELECT n.nid, n.title,
           COALESCE(p.field_doc_parent_target_id, 0) AS parent_nid,
           COALESCE(w.weight, 0) AS legacy_weight
    FROM {node} n
    LEFT JOIN {field_data_field_doc_parent} p
      ON p.entity_id = n.nid AND p.entity_type = 'node'
    LEFT JOIN {dropdocs_weight} w ON w.nid = n.nid
    WHERE n.type = 'doc'
    ORDER BY parent_nid ASC, legacy_weight ASC, n.title ASC
  ")->fetchAll();

  if (!empty($results)) {
    // Create a synthetic "Documentation" root node.
    $root = new Node();
    $root->type = 'doc';
    $root->title = t('Documentation');
    $root->language = LANGUAGE_NONE;
    $root->uid = 1;
    $root->status = 1;
    $root->book = _book_link_defaults('new');
    $root->book['bid'] = 'new';
    node_save($root);

    $root_bid  = $root->book['bid'];
    $root_mlid = $root->book['mlid'];

    // Enrol each existing doc as a first-level child of the root, preserving
    // relative order from the legacy ORDER BY above.
    $weight = 0;
    foreach ($results as $row) {
      $node = node_load($row->nid);
      if (!$node) {
        continue;
      }
      $node->book = _book_link_defaults($node->nid);
      $node->book['bid']    = $root_bid;
      $node->book['plid']   = $root_mlid;
      $node->book['weight'] = $weight++;
      node_save($node);
    }
    $message = t('DropDocs migrated @count existing docs into a "Documentation" book.', array('@count' => count($results)));
  }
  else {
    $message = t('DropDocs migration: no existing docs to move.');
  }

  // Drop the legacy field and table.
  $instance = field_info_instance('node', 'field_doc_parent', 'doc');
  if ($instance) {
    field_delete_instance($instance);
  }
  if (field_info_field('field_doc_parent')) {
    field_delete_field('field_doc_parent');
  }
  field_purge_batch(100);

  if (db_table_exists('dropdocs_weight')) {
    db_drop_table('dropdocs_weight');
  }

  return $message;
}

/**
 * Install the node/% doc layout with book navigation sidebar.
 */
function dropdocs_update_1003() {
  _dropdocs_install_layout();
  return t('DropDocs layout installed.');
}

/**
 * Grant the new "view drop docs book content" permission to the admin and
 * authenticated roles so existing sites aren't suddenly locked out of their
 * own docs when the hook_node_access() deny takes effect.
 */
function dropdocs_update_1004() {
  drop_base_grant_admin_permissions('dropdocs');
  user_role_grant_permissions('authenticated', array('view drop docs book content'));
  return t('DropDocs: book-content view permission granted to admin and authenticated roles.');
}

/**
 * Promote orphan doc nodes to their own books so they appear on /drop/docs.
 *
 * Before the auto-book presave hook was added, docs created without explicitly
 * placing them in a book (drop_start sample content, docs added via the UI
 * without selecting "Create a new book", etc.) were invisible on the docs
 * index page. This retroactively promotes each orphan to its own book root.
 */
function dropdocs_update_1005() {
  $orphans = db_query("
    SELECT n.nid
    FROM {node} n
    LEFT JOIN {book} b ON n.nid = b.nid
    WHERE n.type = :t AND b.nid IS NULL
    ORDER BY n.nid
  ", array(':t' => 'doc'))->fetchCol();

  $count = 0;
  foreach ($orphans as $nid) {
    $node = node_load($nid);
    if (!$node) {
      continue;
    }
    $node->book = array('bid' => 'new');
    node_save($node);
    $count++;
  }

  return t('DropDocs: promoted @n orphan doc(s) to their own books.', array('@n' => $count));
}

/**
 * Implements hook_uninstall().
 */
function dropdocs_uninstall() {
  // Remove the shipped layout from active config.
  $layout_config = config('layout.layout.dropdocs');
  if (!$layout_config->isNew()) {
    $layout_config->delete();
    if (function_exists('layout_reset_caches')) {
      layout_reset_caches();
    }
  }

  // Remove 'doc' from book allowed types.
  $book_config = config('book.settings');
  $allowed = $book_config->get('book_allowed_types');
  if (is_array($allowed)) {
    $filtered = array_values(array_diff($allowed, array('doc')));
    if ($filtered !== $allowed) {
      $book_config->set('book_allowed_types', $filtered);
      $book_config->save();
    }
  }

  // Remove field instances on the doc bundle.
  foreach (array('field_doc_tags', 'body') as $field_name) {
    $instance = field_info_instance('node', $field_name, 'doc');
    if ($instance) {
      field_delete_instance($instance);
    }
  }

  // Delete field_doc_tags if no other bundles use it.
  $field = field_info_field('field_doc_tags');
  if ($field) {
    $has_others = FALSE;
    if (!empty($field['bundles'])) {
      foreach ($field['bundles'] as $entity_type => $bundles) {
        $remaining = array_diff($bundles, array('doc'));
        if (!empty($remaining)) {
          $has_others = TRUE;
          break;
        }
      }
    }
    if (!$has_others) {
      field_delete_field('field_doc_tags');
    }
  }

  // Delete the doc content type.
  node_type_delete('doc');

  // Delete the vocabulary.
  $vocabulary = taxonomy_vocabulary_load('doc_tags');
  if ($vocabulary) {
    taxonomy_vocabulary_delete($vocabulary->machine_name);
  }
}
