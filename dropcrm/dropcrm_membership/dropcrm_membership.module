/**
 * Implements hook_views_api().
 *
 * Tells Views to load dropcrm_membership.views.inc. Forward and reverse
 * relationships between module-owned entities are auto-generated by
 * EntityPlusDefaultViewsController; the .views.inc file only adds the
 * reverse relationship from crm_contact back to crm_membership.
 */
function dropcrm_membership_views_api() {
  return array(
