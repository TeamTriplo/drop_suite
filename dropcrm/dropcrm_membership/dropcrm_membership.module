  // Reports — surfaced via hook_drop_reports() for the CRM Reports nav.
  $items['drop/crm/reports/memberships'] = array(
    'title'            => 'Memberships Report',
    'page callback'    => 'dropcrm_membership_report_page',
    'access arguments' => array('access dropcrm_membership'),
