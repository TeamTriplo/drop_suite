/**
 * Title callback for the membership view page.
 */
function dropcrm_membership_page_title($membership) {
  $contact = entity_load('crm_contact', $membership->cid);
  $name = $contact ? $contact->label() : t('(unknown contact)');
  $types = _dropcrm_membership_types();
  $type_label = isset($types[$membership->type]['label']) ? $types[$membership->type]['label'] : $membership->type;
  return t('@type membership — @name', array('@type' => $type_label, '@name' => $name));
}

/**
 * Menu loader for %crm_membership.
 */
function crm_membership_load($mid) {
  $entities = entity_load('crm_membership', array($mid));
  return $entities ? reset($entities) : FALSE;
}

/**
 * Menu loader for %crm_membership_payment.
 */
function crm_membership_payment_load($pid) {
  $entities = entity_load('crm_membership_payment', array($pid));
  return $entities ? reset($entities) : FALSE;
}

// ---------------------------------------------------------------------------
// Presave hooks (timestamps + uid)
// ---------------------------------------------------------------------------

/**
 * Implements hook_crm_membership_presave().
 */
function dropcrm_membership_crm_membership_presave($membership) {
  global $user;
  $now = REQUEST_TIME;
  if (empty($membership->created)) {
    $membership->created = $now;
  }
  $membership->changed = $now;
  if (empty($membership->uid)) {
    $membership->uid = $user->uid;
  }
}

/**
 * Implements hook_crm_membership_term_presave().
 */
function dropcrm_membership_crm_membership_term_presave($term) {
  global $user;
  if (empty($term->created)) {
    $term->created = REQUEST_TIME;
  }
  if (empty($term->uid)) {
    $term->uid = $user->uid;
  }
}

/**
 * Implements hook_crm_membership_payment_presave().
 */
function dropcrm_membership_crm_membership_payment_presave($payment) {
  global $user;
  if (empty($payment->created)) {
    $payment->created = REQUEST_TIME;
  }
  if (empty($payment->uid)) {
    $payment->uid = $user->uid;
  }
}

// ---------------------------------------------------------------------------
// Helper functions
// ---------------------------------------------------------------------------

/**
 * Returns status codes keyed to human labels.
 */
function _dropcrm_membership_status_options() {
  return array(
    DROPCRM_MEMBERSHIP_STATUS_ACTIVE    => t('Active'),
    DROPCRM_MEMBERSHIP_STATUS_GRACE     => t('Grace'),
    DROPCRM_MEMBERSHIP_STATUS_LAPSED    => t('Lapsed'),
    DROPCRM_MEMBERSHIP_STATUS_PENDING   => t('Pending'),
    DROPCRM_MEMBERSHIP_STATUS_CANCELLED => t('Cancelled'),
  );
}

/**
 * Returns a rendered themed status badge.
 */
function _dropcrm_membership_status_badge($status) {
  $labels = _dropcrm_membership_status_options();
  $classes = array(
    DROPCRM_MEMBERSHIP_STATUS_ACTIVE    => 'active',
    DROPCRM_MEMBERSHIP_STATUS_GRACE     => 'grace',
    DROPCRM_MEMBERSHIP_STATUS_LAPSED    => 'lapsed',
    DROPCRM_MEMBERSHIP_STATUS_PENDING   => 'pending',
    DROPCRM_MEMBERSHIP_STATUS_CANCELLED => 'cancelled',
  );
  $label = isset($labels[$status]) ? $labels[$status] : t('Unknown');
  $class = isset($classes[$status]) ? $classes[$status] : 'unknown';
  return '<span class="crm-membership-status crm-membership-status-' . $class . '">' . check_plain($label) . '</span>';
}

/**
 * Returns the membership types config, keyed by type machine name.
 */
function _dropcrm_membership_types() {
  $types = config_get('dropcrm_membership.settings', 'types');
  return is_array($types) ? $types : array();
}

/**
 * Options list callback: type key => label.
 */
function _dropcrm_membership_type_options() {
  $out = array();
  foreach (_dropcrm_membership_types() as $key => $type) {
    $out[$key] = isset($type['label']) ? $type['label'] : $key;
  }
  return $out;
}

/**
 * Options list callback: payment method labels (keyed by label itself).
 */
function _dropcrm_membership_payment_method_options() {
  $methods = config_get('dropcrm_membership.settings', 'payment_methods');
  if (!is_array($methods)) {
    $methods = array('Check', 'Cash', 'Credit Card', 'Other');
  }
  return array_combine($methods, $methods);
}

/**
 * Getter: computed joined_date property on crm_membership (earliest term's
 * start_date). Returns a Unix timestamp for Views date handler compatibility.
 */
function _dropcrm_membership_joined_date_get($membership, array $options, $name, $type, $info) {
  $earliest = db_query('SELECT MIN(start_date) FROM {crm_membership_term} WHERE mid = :mid', array(':mid' => $membership->mid))->fetchField();
  if (empty($earliest) || $earliest === '0000-00-00') {
    return NULL;
  }
  return strtotime($earliest);
}

/**
 * Getter for schema date columns (stored as YYYY-MM-DD strings, exposed to
 * Views as Unix timestamps).
 */
function _dropcrm_membership_date_get($entity, array $options, $name, $type, $info) {
  if (empty($entity->{$name}) || $entity->{$name} === '0000-00-00') {
    return NULL;
  }
  return strtotime($entity->{$name});
}

/**
 * Setter that accepts either Unix timestamp or YYYY-MM-DD string.
 */
function _dropcrm_membership_date_set($entity, $name, $value) {
  if (empty($value)) {
    $entity->{$name} = NULL;
    return;
  }
  if (is_numeric($value)) {
    $entity->{$name} = format_date($value, 'custom', 'Y-m-d');
  }
  else {
    $entity->{$name} = $value;
  }
}

/**
 * Returns the latest term row for a membership, or NULL.
 */
function _dropcrm_membership_latest_term($mid) {
  $tid = db_query('SELECT tid FROM {crm_membership_term} WHERE mid = :mid ORDER BY start_date DESC, tid DESC LIMIT 1', array(':mid' => $mid))->fetchField();
  if (!$tid) {
    return NULL;
  }
  $terms = entity_load('crm_membership_term', array($tid));
  return $terms ? reset($terms) : NULL;
}

/**
 * Adds a term_length string (strtotime-compatible) to a YYYY-MM-DD date.
 */
function _dropcrm_membership_add_term_length($start_date, $term_length) {
  if (empty($term_length)) {
    return NULL;
  }
  $ts = strtotime('+' . $term_length, strtotime($start_date));
  if (!$ts) {
    return NULL;
  }
  return format_date($ts, 'custom', 'Y-m-d');
}

/**
 * Sums payments for a membership.
 */
function _dropcrm_membership_total_paid($mid) {
  return (float) db_query('SELECT COALESCE(SUM(amount), 0) FROM {crm_membership_payment} WHERE mid = :mid', array(':mid' => $mid))->fetchField();
}
