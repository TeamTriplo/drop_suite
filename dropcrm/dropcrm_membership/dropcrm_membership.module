  return $items;
}

/**
 * Implements hook_drop_reports().
 *
 * Registers the Memberships report with the shared Drop Suite reports
 * nav system so it appears in the CRM section's reports group.
 */
function dropcrm_membership_drop_reports() {
  return array(
    'dropcrm_memberships' => array(
      'title'       => t('Memberships'),
      'path'        => 'drop/crm/reports/memberships',
      'root_path'   => 'drop/crm',
      'module'      => 'dropcrm_membership',
      'default_pin' => FALSE,
    ),
  );
}

/**
 * Title callback for the membership view page.
 */
function dropcrm_membership_page_title($membership) {
  $contact = entity_load('crm_contact', $membership->cid);
  $name = $contact ? $contact->label() : t('(unknown contact)');
  $types = _dropcrm_membership_types();
  $type_label = isset($types[$membership->type]['label']) ? $types[$membership->type]['label'] : $membership->type;
  return t('@type membership — @name', array('@type' => $type_label, '@name' => $name));
}

/**
 * Menu loader for %crm_membership.
 */
function crm_membership_load($mid) {
  $entities = entity_load('crm_membership', array($mid));
  return $entities ? reset($entities) : FALSE;
}

/**
 * Menu loader for %crm_membership_payment.
 */
function crm_membership_payment_load($pid) {
  $entities = entity_load('crm_membership_payment', array($pid));
  return $entities ? reset($entities) : FALSE;
}

/**
 * Menu loader for %crm_membership_term.
 */
function crm_membership_term_load($tid) {
  $entities = entity_load('crm_membership_term', array($tid));
  return $entities ? reset($entities) : FALSE;
}

// ---------------------------------------------------------------------------
// Presave hooks (timestamps + uid)
// ---------------------------------------------------------------------------

/**
 * Implements hook_crm_membership_presave().
 */
function dropcrm_membership_crm_membership_presave($membership) {
  global $user;
  $now = REQUEST_TIME;
  if (empty($membership->created)) {
    $membership->created = $now;
  }
  $membership->changed = $now;
  if (empty($membership->uid)) {
    $membership->uid = $user->uid;
  }
}

/**
 * Implements hook_crm_membership_term_presave().
 */
function dropcrm_membership_crm_membership_term_presave($term) {
  global $user;
  if (empty($term->created)) {
    $term->created = REQUEST_TIME;
  }
  if (empty($term->uid)) {
    $term->uid = $user->uid;
  }
}

/**
 * Implements hook_crm_membership_payment_presave().
 */
function dropcrm_membership_crm_membership_payment_presave($payment) {
  global $user;
  if (empty($payment->created)) {
    $payment->created = REQUEST_TIME;
  }
  if (empty($payment->uid)) {
    $payment->uid = $user->uid;
  }
}

// ---------------------------------------------------------------------------
// Helper functions
// ---------------------------------------------------------------------------

/**
 * Returns status codes keyed to human labels.
 */
function _dropcrm_membership_status_options() {
  return array(
    DROPCRM_MEMBERSHIP_STATUS_ACTIVE    => t('Active'),
    DROPCRM_MEMBERSHIP_STATUS_GRACE     => t('Grace'),
    DROPCRM_MEMBERSHIP_STATUS_LAPSED    => t('Lapsed'),
    DROPCRM_MEMBERSHIP_STATUS_PENDING   => t('Pending'),
    DROPCRM_MEMBERSHIP_STATUS_CANCELLED => t('Cancelled'),
  );
}

/**
 * Returns a rendered themed status badge.
 */
function _dropcrm_membership_status_badge($status) {
  $labels = _dropcrm_membership_status_options();
  $classes = array(
    DROPCRM_MEMBERSHIP_STATUS_ACTIVE    => 'active',
    DROPCRM_MEMBERSHIP_STATUS_GRACE     => 'grace',
    DROPCRM_MEMBERSHIP_STATUS_LAPSED    => 'lapsed',
    DROPCRM_MEMBERSHIP_STATUS_PENDING   => 'pending',
    DROPCRM_MEMBERSHIP_STATUS_CANCELLED => 'cancelled',
  );
  $label = isset($labels[$status]) ? $labels[$status] : t('Unknown');
  $class = isset($classes[$status]) ? $classes[$status] : 'unknown';
  return '<span class="crm-membership-status crm-membership-status-' . $class . '">' . check_plain($label) . '</span>';
}

/**
 * Returns the membership types config, keyed by type machine name.
 */
function _dropcrm_membership_types() {
  $types = config_get('dropcrm_membership.settings', 'types');
  return is_array($types) ? $types : array();
}

/**
 * Options list callback: type key => label.
 */
function _dropcrm_membership_type_options() {
  $out = array();
  foreach (_dropcrm_membership_types() as $key => $type) {
    $out[$key] = isset($type['label']) ? $type['label'] : $key;
  }
  return $out;
}

/**
 * Options list callback: payment method labels (keyed by label itself).
 */
function _dropcrm_membership_payment_method_options() {
  $methods = config_get('dropcrm_membership.settings', 'payment_methods');
  if (!is_array($methods)) {
    $methods = array('Check', 'Cash', 'Credit Card', 'Other');
  }
  return array_combine($methods, $methods);
}

/**
 * Recomputes the three denormalized cache columns on a membership row from
 * the current crm_membership_term and crm_membership_payment data.
 *
 * Called from the entity CRUD hooks on term and payment so the membership
 * row always reflects the current latest-term and payment totals. Uses
 * db_update (not $membership->save()) to avoid recursion with entity save
 * hooks and to skip triggering entity-level cache invalidation when only
 * the derived columns change.
 */
function _dropcrm_membership_recompute_derived($mid) {
  $mid = (int) $mid;
  if (!$mid) {
    return;
  }

  $end_date = db_query('SELECT end_date FROM {crm_membership_term} WHERE mid = :mid ORDER BY start_date DESC, tid DESC LIMIT 1', array(':mid' => $mid))->fetchField();
  if (empty($end_date) || $end_date === '0000-00-00') {
    $end_date = NULL;
  }

  $paid_date = db_query('SELECT paid_date FROM {crm_membership_payment} WHERE mid = :mid ORDER BY paid_date DESC, pid DESC LIMIT 1', array(':mid' => $mid))->fetchField();
  if (empty($paid_date) || $paid_date === '0000-00-00') {
    $paid_date = NULL;
  }

  $total_paid = (float) db_query('SELECT COALESCE(SUM(amount), 0) FROM {crm_membership_payment} WHERE mid = :mid', array(':mid' => $mid))->fetchField();

  db_update('crm_membership')
    ->fields(array(
      'current_end_date'  => $end_date,
      'last_payment_date' => $paid_date,
      'total_paid'        => $total_paid,
    ))
    ->condition('mid', $mid)
    ->execute();

  entity_get_controller('crm_membership')->resetCache(array($mid));
}

/**
 * Implements hook_crm_membership_term_insert().
 */
function dropcrm_membership_crm_membership_term_insert($term) {
  _dropcrm_membership_recompute_derived($term->mid);
}

/**
 * Implements hook_crm_membership_term_update().
 */
function dropcrm_membership_crm_membership_term_update($term) {
  _dropcrm_membership_recompute_derived($term->mid);
}

/**
 * Implements hook_crm_membership_term_delete().
 */
function dropcrm_membership_crm_membership_term_delete($term) {
  _dropcrm_membership_recompute_derived($term->mid);
}

/**
 * Implements hook_crm_membership_payment_insert().
 */
function dropcrm_membership_crm_membership_payment_insert($payment) {
  _dropcrm_membership_recompute_derived($payment->mid);
}

/**
 * Implements hook_crm_membership_payment_update().
 */
function dropcrm_membership_crm_membership_payment_update($payment) {
  _dropcrm_membership_recompute_derived($payment->mid);
}

/**
 * Implements hook_crm_membership_payment_delete().
 */
function dropcrm_membership_crm_membership_payment_delete($payment) {
  _dropcrm_membership_recompute_derived($payment->mid);
}

/**
 * Getter for schema date columns (stored as YYYY-MM-DD strings, exposed to
 * Views as Unix timestamps).
 */
function _dropcrm_membership_date_get($entity, array $options, $name, $type, $info) {
  if (empty($entity->{$name}) || $entity->{$name} === '0000-00-00') {
    return NULL;
  }
  return strtotime($entity->{$name});
}

/**
 * Setter that accepts either Unix timestamp or YYYY-MM-DD string.
 */
function _dropcrm_membership_date_set($entity, $name, $value) {
  if (empty($value)) {
    $entity->{$name} = NULL;
    return;
  }
  if (is_numeric($value)) {
    $entity->{$name} = format_date($value, 'custom', 'Y-m-d');
  }
  else {
    $entity->{$name} = $value;
  }
}

/**
 * Returns the latest term row for a membership, or NULL.
 */
function _dropcrm_membership_latest_term($mid) {
  $tid = db_query('SELECT tid FROM {crm_membership_term} WHERE mid = :mid ORDER BY start_date DESC, tid DESC LIMIT 1', array(':mid' => $mid))->fetchField();
  if (!$tid) {
    return NULL;
  }
  $terms = entity_load('crm_membership_term', array($tid));
  return $terms ? reset($terms) : NULL;
}

/**
 * Adds a term_length string (strtotime-compatible) to a YYYY-MM-DD date.
 */
function _dropcrm_membership_add_term_length($start_date, $term_length) {
  if (empty($term_length)) {
    return NULL;
  }
  $ts = strtotime('+' . $term_length, strtotime($start_date));
  if (!$ts) {
    return NULL;
  }
  return format_date($ts, 'custom', 'Y-m-d');
}

/**
 * Sums payments for a membership.
 */
function _dropcrm_membership_total_paid($mid) {
  return (float) db_query('SELECT COALESCE(SUM(amount), 0) FROM {crm_membership_payment} WHERE mid = :mid', array(':mid' => $mid))->fetchField();
}

// ---------------------------------------------------------------------------
// CRM sub-nav
// ---------------------------------------------------------------------------

/**
 * Implements hook_drop_section_links().
 *
 * Adds a "Memberships" link to the CRM sub-navigation, between Activities
 * (weight 0) and Reports (weight 20+). Only shown to users with membership
 * access — the link itself would 403 for users without it, but hiding it
 * keeps the sidebar uncluttered.
 */
function dropcrm_membership_drop_section_links($section) {
  if ($section !== 'crm') {
    return array();
  }
  if (!user_access('access dropcrm_membership')) {
    return array();
  }
  return array(
    'memberships' => array(
      'title'        => t('Memberships'),
      'href'         => 'drop/crm/memberships',
      'weight'       => 5,
      'active_paths' => array('drop/crm/memberships'),
    ),
  );
}

// ---------------------------------------------------------------------------
// Blocks (dashboard widget)
// ---------------------------------------------------------------------------

/**
 * Implements hook_block_info().
 */
function dropcrm_membership_block_info() {
  return array(
    'expiring' => array(
      'info'        => t('Memberships expiring soon'),
      'description' => t('Lists memberships whose current term ends within the configured window. Tune the window on the CRM settings page.'),
    ),
  );
}

/**
 * Implements hook_block_view().
 */
function dropcrm_membership_block_view($delta = '', $settings = array(), $contexts = array()) {
  if ($delta !== 'expiring') {
    return;
  }
  if (!user_access('access dropcrm_membership')) {
    return;
  }
  $window = (int) config_get('dropcrm_membership.settings', 'expiring_widget_window');
  if ($window < 1) {
    $window = 30;
  }
  $today    = format_date(REQUEST_TIME, 'custom', 'Y-m-d');
  $deadline = format_date(strtotime('+' . $window . ' days'), 'custom', 'Y-m-d');

  // Find memberships whose latest term end_date falls in the window. Using
  // the same latest-term subquery shape as the cron sweep for consistency.
  $result = db_query("
    SELECT m.mid, m.cid, m.member_id, m.type, m.status, t.end_date
    FROM {crm_membership} m
    INNER JOIN (
      SELECT mid, MAX(tid) AS tid
      FROM (
        SELECT mid, tid,
               ROW_NUMBER() OVER (PARTITION BY mid ORDER BY start_date DESC, tid DESC) AS rn
        FROM {crm_membership_term}
      ) ranked
      WHERE rn = 1
      GROUP BY mid
    ) latest ON latest.mid = m.mid
    INNER JOIN {crm_membership_term} t ON t.tid = latest.tid
    WHERE m.status IN (:active, :grace)
      AND t.end_date IS NOT NULL
      AND t.end_date >= :today
      AND t.end_date <= :deadline
    ORDER BY t.end_date ASC
    LIMIT 10
  ", array(
    ':active'   => DROPCRM_MEMBERSHIP_STATUS_ACTIVE,
    ':grace'    => DROPCRM_MEMBERSHIP_STATUS_GRACE,
    ':today'    => $today,
    ':deadline' => $deadline,
  ));

  $rows = array();
  $types = _dropcrm_membership_types();
  foreach ($result as $row) {
    $contact = entity_load('crm_contact', $row->cid);
    $name = $contact ? $contact->label() : t('(unknown)');
    $type_label = isset($types[$row->type]['label']) ? $types[$row->type]['label'] : $row->type;
    $ops = user_access('manage dropcrm_membership')
      ? ' ' . l(t('Renew'), 'drop/crm/memberships/' . $row->mid . '/renew', array('attributes' => array('class' => array('button', 'button-small'))))
      : '';
    $rows[] = array(
      l($name, 'drop/crm/memberships/' . $row->mid),
      check_plain($type_label),
      check_plain($row->end_date) . $ops,
    );
  }

  return array(
    'subject' => t('Memberships expiring in @n days', array('@n' => $window)),
    'content' => array(
      'table' => array(
        '#theme'  => 'table',
        '#header' => array(t('Member'), t('Type'), t('Ends')),
        '#rows'   => $rows,
        '#empty'  => t('No memberships expiring in this window.'),
      ),
      'link' => array(
        '#markup' => '<p>' . l(t('All memberships →'), 'drop/crm/memberships') . '</p>',
      ),
    ),
  );
}

// ---------------------------------------------------------------------------
// Contact view integration
// ---------------------------------------------------------------------------

/**
 * Implements hook_dropcrm_contact_view_alter().
 *
 * Adds a "Memberships" section to the contact view page. DropCRM's contact
 * view callback (dropcrm_contact_view) is a custom render pipeline that does
 * not call entity_view() for person bundles, so hook_entity_view never fires
 * on them. The dropcrm_contact_view alter hook runs for every bundle and is
 * the correct extension point.
 */
function dropcrm_membership_dropcrm_contact_view_alter(&$output, $contact) {
  if (!user_access('access dropcrm_membership')) {
    return;
  }

  $rows = db_query('SELECT mid, member_id, type, status FROM {crm_membership} WHERE cid = :cid ORDER BY mid DESC', array(':cid' => $contact->cid))->fetchAll();

  // Hide the section entirely when there are no memberships and the viewer
  // cannot add one — nothing actionable to show.
  if (empty($rows) && !user_access('manage dropcrm_membership')) {
    return;
  }

  $types = _dropcrm_membership_types();
  $table_rows = array();
  foreach ($rows as $row) {
    $type_label = isset($types[$row->type]['label']) ? $types[$row->type]['label'] : $row->type;
    $end = db_query('SELECT end_date FROM {crm_membership_term} WHERE mid = :mid ORDER BY start_date DESC, tid DESC LIMIT 1', array(':mid' => $row->mid))->fetchField();
    $ops = array(l(t('View'), 'drop/crm/memberships/' . $row->mid));
    if (user_access('manage dropcrm_membership')) {
      $ops[] = l(t('Renew'), 'drop/crm/memberships/' . $row->mid . '/renew');
    }
    $table_rows[] = array(
      check_plain($row->member_id),
      check_plain($type_label),
      array('data' => _dropcrm_membership_status_badge($row->status)),
      $end ?: t('—'),
      implode(' · ', $ops),
    );
  }

  $content = array(
    'table' => array(
      '#theme'  => 'table',
      '#header' => array(t('Member ID'), t('Type'), t('Status'), t('Ends'), t('Operations')),
      '#rows'   => $table_rows,
      '#empty'  => t('No memberships yet.'),
    ),
  );
  if (user_access('manage dropcrm_membership')) {
    $content['add_link'] = array(
      '#markup' => '<p>' . l(t('Add membership'), 'drop/crm/memberships/add', array('query' => array('cid' => $contact->cid))) . '</p>',
    );
  }

  $output['memberships'] = array(
    '#prefix' => '<div class="crm-contact-memberships"><h3>' . t('Memberships') . '</h3>',
    '#suffix' => '</div>',
    '#weight' => 18,
    'inner'   => $content,
  );
}

