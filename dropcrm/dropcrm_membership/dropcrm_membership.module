  $p['amount'] = array(
    'label'          => t('Amount'),
    'type'           => 'decimal',
    'description'    => t('Dollar amount of the payment.'),
    'schema field'   => 'amount',
    'getter callback' => 'entity_plus_property_verbatim_get',
    'setter callback' => 'entity_plus_property_verbatim_set',
  );
  $p['paid_date'] = array(
    'label'          => t('Paid Date'),
    'type'           => 'date',
    'description'    => t('Date the payment was received.'),
    'schema field'   => 'paid_date',
    'getter callback' => '_dropcrm_membership_date_get',
    'setter callback' => '_dropcrm_membership_date_set',
  );
  $p['method'] = array(
    'label'          => t('Method'),
    'type'           => 'text',
    'description'    => t('How the payment was made (Check, Cash, Credit Card, Other).'),
    'schema field'   => 'method',
    'options list'   => '_dropcrm_membership_payment_method_options',
    'getter callback' => 'entity_plus_property_verbatim_get',
    'setter callback' => 'entity_plus_property_verbatim_set',
  );
  $p['reference'] = array(
    'label'          => t('Reference'),
    'type'           => 'text',
    'description'    => t('Optional reference — check number, transaction ID, etc.'),
    'schema field'   => 'reference',
    'getter callback' => 'entity_plus_property_verbatim_get',
    'setter callback' => 'entity_plus_property_verbatim_set',
  );
  $p['notes'] = array(
    'label'          => t('Notes'),
    'type'           => 'text',
    'description'    => t('Free-form notes on this payment.'),
    'schema field'   => 'notes',
    'getter callback' => 'entity_plus_property_verbatim_get',
    'setter callback' => 'entity_plus_property_verbatim_set',
  );
  $p['created'] = array(
    'label'          => t('Recorded'),
    'type'           => 'date',
    'description'    => t('Date when this payment record was created.'),
    'schema field'   => 'created',
    'getter callback' => 'entity_plus_property_verbatim_get',
  );
  $p['uid'] = array(
    'label'          => t('Recorded by'),
    'type'           => 'user',
    'description'    => t('User account that recorded this payment.'),
    'schema field'   => 'uid',
    'getter callback' => 'entity_plus_property_verbatim_get',
