  $t['status'] = array(
    'label'          => t('Term Status'),
    'type'           => 'integer',
    'description'    => t('Status of this specific term (active, grace, lapsed, pending, cancelled).'),
    'schema field'   => 'status',
    'options list'   => '_dropcrm_membership_status_options',
    'getter callback' => 'entity_plus_property_verbatim_get',
    'setter callback' => 'entity_plus_property_verbatim_set',
  );
  $t['notes'] = array(
    'label'          => t('Notes'),
    'type'           => 'text',
    'description'    => t('Free-form notes on this term (e.g. payment reference, special circumstances).'),
    'schema field'   => 'notes',
    'getter callback' => 'entity_plus_property_verbatim_get',
    'setter callback' => 'entity_plus_property_verbatim_set',
  );
  $t['created'] = array(
    'label'          => t('Recorded'),
    'type'           => 'date',
    'description'    => t('Date when this term record was created.'),
    'schema field'   => 'created',
    'getter callback' => 'entity_plus_property_verbatim_get',
  );
  $t['uid'] = array(
    'label'          => t('Recorded by'),
    'type'           => 'user',
    'description'    => t('User account that recorded this term.'),
    'schema field'   => 'uid',
    'getter callback' => 'entity_plus_property_verbatim_get',
    'setter callback' => 'entity_plus_property_verbatim_set',
  );

  // --- crm_membership_payment properties ---
  $p = &$info['crm_membership_payment']['properties'];
  $p['pid'] = array(
    'label'          => t('Payment ID'),
    'type'           => 'integer',
    'description'    => t('Internal numeric identifier for this payment record.'),
    'schema field'   => 'pid',
    'getter callback' => 'entity_plus_property_verbatim_get',
  );
  $p['mid'] = array(
