<?php
/**
 * @file
 * DropCRM Membership — membership management for DropCRM.
 *
 * Provides three entity types linked to crm_contact:
 *  - crm_membership: the member relationship (one row per member)
 *  - crm_membership_term: one row per term (initial join + each renewal)
 *  - crm_membership_payment: manual log of dues payments
 */

// Status code constants mirror the ones in dropcrm_membership.install so they
// are loaded at runtime without needing the install file.
if (!defined('DROPCRM_MEMBERSHIP_STATUS_LAPSED')) {
  define('DROPCRM_MEMBERSHIP_STATUS_LAPSED',    0);
  define('DROPCRM_MEMBERSHIP_STATUS_ACTIVE',    1);
  define('DROPCRM_MEMBERSHIP_STATUS_CANCELLED', 2);
  define('DROPCRM_MEMBERSHIP_STATUS_PENDING',   3);
  define('DROPCRM_MEMBERSHIP_STATUS_GRACE',     4);
}

// ---------------------------------------------------------------------------
// Autoload
// ---------------------------------------------------------------------------

/**
 * Implements hook_autoload_info().
 */
function dropcrm_membership_autoload_info() {
  return array(
    'CrmMembership'                    => 'dropcrm_membership.entity.inc',
    'CrmMembershipController'          => 'dropcrm_membership.entity.inc',
    'CrmMembershipTerm'                => 'dropcrm_membership.entity.inc',
    'CrmMembershipTermController'      => 'dropcrm_membership.entity.inc',
    'CrmMembershipPayment'             => 'dropcrm_membership.entity.inc',
    'CrmMembershipPaymentController'   => 'dropcrm_membership.entity.inc',
  );
}

// ---------------------------------------------------------------------------
// Entity info
// ---------------------------------------------------------------------------

/**
 * Implements hook_entity_info().
 */
function dropcrm_membership_entity_info() {
  $info = array();

  $info['crm_membership'] = array(
    'label'              => t('CRM Membership'),
    'plural label'       => t('CRM Memberships'),
    'description'        => t('A membership relationship between the organization and a CRM contact.'),
    'entity class'       => 'CrmMembership',
    'controller class'   => 'CrmMembershipController',
    'views controller class' => 'EntityPlusDefaultViewsController',
    'base table'         => 'crm_membership',
    'fieldable'          => TRUE,
    'entity keys'        => array(
      'id'    => 'mid',
      'label' => 'member_id',
    ),
    'view modes'         => array(
      'full' => array('label' => t('Full'), 'custom settings' => FALSE),
    ),
    'uri callback'       => 'entity_class_uri',
    'access callback'    => 'dropcrm_membership_access',
    'module'             => 'dropcrm_membership',
  );

  $info['crm_membership_term'] = array(
    'label'              => t('Membership Term'),
    'plural label'       => t('Membership Terms'),
    'description'        => t('A single term within a membership: initial join or a renewal.'),
    'entity class'       => 'CrmMembershipTerm',
    'controller class'   => 'CrmMembershipTermController',
    'views controller class' => 'EntityPlusDefaultViewsController',
    'base table'         => 'crm_membership_term',
    'fieldable'          => FALSE,
    'entity keys'        => array(
      'id' => 'tid',
    ),
    'uri callback'       => 'entity_class_uri',
    'access callback'    => 'dropcrm_membership_term_access',
    'module'             => 'dropcrm_membership',
  );

  $info['crm_membership_payment'] = array(
    'label'              => t('Membership Payment'),
    'plural label'       => t('Membership Payments'),
    'description'        => t('A manually-recorded dues payment against a membership.'),
    'entity class'       => 'CrmMembershipPayment',
    'controller class'   => 'CrmMembershipPaymentController',
    'views controller class' => 'EntityPlusDefaultViewsController',
    'base table'         => 'crm_membership_payment',
    'fieldable'          => FALSE,
    'entity keys'        => array(
      'id' => 'pid',
    ),
    'uri callback'       => 'entity_class_uri',
    'access callback'    => 'dropcrm_membership_payment_access',
    'module'             => 'dropcrm_membership',
  );

  return $info;
}

// ---------------------------------------------------------------------------
// Entity property info (drives Views integration)
// ---------------------------------------------------------------------------

/**
 * Implements hook_entity_property_info().
 *
 * Every schema column is declared so EntityPlusDefaultViewsController exposes
 * it automatically. Foreign keys are typed as their target entity so Views
 * relationships are generated for free.
 */
function dropcrm_membership_entity_property_info() {
  $info = array();

  // --- crm_membership properties ---
  $m = &$info['crm_membership']['properties'];
  $m['mid'] = array(
    'label'          => t('Membership ID'),
    'type'           => 'integer',
    'description'    => t('Internal numeric identifier for this membership record.'),
    'schema field'   => 'mid',
    'getter callback' => 'entity_plus_property_verbatim_get',
  );
  $m['cid'] = array(
    'label'          => t('Contact'),
    'type'           => 'crm_contact',
    'description'    => t('The CRM contact who is the member.'),
    'schema field'   => 'cid',
    'getter callback' => 'entity_plus_property_verbatim_get',
    'setter callback' => 'entity_plus_property_verbatim_set',
  );
  $m['member_id'] = array(
    'label'          => t('Member ID'),
    'type'           => 'text',
    'description'    => t('Optional human-friendly identifier (e.g. M-0042).'),
    'schema field'   => 'member_id',
    'getter callback' => 'entity_plus_property_verbatim_get',
    'setter callback' => 'entity_plus_property_verbatim_set',
  );
  $m['type'] = array(
    'label'          => t('Membership Type'),
    'type'           => 'token',
    'description'    => t('Membership type key.'),
    'schema field'   => 'type',
    'options list'   => '_dropcrm_membership_type_options',
    'getter callback' => 'entity_plus_property_verbatim_get',
    'setter callback' => 'entity_plus_property_verbatim_set',
  );
  $m['status'] = array(
    'label'          => t('Status'),
    'type'           => 'integer',
    'description'    => t('Membership status (active, grace, lapsed, pending, cancelled).'),
    'schema field'   => 'status',
    'options list'   => '_dropcrm_membership_status_options',
    'getter callback' => 'entity_plus_property_verbatim_get',
    'setter callback' => 'entity_plus_property_verbatim_set',
  );
  $m['created'] = array(
    'label'          => t('Date Created'),
    'type'           => 'date',
    'description'    => t('Date when the membership record was first created.'),
    'schema field'   => 'created',
    'getter callback' => 'entity_plus_property_verbatim_get',
  );
  $m['changed'] = array(
    'label'          => t('Date Modified'),
    'type'           => 'date',
    'description'    => t('Date when the membership record was last modified.'),
    'schema field'   => 'changed',
    'getter callback' => 'entity_plus_property_verbatim_get',
  );
  $m['uid'] = array(
    'label'          => t('Created by'),
    'type'           => 'user',
    'description'    => t('User account that created or last edited this membership record.'),
    'schema field'   => 'uid',
    'getter callback' => 'entity_plus_property_verbatim_get',
    'setter callback' => 'entity_plus_property_verbatim_set',
  );
  // Denormalized cache columns — kept fresh by hook_crm_membership_term_*
  // and hook_crm_membership_payment_*. Declared as schema-backed properties
  // so EntityPlusDefaultViewsController exposes them as native fields on
  // the crm_membership base table (filterable, sortable, no relationship
  // join required).
  $m['current_end_date'] = array(
    'label'           => t('Current term ends'),
    'type'            => 'date',
    'description'     => t('End date of the latest term. NULL for lifetime memberships or memberships with no terms.'),
    'schema field'    => 'current_end_date',
    'getter callback' => '_dropcrm_membership_date_get',
  );
  $m['last_payment_date'] = array(
    'label'           => t('Last payment date'),
    'type'            => 'date',
    'description'     => t("Most recent payment's paid date. NULL if no payments recorded."),
    'schema field'    => 'last_payment_date',
    'getter callback' => '_dropcrm_membership_date_get',
  );
  $m['total_paid'] = array(
    'label'           => t('Total paid'),
    'type'            => 'decimal',
    'description'     => t('Sum of all payments recorded against this membership.'),
    'schema field'    => 'total_paid',
    'getter callback' => 'entity_plus_property_verbatim_get',
  );
  // Keep joined_date as a method on the entity class (not a property) — it's
  // only used in PHP code paths and never changes after initial creation, so
  // there's no reason to maintain it as a denormalized column.

  // --- crm_membership_term properties ---
  $t = &$info['crm_membership_term']['properties'];
  $t['tid'] = array(
    'label'          => t('Term ID'),
    'type'           => 'integer',
    'description'    => t('Internal numeric identifier for this term record.'),
    'schema field'   => 'tid',
    'getter callback' => 'entity_plus_property_verbatim_get',
  );
  $t['mid'] = array(
    'label'          => t('Membership'),
    'type'           => 'crm_membership',
    'description'    => t('The membership this term belongs to.'),
    'schema field'   => 'mid',
    'getter callback' => 'entity_plus_property_verbatim_get',
    'setter callback' => 'entity_plus_property_verbatim_set',
  );
  $t['start_date'] = array(
    'label'          => t('Term Start'),
    'type'           => 'date',
    'description'    => t('Date when this term begins.'),
    'schema field'   => 'start_date',
    'getter callback' => '_dropcrm_membership_date_get',
    'setter callback' => '_dropcrm_membership_date_set',
  );
  $t['end_date'] = array(
    'label'          => t('Term End'),
    'type'           => 'date',
    'description'    => t('NULL means lifetime term.'),
    'schema field'   => 'end_date',
    'getter callback' => '_dropcrm_membership_date_get',
    'setter callback' => '_dropcrm_membership_date_set',
