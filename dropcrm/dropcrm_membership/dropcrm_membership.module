    'controller class'   => 'CrmMembershipTermController',
    'views controller class' => 'EntityPlusDefaultViewsController',
    'base table'         => 'crm_membership_term',
    'fieldable'          => FALSE,
    'entity keys'        => array(
      'id' => 'tid',
    ),
    'uri callback'       => 'entity_class_uri',
    'access callback'    => 'dropcrm_membership_term_access',
    'module'             => 'dropcrm_membership',
  );

  $info['crm_membership_payment'] = array(
    'label'              => t('Membership Payment'),
    'plural label'       => t('Membership Payments'),
    'description'        => t('A manually-recorded dues payment against a membership.'),
    'entity class'       => 'CrmMembershipPayment',
    'controller class'   => 'CrmMembershipPaymentController',
    'views controller class' => 'EntityPlusDefaultViewsController',
    'base table'         => 'crm_membership_payment',
    'fieldable'          => FALSE,
    'entity keys'        => array(
      'id' => 'pid',
    ),
    'uri callback'       => 'entity_class_uri',
    'access callback'    => 'dropcrm_membership_payment_access',
    'module'             => 'dropcrm_membership',
