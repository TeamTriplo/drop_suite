// ---------------------------------------------------------------------------
// Permissions
// ---------------------------------------------------------------------------

/**
 * Implements hook_permission().
 */
function dropcrm_membership_permission() {
  return array(
    'administer dropcrm_membership' => array(
      'title'           => t('Administer DropCRM Membership'),
      'description'     => t('Manage settings, types, and payment methods. Implies all other membership permissions.'),
      'restrict access' => TRUE,
    ),
    'access dropcrm_membership' => array(
      'title'       => t('View memberships and payments'),
      'description' => t('View membership records and payment history.'),
    ),
    'manage dropcrm_membership' => array(
      'title'       => t('Manage memberships'),
      'description' => t('Create memberships, record renewals, and log payments.'),
    ),
    'cancel dropcrm_membership' => array(
      'title'       => t('Cancel memberships'),
      'description' => t('Mark memberships as cancelled. Separate from manage because it is a terminal action.'),
    ),
  );
}

/**
 * Access callback for crm_membership.
 */
function dropcrm_membership_access($op, $entity = NULL, $account = NULL) {
  global $user;
  if (!$account) {
    $account = $user;
  }
  if (user_access('administer dropcrm_membership', $account)) {
    return TRUE;
  }
  switch ($op) {
    case 'view':
      return user_access('access dropcrm_membership', $account);
    case 'create':
    case 'update':
      return user_access('manage dropcrm_membership', $account);
    case 'delete':
      return user_access('administer dropcrm_membership', $account);
  }
  return FALSE;
}

/**
 * Access callback for crm_membership_term.
 */
function dropcrm_membership_term_access($op, $entity = NULL, $account = NULL) {
  return dropcrm_membership_access($op, $entity, $account);
}

/**
 * Access callback for crm_membership_payment.
 */
function dropcrm_membership_payment_access($op, $entity = NULL, $account = NULL) {
  return dropcrm_membership_access($op, $entity, $account);
}

