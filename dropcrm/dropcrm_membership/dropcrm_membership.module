<?php
/**
 * @file
 * DropCRM Membership — membership management for DropCRM.
 *
 * Provides three entity types linked to crm_contact:
 *  - crm_membership: the member relationship (one row per member)
 *  - crm_membership_term: one row per term (initial join + each renewal)
 *  - crm_membership_payment: manual log of dues payments
 */

// Status code constants mirror the ones in dropcrm_membership.install so they
// are loaded at runtime without needing the install file.
if (!defined('DROPCRM_MEMBERSHIP_STATUS_LAPSED')) {
  define('DROPCRM_MEMBERSHIP_STATUS_LAPSED',    0);
  define('DROPCRM_MEMBERSHIP_STATUS_ACTIVE',    1);
  define('DROPCRM_MEMBERSHIP_STATUS_CANCELLED', 2);
  define('DROPCRM_MEMBERSHIP_STATUS_PENDING',   3);
  define('DROPCRM_MEMBERSHIP_STATUS_GRACE',     4);
}

// ---------------------------------------------------------------------------
// Autoload
// ---------------------------------------------------------------------------

/**
 * Implements hook_autoload_info().
 */
function dropcrm_membership_autoload_info() {
  return array(
    'CrmMembership'                    => 'dropcrm_membership.entity.inc',
    'CrmMembershipController'          => 'dropcrm_membership.entity.inc',
    'CrmMembershipTerm'                => 'dropcrm_membership.entity.inc',
    'CrmMembershipTermController'      => 'dropcrm_membership.entity.inc',
    'CrmMembershipPayment'             => 'dropcrm_membership.entity.inc',
    'CrmMembershipPaymentController'   => 'dropcrm_membership.entity.inc',
  );
}

