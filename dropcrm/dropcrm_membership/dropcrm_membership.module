/**
 * Implements hook_menu().
 */
function dropcrm_membership_menu() {
  $items = array();

  $items['drop/crm/memberships'] = array(
    'title'            => 'Memberships',
    'page callback'    => 'dropcrm_membership_list_page',
    'access arguments' => array('access dropcrm_membership'),
    'file'             => 'dropcrm_membership.admin.inc',
    'type'             => MENU_NORMAL_ITEM,
  );

  $items['drop/crm/memberships/list'] = array(
    'title'  => 'List',
    'type'   => MENU_DEFAULT_LOCAL_TASK,
    'weight' => -10,
  );

  $items['drop/crm/memberships/add'] = array(
    'title'            => 'Add membership',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('dropcrm_membership_form'),
    'access arguments' => array('manage dropcrm_membership'),
    'file'             => 'dropcrm_membership.admin.inc',
    'type'             => MENU_LOCAL_ACTION,
  );

  $items['drop/crm/memberships/%crm_membership'] = array(
    'title callback'   => 'dropcrm_membership_page_title',
    'title arguments'  => array(3),
    'page callback'    => 'dropcrm_membership_view_page',
    'page arguments'   => array(3),
    'access callback'  => 'dropcrm_membership_access',
    'access arguments' => array('view', 3),
    'file'             => 'dropcrm_membership.admin.inc',
  );

  $items['drop/crm/memberships/%crm_membership/view'] = array(
    'title'  => 'View',
    'type'   => MENU_DEFAULT_LOCAL_TASK,
    'weight' => -10,
  );

  $items['drop/crm/memberships/%crm_membership/edit'] = array(
    'title'            => 'Edit',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('dropcrm_membership_form', 3),
    'access callback'  => 'dropcrm_membership_access',
    'access arguments' => array('update', 3),
    'file'             => 'dropcrm_membership.admin.inc',
    'type'             => MENU_LOCAL_TASK,
    'weight'           => 0,
  );

  // Renew — invoked from the action bar on the view page, not a local task.
  $items['drop/crm/memberships/%crm_membership/renew'] = array(
    'title'            => 'Renew',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('dropcrm_membership_renew_form', 3),
    'access callback'  => 'dropcrm_membership_access',
    'access arguments' => array('update', 3),
    'file'             => 'dropcrm_membership.admin.inc',
  );

  // Record payment — action-bar verb, not a local task.
  $items['drop/crm/memberships/%crm_membership/payment/add'] = array(
    'title'            => 'Record payment',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('dropcrm_membership_payment_form', 3),
    'access callback'  => 'dropcrm_membership_access',
    'access arguments' => array('update', 3),
    'file'             => 'dropcrm_membership.admin.inc',
  );

  $items['drop/crm/memberships/%crm_membership/payment/%crm_membership_payment/edit'] = array(
    'title'            => 'Edit payment',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('dropcrm_membership_payment_form', 3, 5),
    'access callback'  => 'dropcrm_membership_access',
    'access arguments' => array('update', 3),
    'file'             => 'dropcrm_membership.admin.inc',
  );

  $items['drop/crm/memberships/%crm_membership/payment/%crm_membership_payment/delete'] = array(
    'title'            => 'Delete payment',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('dropcrm_membership_payment_delete_form', 3, 5),
    'access arguments' => array('administer dropcrm_membership'),
    'file'             => 'dropcrm_membership.admin.inc',
  );

  // Term edit + delete — edit is 'manage', delete gated on 'administer'
  // like payment delete.
  $items['drop/crm/memberships/%crm_membership/term/%crm_membership_term/edit'] = array(
    'title'            => 'Edit term',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('dropcrm_membership_term_form', 3, 5),
    'access callback'  => 'dropcrm_membership_access',
    'access arguments' => array('update', 3),
    'file'             => 'dropcrm_membership.admin.inc',
  );
  $items['drop/crm/memberships/%crm_membership/term/%crm_membership_term/delete'] = array(
    'title'            => 'Delete term',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('dropcrm_membership_term_delete_form', 3, 5),
    'access arguments' => array('administer dropcrm_membership'),
    'file'             => 'dropcrm_membership.admin.inc',
  );

  // Cancel — action-bar verb, not a local task.
