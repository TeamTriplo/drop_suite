<?php
/**
 * @file
 * Install, update, and uninstall functions for the DropCRM Membership module.
 */

// Status code constants. The .module file defines these at runtime; the
// duplicate here is only for install/update hooks that may run before the
// .module is loaded. Guarded to avoid "already defined" warnings.
if (!defined('DROPCRM_MEMBERSHIP_STATUS_LAPSED')) {
  define('DROPCRM_MEMBERSHIP_STATUS_LAPSED',    0);
  define('DROPCRM_MEMBERSHIP_STATUS_ACTIVE',    1);
  define('DROPCRM_MEMBERSHIP_STATUS_CANCELLED', 2);
  define('DROPCRM_MEMBERSHIP_STATUS_PENDING',   3);
  define('DROPCRM_MEMBERSHIP_STATUS_GRACE',     4);
}

/**
 * Implements hook_schema().
 */
function dropcrm_membership_schema() {
  $schema = array();

  $schema['crm_membership'] = array(
    'description' => 'CRM memberships, one row per member relationship.',
    'fields' => array(
      'mid' => array(
        'description' => 'Primary identifier for a membership.',
        'type'        => 'serial',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
      ),
      'cid' => array(
        'description' => 'The CRM contact (member).',
        'type'        => 'int',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
      ),
      'member_id' => array(
        'description' => 'Optional human-friendly identifier (e.g. M-0042).',
        'type'        => 'varchar',
        'length'      => 64,
        'not null'    => FALSE,
      ),
      'type' => array(
        'description' => 'Membership type key (configured in dropcrm_membership.settings).',
        'type'        => 'varchar',
        'length'      => 64,
        'not null'    => TRUE,
        'default'     => '',
      ),
      'status' => array(
        'description' => '0=lapsed, 1=active, 2=cancelled, 3=pending, 4=grace.',
        'type'        => 'int',
        'not null'    => TRUE,
        'default'     => 3,
      ),
      'created' => array(
        'description' => 'Unix timestamp when the membership row was created.',
        'type'        => 'int',
        'not null'    => TRUE,
        'default'     => 0,
      ),
      'changed' => array(
        'description' => 'Unix timestamp when the membership row was last modified.',
        'type'        => 'int',
        'not null'    => TRUE,
        'default'     => 0,
      ),
      'uid' => array(
        'description' => 'User ID of the person who created or last edited this membership.',
        'type'        => 'int',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
        'default'     => 0,
      ),
      // Denormalized cache columns, maintained by hook_crm_membership_term_*
      // and hook_crm_membership_payment_* in dropcrm_membership.module.
      // Exposed to Views as native base-table fields so admin lists + the
      // expiring-soon block and per-contact block stay one row per membership.
      'current_end_date' => array(
        'description' => "Unix timestamp of the latest term's end_date. NULL for lifetime terms or memberships with no terms.",
        'type'        => 'int',
        'not null'    => FALSE,
      ),
      'last_payment_date' => array(
        'description' => "Unix timestamp of the most recent payment's paid_date. NULL if no payments recorded.",
        'type'        => 'int',
        'not null'    => FALSE,
      ),
      'total_paid' => array(
        'description' => 'Sum of all payments recorded against this membership.',
        'type'        => 'numeric',
        'precision'   => 10,
        'scale'       => 2,
        'not null'    => TRUE,
        'default'     => 0,
      ),
    ),
    'primary key' => array('mid'),
    'indexes' => array(
      'cid'               => array('cid'),
      'status'            => array('status'),
      'status_type'       => array('status', 'type'),
      'current_end_date'  => array('current_end_date'),
    ),
    'unique keys' => array(
      'member_id' => array('member_id'),
    ),
  );

  $schema['crm_membership_term'] = array(
    'description' => 'Membership terms. One row per term (initial join + each renewal).',
    'fields' => array(
      'tid' => array(
        'description' => 'Primary identifier for a term.',
        'type'        => 'serial',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
      ),
      'mid' => array(
        'description' => 'The membership this term belongs to.',
        'type'        => 'int',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
      ),
      'start_date' => array(
        'description' => 'Unix timestamp for the start of this term.',
        'type'        => 'int',
        'not null'    => TRUE,
        'default'     => 0,
      ),
      'end_date' => array(
        'description' => 'Unix timestamp for the end of this term. NULL = lifetime term.',
        'type'        => 'int',
        'not null'    => FALSE,
      ),
      'status' => array(
        'description' => 'Same status codes as crm_membership.',
        'type'        => 'int',
        'not null'    => TRUE,
        'default'     => 1,
      ),
      'notes' => array(
        'description' => 'Free-form notes ("paid by check #1234", etc.).',
        'type'        => 'text',
        'size'        => 'normal',
        'not null'    => FALSE,
      ),
      'created' => array(
        'description' => 'Unix timestamp when the term row was recorded.',
        'type'        => 'int',
        'not null'    => TRUE,
        'default'     => 0,
      ),
      'uid' => array(
        'description' => 'User ID who recorded the term.',
        'type'        => 'int',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
        'default'     => 0,
      ),
    ),
    'primary key' => array('tid'),
    'indexes' => array(
      'mid'       => array('mid'),
      'mid_end'   => array('mid', 'end_date'),
      'end_date'  => array('end_date'),
    ),
  );

  $schema['crm_membership_payment'] = array(
    'description' => 'Manual log of membership dues payments. No gateway integration.',
    'fields' => array(
      'pid' => array(
        'description' => 'Primary identifier for a payment.',
        'type'        => 'serial',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
      ),
      'mid' => array(
        'description' => 'The membership the payment applies to.',
        'type'        => 'int',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
      ),
      'tid' => array(
        'description' => 'The specific term the payment funded. NULL if not yet associated.',
        'type'        => 'int',
        'unsigned'    => TRUE,
        'not null'    => FALSE,
      ),
      'amount' => array(
        'description' => 'Payment amount.',
        'type'        => 'numeric',
        'precision'   => 10,
        'scale'       => 2,
        'not null'    => TRUE,
        'default'     => 0,
      ),
      'paid_date' => array(
        'description' => 'Unix timestamp when the payment was received.',
        'type'        => 'int',
        'not null'    => TRUE,
        'default'     => 0,
      ),
      'method' => array(
        'description' => 'Payment method label (Check, Cash, Credit Card, Other).',
        'type'        => 'varchar',
        'length'      => 64,
        'not null'    => TRUE,
        'default'     => '',
      ),
      'reference' => array(
        'description' => 'Optional reference (check number, transaction ID, etc.).',
        'type'        => 'varchar',
        'length'      => 255,
        'not null'    => FALSE,
      ),
      'notes' => array(
        'description' => 'Optional free-form notes.',
        'type'        => 'text',
        'size'        => 'normal',
        'not null'    => FALSE,
      ),
      'created' => array(
        'description' => 'Unix timestamp when the payment row was recorded.',
        'type'        => 'int',
        'not null'    => TRUE,
        'default'     => 0,
      ),
      'uid' => array(
        'description' => 'User ID who recorded the payment.',
        'type'        => 'int',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
        'default'     => 0,
      ),
    ),
    'primary key' => array('pid'),
    'indexes' => array(
      'mid'       => array('mid'),
      'tid'       => array('tid'),
      'paid_date' => array('paid_date'),
    ),
  );

  return $schema;
}

/**
 * Implements hook_install().
 *
 * Per project pattern (CLAUDE.md), update hook logic must also run on fresh
 * install. All setup goes through idempotent helpers so the same code runs
 * from both places.
 */
function dropcrm_membership_install() {
  _dropcrm_membership_ensure_default_config();
  _dropcrm_membership_ensure_activity_types();
}

/**
 * Implements hook_uninstall().
 *
 * Removes module config. Schema (and the data in it) is removed automatically
 * by the schema API. Activity types added for renewal/cancellation are left in
 * place because the user may have logged activities of those types they want
 * to keep visible.
 */
function dropcrm_membership_uninstall() {
  config('dropcrm_membership.settings')->delete();
}

/**
 * Idempotent helper: ensure default settings config exists.
 */
function _dropcrm_membership_ensure_default_config() {
  $config = config('dropcrm_membership.settings');
  $changed = FALSE;

  if ($config->get('types') === NULL) {
    $config->set('types', array(
      'individual' => array(
        'label'        => 'Individual',
        'term_length'  => '1 year',
        'grace_days'   => 30,
        'default_dues' => '50.00',
      ),
    ));
    $changed = TRUE;
  }

  if ($config->get('payment_methods') === NULL) {
    $config->set('payment_methods', array('Check', 'Cash', 'Credit Card', 'Other'));
    $changed = TRUE;
  }

  if ($config->get('expiring_widget_window') === NULL) {
    $config->set('expiring_widget_window', 30);
    $changed = TRUE;
  }

  if ($config->get('auto_lapse_after_grace') === NULL) {
    $config->set('auto_lapse_after_grace', TRUE);
    $changed = TRUE;
  }

  if ($changed) {
    $config->save();
  }
}

/**
 * Idempotent helper: register membership_renewal and membership_cancelled
 * activity types in the dropcrm.settings activity_types config.
 */
function _dropcrm_membership_ensure_activity_types() {
  $config = config('dropcrm.settings');
  $types = $config->get('activity_types');
  if (!is_array($types)) {
    $types = array();
  }
  $changed = FALSE;

  if (!isset($types['membership_renewal'])) {
    $types['membership_renewal'] = array(
      'label'         => 'Membership renewal',
      'has_direction' => 0,
    );
    $changed = TRUE;
  }
  if (!isset($types['membership_cancelled'])) {
    $types['membership_cancelled'] = array(
      'label'         => 'Membership cancelled',
      'has_direction' => 0,
    );
    $changed = TRUE;
  }

  if ($changed) {
    $config->set('activity_types', $types);
    $config->save();
  }
}

/**
 * Backfill auto-generated Member IDs for existing memberships that have
 * none set (member_id IS NULL or empty). Member IDs are now auto-generated
 * on create; this catches anything created before that change.
 */
function dropcrm_membership_update_1000() {
  module_load_include('module', 'dropcrm_membership');
  $mids = db_query("SELECT mid FROM {crm_membership} WHERE member_id IS NULL OR member_id = ''")->fetchCol();
  $count = 0;
  foreach ($mids as $mid) {
    db_update('crm_membership')
      ->fields(array('member_id' => _dropcrm_membership_generate_member_id($mid)))
      ->condition('mid', $mid)
      ->execute();
    $count++;
  }
  return t('Backfilled Member IDs for @count membership(s).', array('@count' => $count));
}

/**
 * Add three denormalized cache columns to crm_membership and backfill from
 * existing term / payment data. Exposes current_end_date, last_payment_date,
 * and total_paid as native base-table fields for Views UI use.
 */
function dropcrm_membership_update_1001() {
  $spec = array(
    'current_end_date' => array(
      'description' => 'Latest term end_date. NULL for lifetime or no terms.',
      'mysql_type'  => 'date',
      'type'        => 'varchar',
      'length'      => 10,
      'not null'    => FALSE,
    ),
    'last_payment_date' => array(
      'description' => 'Most recent payment paid_date. NULL if no payments.',
      'mysql_type'  => 'date',
      'type'        => 'varchar',
      'length'      => 10,
      'not null'    => FALSE,
    ),
    'total_paid' => array(
      'description' => 'Sum of all payments.',
      'type'        => 'numeric',
      'precision'   => 10,
      'scale'       => 2,
      'not null'    => TRUE,
      'default'     => 0,
    ),
  );
  foreach ($spec as $col => $def) {
    if (!db_field_exists('crm_membership', $col)) {
      db_add_field('crm_membership', $col, $def);
    }
  }
  if (!db_index_exists('crm_membership', 'current_end_date')) {
    db_add_index('crm_membership', 'current_end_date', array('current_end_date'));
  }

  // Backfill. Use one query per aggregate for simplicity; small data size.
  db_query("
    UPDATE {crm_membership} m
    LEFT JOIN (
      SELECT mid, end_date
      FROM (
        SELECT mid, end_date,
               ROW_NUMBER() OVER (PARTITION BY mid ORDER BY start_date DESC, tid DESC) AS rn
        FROM {crm_membership_term}
      ) ranked
      WHERE rn = 1
    ) t ON t.mid = m.mid
    SET m.current_end_date = t.end_date
  ");
  db_query("
    UPDATE {crm_membership} m
    LEFT JOIN (
      SELECT mid, paid_date
      FROM (
        SELECT mid, paid_date,
               ROW_NUMBER() OVER (PARTITION BY mid ORDER BY paid_date DESC, pid DESC) AS rn
        FROM {crm_membership_payment}
      ) ranked
      WHERE rn = 1
    ) p ON p.mid = m.mid
    SET m.last_payment_date = p.paid_date
  ");
  db_query("
    UPDATE {crm_membership} m
    LEFT JOIN (
      SELECT mid, COALESCE(SUM(amount), 0) AS total
      FROM {crm_membership_payment}
      GROUP BY mid
    ) p ON p.mid = m.mid
    SET m.total_paid = COALESCE(p.total, 0)
  ");

  $count = (int) db_query('SELECT COUNT(*) FROM {crm_membership}')->fetchField();
  return t('Added current_end_date, last_payment_date, total_paid columns and backfilled @count membership(s).', array('@count' => $count));
}

/**
 * Convert all date columns from VARCHAR(10) to real DATE type.
 *
 * The original schema declared type=varchar length=10 with
 * mysql_type=date, but Backdrop's db_add_field ignores mysql_type and
 * produces VARCHAR(10). Views date filters then generate SQL that
 * compares Unix timestamps against VARCHAR — MySQL string-to-int casts
 * "2026-04-24" as 2026, which never satisfies >= 1745000000, so
 * filtered views return nothing. Real DATE columns fix it.
 *
 * Affected columns:
 *   crm_membership.current_end_date
 *   crm_membership.last_payment_date
 *   crm_membership_term.start_date
 *   crm_membership_term.end_date
 *   crm_membership_payment.paid_date
 */
function dropcrm_membership_update_1002() {
  // Clean up any '0000-00-00' sentinels that won't convert cleanly under
  // MySQL strict mode. start_date is NOT NULL so drop such rows to today.
  db_query("UPDATE {crm_membership_term} SET start_date = CURDATE() WHERE start_date = '0000-00-00'");
  db_query("UPDATE {crm_membership_payment} SET paid_date = CURDATE() WHERE paid_date = '0000-00-00'");

  // ALTER each column. Preserve NOT NULL where it was; allow NULL where it
  // was nullable (end_date for lifetime terms, current_end_date and
  // last_payment_date for memberships with no term / no payments).
  db_query("ALTER TABLE {crm_membership} MODIFY current_end_date DATE NULL DEFAULT NULL");
  db_query("ALTER TABLE {crm_membership} MODIFY last_payment_date DATE NULL DEFAULT NULL");
  db_query("ALTER TABLE {crm_membership_term} MODIFY start_date DATE NOT NULL");
  db_query("ALTER TABLE {crm_membership_term} MODIFY end_date DATE NULL DEFAULT NULL");
  db_query("ALTER TABLE {crm_membership_payment} MODIFY paid_date DATE NOT NULL");

  return t('Converted 5 date columns from VARCHAR(10) to DATE. Views date filters on current_end_date, end_date, paid_date now work correctly.');
}

/**
 * Convert the five date columns from DATE to INT (Unix timestamp).
 *
 * Aligning with the dropcrm convention (crm_activity.activity_date,
 * .due_date, .created, .changed are all int). Views' default date filter
 * handler assumes Unix timestamps; DATE columns made filters misbehave.
 * Keeping dates as int timestamps means Views works out of the box and
 * the module surface matches the rest of the CRM family.
 */
function dropcrm_membership_update_1003() {
  $conversions = array(
    array('crm_membership',         'current_end_date',  TRUE),
    array('crm_membership',         'last_payment_date', TRUE),
    array('crm_membership_term',    'start_date',        FALSE),
    array('crm_membership_term',    'end_date',          TRUE),
    array('crm_membership_payment', 'paid_date',         FALSE),
  );
  foreach ($conversions as $c) {
    list($table, $col, $nullable) = $c;
    $tmp = $col . '_int_tmp';
    // Idempotent: skip if already INT.
    $info = db_query("SHOW COLUMNS FROM {" . $table . "} LIKE :c", array(':c' => $col))->fetch();
    if (!$info || stripos($info->Type, 'int') !== FALSE) {
      continue;
    }
    db_query("ALTER TABLE {" . $table . "} ADD COLUMN $tmp INT NULL");
    db_query("UPDATE {" . $table . "} SET $tmp = UNIX_TIMESTAMP($col) WHERE $col IS NOT NULL");
    db_query("ALTER TABLE {" . $table . "} DROP COLUMN $col");
    if ($nullable) {
      db_query("ALTER TABLE {" . $table . "} CHANGE $tmp $col INT NULL DEFAULT NULL");
    }
    else {
      db_query("UPDATE {" . $table . "} SET $tmp = 0 WHERE $tmp IS NULL");
      db_query("ALTER TABLE {" . $table . "} CHANGE $tmp $col INT NOT NULL DEFAULT 0");
    }
  }
  if (!db_index_exists('crm_membership', 'current_end_date')) {
    db_add_index('crm_membership', 'current_end_date', array('current_end_date'));
  }
  if (!db_index_exists('crm_membership_term', 'end_date')) {
    db_add_index('crm_membership_term', 'end_date', array('end_date'));
  }
  if (!db_index_exists('crm_membership_term', 'mid_end')) {
    db_add_index('crm_membership_term', 'mid_end', array('mid', 'end_date'));
  }
  if (!db_index_exists('crm_membership_payment', 'paid_date')) {
    db_add_index('crm_membership_payment', 'paid_date', array('paid_date'));
  }
  return t('Converted 5 date columns from DATE to INT (Unix timestamp). Views date filters now work natively via the core views_handler_filter_date.');
}
