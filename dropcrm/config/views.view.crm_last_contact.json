{
    "_config_name": "views.view.crm_last_contact",
    "name": "crm_last_contact",
    "description": "People sorted by how long since their last completed activity. Lands at /drop/crm so admins arrive on an actionable working surface.",
    "module": "dropcrm",
    "tag": "Drop Suite",
    "disabled": false,
    "base_table": "crm_contact",
    "human_name": "CRM People by Last Contact",
    "core": "1.x",
    "display": {
        "default": {
            "display_title": "Default",
            "display_plugin": "default",
            "display_options": {
                "query": {
                    "type": "views_query",
                    "options": []
                },
                "title": "CRM",
                "access": {
                    "type": "perm",
                    "perm": "access crm"
                },
                "group_by": true,
                "style_plugin": "table",
                "style_options": {
                    "columns": {
                        "name": "name",
                        "activity_date": "activity_date"
                    },
                    "default": "activity_date",
                    "info": {
                        "name": {
                            "sortable": true,
                            "default_sort_order": "asc",
                            "align": "",
                            "separator": ""
                        },
                        "activity_date": {
                            "sortable": true,
                            "default_sort_order": "asc",
                            "align": "",
                            "separator": ""
                        }
                    }
                },
                "relationships": {
                    "reverse_field_crm_contacts_crm_activity": {
                        "id": "reverse_field_crm_contacts_crm_activity",
                        "table": "crm_contact",
                        "field": "reverse_field_crm_contacts_crm_activity",
                        "label": "Activity",
                        "required": false
                    }
                },
                "fields": {
                    "name": {
                        "id": "name",
                        "table": "crm_contact",
                        "field": "name",
                        "label": "Name",
                        "link_to_entity": true,
                        "group_type": "group"
                    },
                    "activity_date": {
                        "id": "activity_date",
                        "table": "crm_activity",
                        "field": "activity_date",
                        "relationship": "reverse_field_crm_contacts_crm_activity",
                        "label": "Last Contact",
                        "group_type": "max",
                        "date_format": "custom",
                        "custom_date_format": "M j, Y",
                        "empty": "Never"
                    }
                },
                "filters": {
                    "type": {
                        "id": "type",
                        "table": "crm_contact",
                        "field": "type",
                        "value": {
                            "crm_person": "crm_person"
                        },
                        "group_type": "group"
                    },
                    "status": {
                        "id": "status",
                        "table": "crm_contact",
                        "field": "status",
                        "value": "1",
                        "group_type": "group"
                    }
                },
                "sorts": {
                    "activity_date": {
                        "id": "activity_date",
                        "table": "crm_activity",
                        "field": "activity_date",
                        "relationship": "reverse_field_crm_contacts_crm_activity",
                        "order": "ASC",
                        "group_type": "max"
                    }
                },
                "pager": {
                    "type": "full",
                    "options": {
                        "items_per_page": 50
                    }
                },
                "empty": {
                    "area": {
                        "id": "area",
                        "table": "views",
                        "field": "area",
                        "content": "No people found."
                    }
                }
            }
        },
        "page": {
            "display_title": "Page",
            "display_plugin": "page",
            "display_options": {
                "path": "drop/crm",
                "menu": {
                    "type": "none"
                }
            }
        }
    }
}
