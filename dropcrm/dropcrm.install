      'cid_b' => array('cid_b'),
      'type'  => array('type'),
    ),
  );

  return $schema;
}

/**
 * Implements hook_install().
 *
 * Creates the default field bases and instances for all CRM entity bundles.
 */
function dropcrm_install() {
  _dropcrm_create_fields();
  _dropcrm_ensure_contact_tags();
  _dropcrm_ensure_contact_types();

  module_load_include('inc', 'dropcrm', 'dropcrm.admin');
  $config = config('dropcrm.settings');
  if (!$config->get('relationship_types')) {
    $config->set('relationship_types', _dropcrm_default_relationship_types());
    $config->save();
  }

  // Import the crm_contacts view.
  $module_path = backdrop_get_path('module', 'dropcrm');
  $config_path = $module_path . '/config/views.view.crm_contacts.json';
  if (file_exists($config_path)) {
    $data = json_decode(file_get_contents($config_path), TRUE);
    $view_config = config('views.view.crm_contacts');
    $view_config->setData($data);
    $view_config->save();
  }

  drop_base_grant_admin_permissions('dropcrm');
}

/**
 * Creates the drop_tags vocabulary (if needed) and attaches field_drop_tags
 * to all CRM contact bundles with default seed tags.
 */
function _dropcrm_ensure_contact_tags() {
  // Ensure the drop_tags vocabulary exists.
  $vocab = taxonomy_vocabulary_machine_name_load('drop_tags');
  if (!$vocab) {
    $vocab = new TaxonomyVocabulary(array(
      'name'         => 'Drop Tags',
      'machine_name' => 'drop_tags',
      'description'  => 'Shared tags used across the Drop module suite.',
    ));
    taxonomy_vocabulary_save($vocab);
  }

  // Ensure the field_drop_tags field exists.
  if (!field_info_field('field_drop_tags')) {
    field_create_field(array(
      'field_name'  => 'field_drop_tags',
      'type'        => 'taxonomy_term_reference',
      'settings'    => array(
        'allowed_values' => array(
          array('vocabulary' => 'drop_tags', 'parent' => 0),
        ),
      ),
      'cardinality' => FIELD_CARDINALITY_UNLIMITED,
    ));
  }

  // Attach to each crm_contact bundle.
  $bundles = array('crm_person', 'crm_organization', 'crm_household');
  foreach ($bundles as $bundle) {
    if (!field_info_instance('crm_contact', 'field_drop_tags', $bundle)) {
      field_create_instance(array(
        'field_name'  => 'field_drop_tags',
        'entity_type' => 'crm_contact',
        'bundle'      => $bundle,
        'label'       => 'Tags',
        'required'    => FALSE,
        'description' => 'Tags for this contact, e.g. Client, Prospect, Partner.',
        'widget'      => array(
          'type'     => 'taxonomy_autocomplete',
          'settings' => array('size' => 60),
        ),
        'display' => array(
          'default' => array(
            'label'  => 'above',
            'type'   => 'taxonomy_term_reference_link',
            'weight' => 5,
          ),
        ),
      ));
    }
  }

  // Seed default tags.
  $default_tags = array('Client', 'Past Client', 'Prospect', 'Partner', 'Vendor');
  foreach ($default_tags as $tag_name) {
    $existing = taxonomy_term_load_multiple(array(), array(
      'name'       => $tag_name,
      'vocabulary' => $vocab->machine_name,
    ));
    if (empty($existing)) {
      $term = new TaxonomyTerm(array(
        'name'       => $tag_name,
        'vocabulary' => $vocab->machine_name,
      ));
      taxonomy_term_save($term);
    }
  }
}

/**
 * Creates the contact_types vocabulary and field_contact_type, attached to
 * all CRM contact bundles. Distinct from field_drop_tags (free-form tagging)
 * — this is a bounded categorization of how each contact relates to us.
 *
 * Multi-value: a person can be both Client and Personal, or Prospect and
 * Partner. Querying "all clients" becomes a clean entity query against this
 * field instead of a substring match against the generic tags.
 */
function _dropcrm_ensure_contact_types() {
  // Ensure the contact_types vocabulary exists.
  $vocab = taxonomy_vocabulary_machine_name_load('contact_types');
  if (!$vocab) {
    $vocab = new TaxonomyVocabulary(array(
      'name'         => 'Contact Types',
      'machine_name' => 'contact_types',
      'description'  => 'Bounded categorization of how a CRM contact relates to us (Client, Prospect, Partner, etc.). Distinct from free-form Tags.',
    ));
    taxonomy_vocabulary_save($vocab);
  }

  // Ensure the field_contact_type field base exists.
  if (!field_info_field('field_contact_type')) {
    field_create_field(array(
      'field_name'  => 'field_contact_type',
      'type'        => 'taxonomy_term_reference',
      'settings'    => array(
        'allowed_values' => array(
          array('vocabulary' => 'contact_types', 'parent' => 0),
        ),
      ),
      'cardinality' => FIELD_CARDINALITY_UNLIMITED,
    ));
  }

  // Attach to each crm_contact bundle.
  $bundles = array('crm_person', 'crm_organization', 'crm_household');
  foreach ($bundles as $bundle) {
    if (!field_info_instance('crm_contact', 'field_contact_type', $bundle)) {
      field_create_instance(array(
        'field_name'  => 'field_contact_type',
        'entity_type' => 'crm_contact',
        'bundle'      => $bundle,
        'label'       => 'Contact type',
        'required'    => FALSE,
        'description' => 'How this contact relates to us. Pick all that apply.',
        'widget'      => array(
          'type'   => 'options_buttons',
          'weight' => -5,
        ),
        'display' => array(
          'default' => array(
            'label'  => 'inline',
            'type'   => 'taxonomy_term_reference_link',
            'weight' => 4,
          ),
        ),
      ));
    }
  }

  // Seed default terms. Note: parent must be set explicitly to [0] — without
  // it, taxonomy_term_save() does not write a row to taxonomy_term_hierarchy,
  // and the term overview page (which JOINs that table) shows nothing.
  $default_types = array(
    'Client',
    'Past Client',
    'Prospect',
    'Partner',
    'Vendor',
    'Personal',
    'Internal',
  );
  foreach ($default_types as $type_name) {
    $existing = taxonomy_term_load_multiple(array(), array(
      'name'       => $type_name,
      'vocabulary' => $vocab->machine_name,
    ));
    if (empty($existing)) {
      $term = new TaxonomyTerm(array(
        'name'       => $type_name,
        'vocabulary' => $vocab->machine_name,
        'parent'     => array(0),
      ));
      taxonomy_term_save($term);
    }
  }
}

/**
 * Migrates contact-type-ish values from field_drop_tags to field_contact_type.
 *
 * For each contact, looks at their drop_tags terms; any whose name matches a
 * known synonym for a contact_types term gets copied into the new field. The
 * original tag is left in place — the user can clean up the old tags manually
 * once they have confirmed the migration looks right.
 *
 * Synonym map is intentionally generous so common variations like "Current
 * Client" / "Former Client" / "Family" are caught without manual cleanup.
 *
 * @return int
 *   Count of contacts that received at least one new contact_type value.
 */
function _dropcrm_migrate_drop_tags_to_contact_types() {
  if (!taxonomy_vocabulary_machine_name_load('contact_types')) {
    return 0;
  }

  // Map drop_tags term names (lowercased) → contact_types term names.
  $synonyms = array(
    'client'         => 'Client',
    'current client' => 'Client',
    'active client'  => 'Client',
    'past client'    => 'Past Client',
    'former client'  => 'Past Client',
    'previous client' => 'Past Client',
    'prospect'       => 'Prospect',
    'lead'           => 'Prospect',
    'partner'        => 'Partner',
    'vendor'         => 'Vendor',
    'supplier'       => 'Vendor',
    'personal'       => 'Personal',
    'family'         => 'Personal',
    'friend'         => 'Personal',
    'internal'       => 'Internal',
    'staff'          => 'Internal',
    'team'           => 'Internal',
  );

  // Load all contact_types terms keyed by name.
  $contact_type_terms = array();
  $terms = entity_load('taxonomy_term', FALSE, array('vocabulary' => 'contact_types'));
  foreach ($terms as $term) {
    $contact_type_terms[$term->name] = $term->tid;
  }
  if (empty($contact_type_terms)) {
    return 0;
  }

  $migrated = 0;
  $contacts = entity_load('crm_contact', FALSE);
  foreach ($contacts as $contact) {
    if (empty($contact->field_drop_tags[LANGUAGE_NONE])) {
      continue;
    }

    $existing_type_tids = array();
    if (!empty($contact->field_contact_type[LANGUAGE_NONE])) {
      foreach ($contact->field_contact_type[LANGUAGE_NONE] as $item) {
        $existing_type_tids[] = (int) $item['tid'];
      }
    }

    $added = FALSE;
    foreach ($contact->field_drop_tags[LANGUAGE_NONE] as $item) {
      $tag_term = taxonomy_term_load($item['tid']);
      if (!$tag_term) {
        continue;
      }
      $key = strtolower(trim($tag_term->name));
      if (!isset($synonyms[$key])) {
        continue;
      }
      $target_name = $synonyms[$key];
      if (!isset($contact_type_terms[$target_name])) {
        continue;
      }
      $target_tid = (int) $contact_type_terms[$target_name];
      if (in_array($target_tid, $existing_type_tids, TRUE)) {
        continue;
      }
      $contact->field_contact_type[LANGUAGE_NONE][] = array('tid' => $target_tid);
      $existing_type_tids[] = $target_tid;
      $added = TRUE;
    }

    if ($added) {
      entity_plus_save('crm_contact', $contact);
      $migrated++;
    }
  }

  return $migrated;
}

/**
 * Creates all default field bases and instances for DropCRM entities.
 */
function _dropcrm_create_fields() {
  // --- Field bases ---
  $fields = array(
    // Person: first name.
    array(
      'field_name' => 'field_crm_first_name',
      'type' => 'text',
      'cardinality' => 1,
    ),
    // Person: last name.
    array(
      'field_name' => 'field_crm_last_name',
      'type' => 'text',
      'cardinality' => 1,
    ),
    // Person: middle name.
    array(
      'field_name' => 'field_crm_middle_name',
      'type' => 'text',
      'cardinality' => 1,
    ),
    // Person: job title.
    array(
      'field_name' => 'field_crm_job_title',
      'type' => 'text',
      'cardinality' => 1,
    ),
    // Person: employer (entity reference to crm_organization).
    array(
      'field_name' => 'field_crm_employer',
      'type' => 'entityreference',
      'cardinality' => 1,
      'settings' => array(
        'target_type' => 'crm_contact',
        'handler' => 'base',
        'handler_settings' => array(
          'target_bundles' => array('crm_organization' => 'crm_organization'),
          'sort' => array('type' => 'none'),
        ),
      ),
    ),
    // Organization: description.
    array(
      'field_name' => 'field_crm_org_description',
      'type' => 'text_long',
      'cardinality' => 1,
    ),
    // Organization: website.
    array(
      'field_name' => 'field_crm_website',
      'type' => 'text',
      'cardinality' => 1,
    ),
    // Activity: body / notes.
    array(
      'field_name' => 'field_crm_activity_body',
      'type' => 'text_long',
      'cardinality' => 1,
    ),
    // Activity: linked contacts (entity reference, multiple).
    array(
      'field_name' => 'field_crm_contacts',
      'type' => 'entityreference',
      'cardinality' => FIELD_CARDINALITY_UNLIMITED,
      'settings' => array(
        'target_type' => 'crm_contact',
        'handler' => 'base',
        'handler_settings' => array(
          'target_bundles' => array(),
          'sort' => array('type' => 'none'),
        ),
      ),
    ),
    // Address: street.
    array(
      'field_name' => 'field_crm_street',
      'type' => 'text',
      'cardinality' => 1,
    ),
    // Address: city.
    array(
      'field_name' => 'field_crm_city',
      'type' => 'text',
      'cardinality' => 1,
    ),
    // Address: state or province.
    array(
      'field_name' => 'field_crm_state_province',
      'type' => 'text',
      'cardinality' => 1,
    ),
    // Address: postal code.
    array(
      'field_name' => 'field_crm_postal_code',
      'type' => 'text',
      'cardinality' => 1,
    ),
    // Address: country.
    array(
      'field_name' => 'field_crm_country',
      'type' => 'text',
      'cardinality' => 1,
    ),
    // Contact: status (free-text note).
    array(
      'field_name' => 'field_crm_status',
      'type' => 'text_long',
      'cardinality' => 1,
    ),
    // Contact: rating (1-5 stars).
    array(
      'field_name'  => 'field_crm_rating',
      'type'        => 'list_integer',
      'cardinality' => 1,
      'settings'    => array(
        'allowed_values' => array(
          1 => '★',
          2 => '★★',
          3 => '★★★',
          4 => '★★★★',
          5 => '★★★★★',
        ),
      ),
    ),
    // Organization: warmth (Hot/Warm/Cold).
    array(
      'field_name'  => 'field_crm_warmth',
      'type'        => 'list_text',
      'cardinality' => 1,
      'settings'    => array(
        'allowed_values' => array(
          'hot'  => 'Hot',
          'warm' => 'Warm',
          'cold' => 'Cold',
        ),
      ),
    ),
    // --- tid 610 P1: CiviCRM-import-driven contact fields ---
    // Privacy / opt-out flags. Stored as list_boolean so they render as a
    // single checkbox with a descriptive on-state label.
    array(
      'field_name' => 'field_crm_do_not_email',
      'type'       => 'list_boolean',
      'cardinality' => 1,
      'settings'   => array('allowed_values' => array(0 => '', 1 => 'Do not email')),
    ),
    array(
      'field_name' => 'field_crm_do_not_phone',
      'type'       => 'list_boolean',
      'cardinality' => 1,
      'settings'   => array('allowed_values' => array(0 => '', 1 => 'Do not phone')),
    ),
    array(
      'field_name' => 'field_crm_do_not_mail',
      'type'       => 'list_boolean',
      'cardinality' => 1,
      'settings'   => array('allowed_values' => array(0 => '', 1 => 'Do not mail (postal)')),
    ),
    array(
      'field_name' => 'field_crm_bulk_opt_out',
      'type'       => 'list_boolean',
      'cardinality' => 1,
      'settings'   => array('allowed_values' => array(0 => '', 1 => 'Bulk mail opt-out')),
    ),
    // Source / provenance — free-form campaign or origin tag (e.g.
    // "mn opera donor 02", "spcofriends19"). Kept text rather than
    // taxonomy because values are free-form and don't aggregate well.
    array(
      'field_name'  => 'field_crm_source',
      'type'        => 'text',
      'cardinality' => 1,
    ),
    // Name prefix (Mr./Mrs./Ms./Dr.). crm_person only.
    array(
      'field_name'  => 'field_crm_name_prefix',
      'type'        => 'list_text',
      'cardinality' => 1,
      'settings'    => array(
        'allowed_values' => array(
          'Mr.'  => 'Mr.',
          'Mrs.' => 'Mrs.',
          'Ms.'  => 'Ms.',
          'Dr.'  => 'Dr.',
        ),
      ),
    ),
    // Name suffix (Jr./Sr./II–VII). crm_person only.
    array(
      'field_name'  => 'field_crm_name_suffix',
      'type'        => 'list_text',
      'cardinality' => 1,
      'settings'    => array(
        'allowed_values' => array(
          'Jr.' => 'Jr.',
          'Sr.' => 'Sr.',
          'II'  => 'II',
          'III' => 'III',
          'IV'  => 'IV',
          'V'   => 'V',
          'VI'  => 'VI',
          'VII' => 'VII',
        ),
      ),
    ),
    // Birth date (date only, no time). Useful for CRM segmentation.
    array(
      'field_name'  => 'field_crm_birth_date',
      'type'        => 'datetime',
      'cardinality' => 1,
      'settings'    => array(
        'granularity' => array('year' => 'year', 'month' => 'month', 'day' => 'day'),
        'tz_handling' => 'none',
      ),
    ),
    // Gender. crm_person only. Short list to keep things simple — sites
    // that need richer options can extend via hook_form_alter.
    array(
      'field_name'  => 'field_crm_gender',
      'type'        => 'list_text',
      'cardinality' => 1,
      'settings'    => array(
        'allowed_values' => array(
          'female' => 'Female',
          'male'   => 'Male',
          'other'  => 'Other',
        ),
      ),
    ),
    // Address line 2 — "apartment 3B" line. Attaches to the address
    // bundle on crm_contact_method, same pattern as field_crm_street.
    array(
      'field_name'  => 'field_crm_street_2',
      'type'        => 'text',
      'cardinality' => 1,
    ),
    // Phone type (Phone/Mobile/Fax/Pager/Voicemail). Attaches to the
    // telephone bundle on crm_contact_method; location (Home/Work/…)
    // stays on the method's label per existing convention.
    array(
      'field_name'  => 'field_crm_phone_type',
      'type'        => 'list_text',
      'cardinality' => 1,
      'settings'    => array(
        'allowed_values' => array(
          'phone'     => 'Phone',
          'mobile'    => 'Mobile',
          'fax'       => 'Fax',
          'pager'     => 'Pager',
          'voicemail' => 'Voicemail',
        ),
      ),
    ),
  );

  foreach ($fields as $field) {
    if (!field_info_field($field['field_name'])) {
      field_create_field($field);
    }
  }

  // --- Field instances ---
  $instances = array(
    // crm_person instances.
    array(
      'field_name' => 'field_crm_first_name',
      'entity_type' => 'crm_contact',
      'bundle' => 'crm_person',
