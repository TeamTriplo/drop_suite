/**
 * Creates the field_ticket_files managed-file field and instance on
 * drop_ticket. Idempotent — safe to call from update hooks and hook_install.
 */
function _droptickets_ensure_ticket_files_field() {
  if (!field_info_field('field_ticket_files')) {
    $field = array(
      'field_name'  => 'field_ticket_files',
      'type'        => 'file',
      'cardinality' => FIELD_CARDINALITY_UNLIMITED,
      'settings'    => array(
        'uri_scheme'        => 'private',
        'display_field'     => FALSE,
        'display_default'   => FALSE,
      ),
    );
    field_create_field($field);
  }

  if (!field_info_instance('drop_ticket', 'field_ticket_files', 'drop_ticket')) {
    $instance = array(
      'field_name'  => 'field_ticket_files',
      'entity_type' => 'drop_ticket',
      'bundle'      => 'drop_ticket',
      'label'       => t('Attachments'),
      'required'    => FALSE,
      'settings'    => array(
        'file_extensions'  => 'pdf doc docx xls xlsx csv txt png jpg jpeg gif zip md',
        'file_directory'   => 'tickets',
        'max_filesize'     => '10 MB',
        'description_field' => TRUE,
      ),
      'widget'      => array(
        'type'     => 'file_generic',
        'settings' => array(
          'progress_indicator' => 'throbber',
        ),
        'weight'   => 20,
      ),
      'display'     => array(
        'default' => array(
          'label'  => 'above',
          'type'   => 'file_default',
          'weight' => 20,
        ),
      ),
    );
    field_create_instance($instance);
  }
}

/**
 * Add field_ticket_files managed-file field to drop_ticket entities.
 */
function droptickets_update_1008() {
  _droptickets_ensure_ticket_files_field();
}

