  if (!field_info_instance('drop_ticket', 'field_drop_board', 'drop_ticket')) {
    field_create_instance(array(
      'field_name'  => 'field_drop_board',
      'entity_type' => 'drop_ticket',
      'bundle'      => 'drop_ticket',
      'label'       => 'Kanban Boards',
      'required'    => FALSE,
      'description' => 'Select which Kanban board(s) this ticket appears on.',
      'widget'      => array(
        'type'   => 'options_buttons',
        'weight' => 22,
      ),
      'display' => array(
        'default' => array(
          'label'  => 'hidden',
          'type'   => 'hidden',
          'weight' => 22,
        ),
      ),
    ));
  }

  return t('Created field_drop_board field and instance on drop_ticket.');
}

