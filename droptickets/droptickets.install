/**
 * Ensure the default "General" term exists in the drop_boards vocabulary.
 */
function droptickets_update_1026() {
  $vocab = taxonomy_vocabulary_load('drop_boards');
  if (!$vocab) {
    return t('drop_boards vocabulary not found.');
  }

  // Check if a "General" term already exists.
  $existing = taxonomy_term_load_multiple(array(), array(
    'vocabulary' => 'drop_boards',
    'name' => 'General',
  ));
  if (empty($existing)) {
    $term = new TaxonomyTerm(array(
      'name'       => 'General',
      'vocabulary' => 'drop_boards',
    ));
    taxonomy_term_save($term);
    return t('Created default "General" kanban board term.');
  }

  return t('"General" term already exists.');
}

