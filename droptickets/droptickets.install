/**
 * Add drop_ticket_reaction table and reactions_enabled config.
 */
function droptickets_update_1012() {
  if (!db_table_exists('drop_ticket_reaction')) {
    db_create_table('drop_ticket_reaction', array(
      'description' => 'Emoji reactions on tickets and comments.',
      'fields' => array(
        'rid'     => array('type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE),
        'tid'     => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0),
        'tcid'    => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0),
        'uid'     => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0),
        'emoji'   => array('type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'default' => ''),
        'created' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      ),
      'primary key' => array('rid'),
      'unique keys' => array(
        'uid_entity_emoji' => array('uid', 'tid', 'tcid', 'emoji'),
      ),
      'indexes' => array(
        'tid' => array('tid'),
      ),
    ));
  }
  $config = config('droptickets.settings');
  if ($config->get('reactions_enabled') === NULL) {
    $config->set('reactions_enabled', TRUE);
    $config->save();
  }
}

function droptickets_update_1011() {
  foreach (array('drop_ticket', 'drop_task') as $entity_type) {
    $instance = field_info_instance($entity_type, 'field_drop_tags', $entity_type);
    if ($instance) {
      $instance['display']['default']['type'] = 'taxonomy_term_reference_plain';
      field_update_instance($instance);
    }
  }
}

/**
 * Add .md to the allowed file extensions for ticket attachments.
 */
function droptickets_update_1010() {
  $instance = field_info_instance('drop_ticket', 'field_ticket_files', 'drop_ticket');
  if ($instance) {
    $exts = $instance['settings']['file_extensions'];
    if (strpos($exts, 'md') === FALSE) {
      $instance['settings']['file_extensions'] = $exts . ' md';
      field_update_instance($instance);
    }
  }
}

/**
 * Attach the shared field_drop_tags field to drop_ticket entities.
 */
function droptickets_update_1009() {
  if (!field_info_instance('drop_ticket', 'field_drop_tags', 'drop_ticket')) {
    field_create_instance(array(
      'field_name'  => 'field_drop_tags',
      'entity_type' => 'drop_ticket',
      'bundle'      => 'drop_ticket',
      'label'       => 'Tags',
      'required'    => FALSE,
      'description' => 'Optional tags. Separate multiple tags with commas.',
      'widget'      => array(
        'type'     => 'taxonomy_autocomplete',
        'settings' => array('size' => 60),
        'weight'   => 21,
      ),
      'display' => array(
        'default' => array(
          'label'  => 'above',
          'type'   => 'taxonomy_term_reference_link',
          'weight' => 21,
        ),
      ),
    ));
  }
}

/**
 * Refactor drop_ticket_flag from binary (one flag per ticket) to typed
 * (multiple flag types per ticket). Adds type_tid + flagged_by columns,
 * creates the ticket_flag_types vocabulary with a Priority term, and
 * migrates every existing flag row to point at that Priority term.
 */
function droptickets_update_1028() {
  // Create the vocab + term fields + Priority seed term first so we have
  // something to migrate existing rows into.
  _droptickets_ensure_flag_types_vocabulary();

  $priority_terms = taxonomy_term_load_multiple(array(), array(
    'name'       => 'Priority',
    'vocabulary' => 'ticket_flag_types',
  ));
  $priority_term = reset($priority_terms);
  if (!$priority_term) {
    throw new BackdropUpdateException('Failed to seed Priority flag type — cannot migrate existing flag rows safely.');
  }
  $priority_tid = (int) $priority_term->tid;

  // Add type_tid column with a temporary default so existing rows are
  // populated. We then change the default to 0 (composite PK requires it).
  if (!db_field_exists('drop_ticket_flag', 'type_tid')) {
    db_add_field('drop_ticket_flag', 'type_tid', array(
      'description' => 'Foreign key to taxonomy_term_data.tid for the flag type.',
      'type'        => 'int',
      'unsigned'    => TRUE,
      'not null'    => TRUE,
      'default'     => 0,
    ));
    // Backfill existing rows with the Priority term id.
    db_update('drop_ticket_flag')
      ->fields(array('type_tid' => $priority_tid))
      ->condition('type_tid', 0)
      ->execute();
  }

  if (!db_field_exists('drop_ticket_flag', 'flagged_by')) {
    db_add_field('drop_ticket_flag', 'flagged_by', array(
      'description' => 'UID of the user who applied the flag.',
      'type'        => 'int',
      'unsigned'    => TRUE,
      'not null'    => TRUE,
      'default'     => 0,
    ));
  }

  // Recreate the primary key as composite (tid, type_tid). Wrapped in a
  // try/catch so a partial prior run can re-run without exploding — if the
  // PK is already composite, db_drop_primary_key may complain depending on
  // how far the previous attempt got.
  try {
    db_drop_primary_key('drop_ticket_flag');
  }
  catch (Exception $e) {
    // PK may not exist (partial state). Safe to continue.
  }
  try {
    db_add_primary_key('drop_ticket_flag', array('tid', 'type_tid'));
  }
  catch (Exception $e) {
    // PK may already be the composite (prior successful partial run).
  }

  // Add a secondary index on type_tid for "show me all Priority flags"
  // style queries.
  if (!db_index_exists('drop_ticket_flag', 'type_tid')) {
    db_add_index('drop_ticket_flag', 'type_tid', array('type_tid'));
  }

  $migrated = db_query('SELECT COUNT(*) FROM {drop_ticket_flag}')->fetchField();
  return t('Migrated @count existing flag row(s) to the Priority flag type.', array(
    '@count' => (int) $migrated,
  ));
}

/**
 * Rename the "General" board term to "All", remember its tid in config, and
 * set it as the default board. Existing ticket→board tag assignments are
 * untouched; only the term name and description change.
 */
function droptickets_update_1029() {
  // Find the existing General term, if any.
  $general = db_query(
    "SELECT tid FROM {taxonomy_term_data} WHERE vocabulary = :v AND LOWER(name) = 'general' LIMIT 1",
    array(':v' => 'drop_boards')
  )->fetchField();

  $all_tid = 0;
  if ($general) {
    $term = taxonomy_term_load((int) $general);
    if ($term) {
      $term->name        = 'All';
      $term->description = 'Shows every ticket, regardless of which board it is tagged with. This is the unscoped view — new boards you create filter to a subset of tickets.';
      taxonomy_term_save($term);
      $all_tid = (int) $term->tid;
    }
  }

  // If there was no General term (e.g. fresh site), create an All term.
  if (!$all_tid) {
    $existing_all = db_query(
      "SELECT tid FROM {taxonomy_term_data} WHERE vocabulary = :v AND LOWER(name) = 'all' LIMIT 1",
      array(':v' => 'drop_boards')
    )->fetchField();
    if ($existing_all) {
      $all_tid = (int) $existing_all;
    }
    else {
      $term = new TaxonomyTerm(array(
        'name'        => 'All',
        'vocabulary'  => 'drop_boards',
        'description' => 'Shows every ticket, regardless of which board it is tagged with.',
        'parent'      => array(0),
      ));
      taxonomy_term_save($term);
      $all_tid = (int) $term->tid;
    }
  }

  // Cache the tid in config and default the default-board setting to it.
  $config = config('droptickets.settings');
  $config->set('all_board_tid', $all_tid);
  if (!$config->get('default_board_tid')) {
    $config->set('default_board_tid', $all_tid);
  }
  $config->save();

  return t('Renamed the General board to All (tid @tid) and set it as the default Kanban board.', array(
    '@tid' => $all_tid,
  ));
}

/**
 * Implements hook_uninstall().
 */
function droptickets_uninstall() {
  if (db_field_exists('drop_project', 'prefix')) {
    db_drop_field('drop_project', 'prefix');
  }
  if (db_field_exists('drop_project', 'ticket_counter')) {
    db_drop_field('drop_project', 'ticket_counter');
  }
  if (db_table_exists('drop_ticket_relationship')) {
    db_drop_table('drop_ticket_relationship');
  }
  if (db_table_exists('drop_ticket_watcher')) {
    db_drop_table('drop_ticket_watcher');
  }
  if (db_table_exists('drop_notification')) {
    db_drop_table('drop_notification');
  }
  if (db_table_exists('drop_ticket_import')) {
    db_drop_table('drop_ticket_import');
  }
  if (db_table_exists('drop_ticket_flag')) {
    db_drop_table('drop_ticket_flag');
  }
}

/**
 * Add per-type soft limit field to ticket_flag_types vocabulary and remove
 * the global flag_soft_limit config setting.
 */
function droptickets_update_1030() {
  // Re-run the vocab helper which now includes the field_flag_limit field.
  _droptickets_ensure_flag_types_vocabulary();

  // Migrate the old global limit as the default for existing flag types.
  $old_limit = (int) config_get('droptickets.settings', 'flag_soft_limit');
  if ($old_limit > 0) {
    $terms = entity_load('taxonomy_term', FALSE, array('vocabulary' => 'ticket_flag_types'));
    foreach ($terms as $term) {
      if (empty($term->field_flag_limit[LANGUAGE_NONE][0]['value'])) {
        $term->field_flag_limit[LANGUAGE_NONE][0]['value'] = $old_limit;
        taxonomy_term_save($term);
      }
    }
  }

  // Remove the now-unused global setting.
  $config = config('droptickets.settings');
  $config->clear('flag_soft_limit');
  $config->save();
}

/**
 * Add active_since column and age-badge config defaults (tid 550).
 *
 * Back-fills active_since = changed for tickets currently in a counting status
 * so the badge has something reasonable to show on existing data.
 */
function droptickets_update_1031() {
  if (!db_field_exists('drop_ticket', 'active_since')) {
    db_add_field('drop_ticket', 'active_since', array(
      'type'     => 'int',
      'unsigned' => TRUE,
      'not null' => FALSE,
      'default'  => NULL,
      'description' => 'Unix timestamp when the ticket entered a counting status.',
    ));
  }

  $config = config('droptickets.statuses');
  if ($config->get('age_badge_threshold_days') === NULL) {
    $config->set('age_badge_threshold_days', 3);
  }
  // Default: first non-inactive status after backlog (todo in the shipped set).
  $statuses = $config->get('statuses');
  if ($config->get('age_badge_active_start') === NULL && isset($statuses['todo'])) {
    $config->set('age_badge_active_start', 'todo');
  }
  if ($config->get('age_badge_done_cutoff') === NULL && isset($statuses['done'])) {
    $config->set('age_badge_done_cutoff', 'done');
  }
  $config->save();

  // Back-fill active_since = changed for tickets currently in counting range.
  $start = $config->get('age_badge_active_start');
  $cutoff = $config->get('age_badge_done_cutoff');
  if ($start && $cutoff && !empty($statuses[$start]['weight']) !== NULL && !empty($statuses[$cutoff]['weight']) !== NULL) {
    $start_w = isset($statuses[$start]['weight']) ? (int) $statuses[$start]['weight'] : 0;
    $cutoff_w = isset($statuses[$cutoff]['weight']) ? (int) $statuses[$cutoff]['weight'] : 999;
    $counting = array();
    foreach ($statuses as $key => $info) {
      $w = isset($info['weight']) ? (int) $info['weight'] : 0;
      if ($w >= $start_w && $w < $cutoff_w) { $counting[] = $key; }
    }
    if ($counting) {
      db_update('drop_ticket')
        ->expression('active_since', 'changed')
        ->condition('status', $counting, 'IN')
        ->isNull('active_since')
        ->execute();
    }
  }
}

/**
 * Re-grant team_member permissions that silently failed on fresh installs (tid 564).
 *
 * droptickets_install() passed $role->rid to user_role_grant_permissions(),
 * which takes a role machine name — the grant no-op'd without error. Result:
 * team_member role existed but had no permissions, so assignee/watcher
 * dropdowns only showed admin. Idempotent.
 *
 * NOTE: This first version had a second bug — if any permission in the list
 * was undefined (module not enabled), Backdrop silently drops the whole list,
 * including the valid ones. Superseded by droptickets_update_1033 which
 * filters to defined permissions before granting. This hook is left in place
 * so schema bookkeeping stays monotonic on sites that already ran it.
 */
function droptickets_update_1032() {
  if (!user_role_load_by_name('team_member')) {
    return;
  }
  user_role_grant_permissions('team_member', array(
    'access droptickets',
    'access droptasks',
    'access droptime',
    'access dropbridge',
  ));
}

/**
 * Re-grant team_member permissions with defined-permission filter (tid 564).
 *
 * Supersedes update 1032. `user_role_grant_permissions()` silently drops the
 * entire list if any permission in it is undefined by an enabled module, so
 * on a site with only droptickets enabled (not droptasks/droptime/dropbridge)
 * the 1032 grant produced zero permissions. Filter to currently-defined
 * permissions and grant only those.
 */
function droptickets_update_1033() {
  if (!user_role_load_by_name('team_member')) {
    return;
  }
  $wanted = array(
    'access droptickets',
    'access droptasks',
    'access droptime',
    'access dropbridge',
  );
  $defined = array_keys(user_permission_get_modules());
  $permissions = array_values(array_intersect($wanted, $defined));
  if ($permissions) {
    user_role_grant_permissions('team_member', $permissions);
  }
}
