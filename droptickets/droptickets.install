/**
 * Add drop_ticket_event table for activity log.
 */
function droptickets_update_1023() {
  if (!db_table_exists('drop_ticket_event')) {
    db_create_table('drop_ticket_event', array(
      'description' => 'Activity log for ticket events (status changes, assignments, etc.).',
      'fields' => array(
        'eid' => array(
          'type'     => 'serial',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ),
        'tid' => array(
          'type'     => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'default'  => 0,
        ),
        'uid' => array(
          'type'     => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'default'  => 0,
        ),
        'message' => array(
          'type'     => 'varchar',
          'length'   => 512,
          'not null' => TRUE,
          'default'  => '',
        ),
        'created' => array(
          'type'     => 'int',
          'not null' => TRUE,
          'default'  => 0,
        ),
      ),
      'primary key' => array('eid'),
      'indexes' => array(
        'tid' => array('tid'),
      ),
    ));
  }
}

/**
 * Ensures the shared drop_tags vocabulary, field base, and drop_ticket
 * field instance all exist. Safe to call on fresh installs and updates.
 */
function _droptickets_ensure_tags_field() {
  // Vocabulary.
  $vocab = taxonomy_vocabulary_machine_name_load('drop_tags');
  if (!$vocab) {
    $vocab = new TaxonomyVocabulary(array(
      'name'         => 'Drop Tags',
      'machine_name' => 'drop_tags',
      'description'  => 'Shared tags used across Drop Suite entities.',
    ));
    taxonomy_vocabulary_save($vocab);
  }

  // Base field (shared with droptasks, dropcrm, etc.).
  if (!field_info_field('field_drop_tags')) {
    field_create_field(array(
      'field_name'  => 'field_drop_tags',
      'type'        => 'taxonomy_term_reference',
      'settings'    => array(
        'allowed_values' => array(
          array('vocabulary' => 'drop_tags', 'parent' => 0),
        ),
      ),
      'cardinality' => FIELD_CARDINALITY_UNLIMITED,
    ));
  }

  // Instance on drop_ticket.
  if (!field_info_instance('drop_ticket', 'field_drop_tags', 'drop_ticket')) {
    field_create_instance(array(
      'field_name'  => 'field_drop_tags',
      'entity_type' => 'drop_ticket',
      'bundle'      => 'drop_ticket',
      'label'       => 'Tags',
      'required'    => FALSE,
      'description' => 'Optional tags. Separate multiple tags with commas.',
      'widget'      => array(
        'type'     => 'taxonomy_autocomplete',
        'settings' => array('size' => 60),
        'weight'   => 21,
      ),
      'display' => array(
        'default' => array(
          'label'  => 'above',
          'type'   => 'taxonomy_term_reference_plain',
          'weight' => 21,
        ),
      ),
    ));
  }
}

/**
 * Creates the drop_boards vocabulary, default "General" term, and
 * field_drop_board field + instance on drop_ticket if they don't exist.
 */
function _droptickets_ensure_boards_field() {
  if (!taxonomy_vocabulary_load('drop_boards')) {
    $vocab = new TaxonomyVocabulary(array(
      'machine_name' => 'drop_boards',
      'name'         => 'Kanban Boards',
      'description'  => 'Defines which Kanban board(s) a ticket appears on.',
    ));
    taxonomy_vocabulary_save($vocab);

    // Seed the special "All" board — the unscoped view that shows every
    // ticket. Its tid is cached in droptickets.settings.all_board_tid so the
    // kanban page can recognize it without name matching.
    $term = new TaxonomyTerm(array(
      'name'        => 'All',
      'vocabulary'  => 'drop_boards',
      'description' => 'Shows every ticket, regardless of which board it is tagged with.',
      'parent'      => array(0),
    ));
    taxonomy_term_save($term);

    $config = config('droptickets.settings');
    $config->set('all_board_tid', (int) $term->tid);
    if (!$config->get('default_board_tid')) {
      $config->set('default_board_tid', (int) $term->tid);
    }
    $config->save();
  }

  if (!field_info_field('field_drop_board')) {
    field_create_field(array(
      'field_name'  => 'field_drop_board',
      'type'        => 'taxonomy_term_reference',
      'settings'    => array(
        'allowed_values' => array(
          array('vocabulary' => 'drop_boards', 'parent' => 0),
        ),
      ),
      'cardinality' => FIELD_CARDINALITY_UNLIMITED,
    ));
  }

  if (!field_info_instance('drop_ticket', 'field_drop_board', 'drop_ticket')) {
    field_create_instance(array(
      'field_name'  => 'field_drop_board',
      'entity_type' => 'drop_ticket',
      'bundle'      => 'drop_ticket',
      'label'       => 'Kanban Boards',
      'required'    => FALSE,
      'description' => 'Select which Kanban board(s) this ticket appears on. Leave empty to show on the General board by default.',
      'widget'      => array(
        'type'   => 'options_buttons',
        'weight' => 22,
      ),
      'display' => array(
        'default' => array(
          'label'  => 'hidden',
          'type'   => 'hidden',
          'weight' => 22,
        ),
      ),
    ));
  }
}

/**
 * Creates the ticket_flag_types vocabulary, attaches color/icon fields to its
 * terms, and seeds a default Priority term. Site Architects can add new flag
 * types from the standard taxonomy admin without touching code — flag types
 * are taxonomy terms, plain and simple.
 *
 * Two term-level fields are attached:
 * - field_flag_color (colorfield) — hex color for the chip background
 * - field_flag_icon  (text)       — optional Phosphor icon name (e.g.
 *                                   "warning", "star", "lock") rendered
 *                                   inside the chip
 *
 * Requires the colorfield contrib module — declared as a dependency in
 * droptickets.info so fresh installs pull it in automatically.
 */
function _droptickets_ensure_flag_types_vocabulary() {
  // 1. Vocabulary.
  if (!taxonomy_vocabulary_load('ticket_flag_types')) {
    $vocab = new TaxonomyVocabulary(array(
      'machine_name' => 'ticket_flag_types',
      'name'         => 'Ticket Flag Types',
      'description'  => 'Flag types that can be applied to tickets. Each term defines a flag — its name, color, and optional icon. Add or remove terms to customize available flags.',
    ));
    taxonomy_vocabulary_save($vocab);
  }

  // 2. Color field on terms.
  if (!field_info_field('field_flag_color')) {
    field_create_field(array(
      'field_name'  => 'field_flag_color',
      'type'        => 'colorfield',
      'cardinality' => 1,
    ));
  }
  if (!field_info_instance('taxonomy_term', 'field_flag_color', 'ticket_flag_types')) {
    field_create_instance(array(
      'field_name'  => 'field_flag_color',
      'entity_type' => 'taxonomy_term',
      'bundle'      => 'ticket_flag_types',
      'label'       => 'Chip color',
      'required'    => FALSE,
      'description' => 'Hex color used as the background of the chip. Defaults to neutral grey if blank.',
      'widget'      => array('type' => 'colorfield_widget', 'weight' => 5),
      'display'     => array('default' => array('type' => 'hidden')),
    ));
  }

  // 3. Icon field on terms (Phosphor icon name, optional).
  if (!field_info_field('field_flag_icon')) {
    field_create_field(array(
      'field_name'  => 'field_flag_icon',
      'type'        => 'text',
      'cardinality' => 1,
      'settings'    => array('max_length' => 64),
    ));
  }
  if (!field_info_instance('taxonomy_term', 'field_flag_icon', 'ticket_flag_types')) {
    field_create_instance(array(
      'field_name'  => 'field_flag_icon',
      'entity_type' => 'taxonomy_term',
      'bundle'      => 'ticket_flag_types',
      'label'       => 'Icon',
      'required'    => FALSE,
      'description' => 'Optional Phosphor icon name (e.g. "star", "warning", "lock"). Leave blank for a chip with no icon.',
      'widget'      => array('type' => 'text_textfield', 'weight' => 6),
      'display'     => array('default' => array('type' => 'hidden')),
    ));
  }

  // 4. Soft-limit field on terms (integer, optional).
  if (!field_info_field('field_flag_limit')) {
    field_create_field(array(
      'field_name'  => 'field_flag_limit',
      'type'        => 'number_integer',
      'cardinality' => 1,
    ));
  }
  if (!field_info_instance('taxonomy_term', 'field_flag_limit', 'ticket_flag_types')) {
    field_create_instance(array(
      'field_name'  => 'field_flag_limit',
      'entity_type' => 'taxonomy_term',
      'bundle'      => 'ticket_flag_types',
      'label'       => 'Soft limit',
      'required'    => FALSE,
      'description' => 'Warn when flagged tickets of this type exceed this number. Leave blank or 0 for no limit.',
      'widget'      => array('type' => 'number', 'weight' => 7),
      'display'     => array('default' => array('type' => 'hidden')),
    ));
  }

  // 5. Seed a default Priority term so existing flag rows have something to
  // migrate to. Site Architects can rename or delete it later.
  $existing = taxonomy_term_load_multiple(array(), array(
    'name'       => 'Priority',
    'vocabulary' => 'ticket_flag_types',
  ));
  if (empty($existing)) {
    $term = new TaxonomyTerm(array(
      'name'        => 'Priority',
      'vocabulary'  => 'ticket_flag_types',
      'description' => 'Tickets the team should focus on first.',
      // parent => array(0) is REQUIRED — without it the term is invisible
      // in the term overview admin page (taxonomy_term_save does not insert
      // a hierarchy row otherwise).
      'parent'      => array(0),
    ));
    // Set the colorfield value on the term object before saving so it
    // persists as a field item.
    $term->field_flag_color[LANGUAGE_NONE][0]['value'] = '#dc3545';
    $term->field_flag_icon[LANGUAGE_NONE][0]['value']  = 'star';
    taxonomy_term_save($term);
  }
}

/**
 * Implements hook_install().
 *
 * Adds prefix and ticket_counter columns to drop_project, and creates the
 * Team Member role.
 */
function droptickets_install() {
  // Add prefix column to drop_project (may already exist if dropcrm installed).
  if (!db_field_exists('drop_project', 'prefix')) {
    db_add_field('drop_project', 'prefix', array(
      'description' => 'Short prefix for ticket numbers, e.g. TRIP for TRIP-42.',
      'type'        => 'varchar',
      'length'      => 10,
      'not null'    => FALSE,
      'default'     => NULL,
    ));
  }

  // Add ticket_counter column to drop_project.
  if (!db_field_exists('drop_project', 'ticket_counter')) {
    db_add_field('drop_project', 'ticket_counter', array(
      'description' => 'Last ticket number issued for this project.',
      'type'        => 'int',
      'unsigned'    => TRUE,
      'not null'    => TRUE,
      'default'     => 0,
    ));
  }

  // Ensure the shared drop_tags vocabulary and field_drop_tags field exist,
  // then attach the field to drop_ticket entities.
  _droptickets_ensure_tags_field();

  // Create the Kanban boards vocabulary, default "General" term, and field.
  _droptickets_ensure_boards_field();

  // Create the ticket_flag_types vocabulary, the color/icon term fields,
  // and seed a Priority term.
  _droptickets_ensure_flag_types_vocabulary();

  // Create the private attachments field on drop_ticket so fresh installs
  // have it without waiting for update 1008.
  _droptickets_ensure_ticket_files_field();

  // Create the Team Member role if it doesn't already exist.
  $role = user_role_load_by_name('team_member');
  if (!$role) {
    $role = new stdClass();
    $role->name   = 'team_member';
    $role->label  = 'Team Member';
    $role->weight = 3;
    user_role_save($role);
    $role = user_role_load_by_name('team_member');
  }

  // Grant permissions to the Team Member role.
  // Two gotchas:
  //  1. user_role_grant_permissions() takes a role machine name, not a rid —
  //     Backdrop 1.x roles are identified by name. Passing rid silently no-ops.
  //  2. If ANY permission in the list is undefined (i.e. the providing module
  //     isn't enabled), the entire grant silently drops — including the valid
  //     ones. Filter to defined permissions before calling.
  if ($role) {
    $wanted = array(
      'access droptickets',
      'access droptasks',
      'access droptime',
      'access dropbridge',
    );
    $defined = array_keys(user_permission_get_modules());
    $permissions = array_values(array_intersect($wanted, $defined));
    if ($permissions) {
      user_role_grant_permissions($role->name, $permissions);
    }
  }

  drop_base_grant_admin_permissions('droptickets');

  // Seed age-badge defaults so fresh installs match what update 1031 does.
  $config = config('droptickets.statuses');
  if ($config->get('age_badge_threshold_days') === NULL) {
    $config->set('age_badge_threshold_days', 3);
  }
  $statuses = $config->get('statuses');
  if ($config->get('age_badge_active_start') === NULL && isset($statuses['todo'])) {
    $config->set('age_badge_active_start', 'todo');
  }
  if ($config->get('age_badge_done_cutoff') === NULL && isset($statuses['done'])) {
    $config->set('age_badge_done_cutoff', 'done');
  }
  $config->save();
}

/**
 * Add drop_ticket_relationship table for related tickets.
 */
function droptickets_update_1002() {
  if (!db_table_exists('drop_ticket_relationship')) {
    $schema = array(
      'description' => 'Relationships between tickets.',
      'fields' => array(
        'trid' => array(
          'type'     => 'serial',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ),
        'tid_a' => array(
          'type'     => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ),
        'tid_b' => array(
          'type'     => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ),
        'type' => array(
          'type'     => 'varchar',
          'length'   => 20,
          'not null' => TRUE,
          'default'  => 'relates_to',
        ),
      ),
      'primary key' => array('trid'),
      'unique keys' => array(
        'pair' => array('tid_a', 'tid_b'),
      ),
      'indexes' => array(
        'tid_a' => array('tid_a'),
        'tid_b' => array('tid_b'),
      ),
    );
    db_create_table('drop_ticket_relationship', $schema);
  }
}

