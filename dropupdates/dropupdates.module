// ---------------------------------------------------------------------------
// Helpers: team members, seen/reactions, unread, reactions palette
// ---------------------------------------------------------------------------

/**
 * Returns the canonical reaction emoji palette.
 *
 * @deprecated Use drop_base_reaction_emojis() directly. Kept as a thin
 *   forwarder for any external callers.
 * @return array
 */
function dropupdates_reaction_emojis() {
  return drop_base_reaction_emojis();
}

/**
 * Returns an array of uid => name for all team members.
 *
 * "Team member" is anyone with the 'team_member' role, plus admins
 * (who implicitly have team member access). Used to filter the seen-by list
 * and the unread badge so clients never count.
 *
 * @return array
 *   Keyed by uid, values are user names.
 */
function dropupdates_team_members() {
  $members = &backdrop_static(__FUNCTION__);
  if (isset($members)) {
    return $members;
  }

  $role_names = array();
  foreach (array('admin', 'administrator', 'team_member') as $rn) {
    if (user_role_load($rn)) {
      $role_names[] = $rn;
    }
  }

  if (empty($role_names)) {
    $members = array();
    return $members;
  }

  $result = db_query(
    "SELECT DISTINCT u.uid, u.name
     FROM {users} u
     INNER JOIN {users_roles} ur ON ur.uid = u.uid
     WHERE ur.role IN (:roles) AND u.status = 1",
    array(':roles' => $role_names)
  );

  $members = array();
  foreach ($result as $row) {
    $members[$row->uid] = $row->name;
  }
  return $members;
}

/**
 * Returns the count of unread updates for the given user.
 *
 * Counts posts authored by *other* team members that the given user has not
 * yet marked seen. A user's own posts never count as unread for that user.
 * Cached for the duration of a request via backdrop_static().
 *
 * @param int|null $uid
 *   The user to check. Defaults to the current user.
 *
 * @return int
 */
function dropupdates_unread_count($uid = NULL) {
  global $user;
  if ($uid === NULL) {
    $uid = $user->uid;
  }
  if (!$uid) {
    return 0;
  }

  $cache = &backdrop_static(__FUNCTION__, array());
  if (isset($cache[$uid])) {
    return $cache[$uid];
  }

  $team = dropupdates_team_members();
  if (empty($team) || !isset($team[$uid])) {
    // Non-team viewers never see the badge.
    $cache[$uid] = 0;
    return 0;
  }

  $query = db_select('drop_update', 'u');
  $query->leftJoin(
    'drop_update_view',
    'v',
    'v.uid_post = u.uid_post AND v.uid = :viewer',
    array(':viewer' => $uid)
  );
  $query->condition('u.uid', $uid, '<>');
  $query->condition('u.uid', array_keys($team), 'IN');
  $query->isNull('v.uid_post');
  $count = (int) $query->countQuery()->execute()->fetchField();

  $cache[$uid] = $count;
  return $count;
}

/**
 * Returns the viewer UIDs that have seen the given update, team-only.
 *
 * @param int $uid_post
 *
 * @return array
 *   Array of uids (team members only), ordered by viewed_at ASC.
 */
function dropupdates_update_viewers($uid_post) {
  $team = dropupdates_team_members();
  if (empty($team)) {
    return array();
  }
  $result = db_select('drop_update_view', 'v')
    ->fields('v', array('uid', 'viewed_at'))
    ->condition('v.uid_post', $uid_post)
    ->condition('v.uid', array_keys($team), 'IN')
    ->orderBy('v.viewed_at', 'ASC')
    ->execute();
  $uids = array();
  foreach ($result as $row) {
    $uids[$row->uid] = $row->viewed_at;
  }
  return $uids;
}

/**
 * Returns aggregated reaction counts and the current user's reactions.
 *
 * @param int $uid_post
 * @param int|null $viewer_uid
 *
 * @return array
 *   array('counts' => array(emoji => count), 'mine' => array(emoji => TRUE))
 */
/**
 * Returns the raw reaction state for one update.
 *
 * @param int $uid_post
 * @return array
 *   Keyed by emoji code, each value an array of uids that reacted with it.
 *   Every palette code is present (possibly empty) for rendering consistency.
 */
function dropupdates_update_reactions($uid_post) {
  $reactions = array_fill_keys(array_keys(drop_base_reaction_emojis()), array());
  $rows = db_select('drop_update_reaction', 'r')
    ->fields('r', array('uid', 'emoji'))
    ->condition('r.uid_post', $uid_post)
    ->execute();
  foreach ($rows as $row) {
    if (isset($reactions[$row->emoji])) {
      $reactions[$row->emoji][] = (int) $row->uid;
    }
  }
  return $reactions;
}

/**
 * Bulk-loads raw reaction state for a list of updates.
 *
 * @param array $uid_posts
 * @return array
 *   uid_post => (code => array(uid, ...))
 */
function dropupdates_update_reactions_multiple(array $uid_posts) {
  $out = array();
  if (empty($uid_posts)) {
    return $out;
  }
  $empty = array_fill_keys(array_keys(drop_base_reaction_emojis()), array());
  foreach ($uid_posts as $id) {
    $out[(int) $id] = $empty;
  }
  $rows = db_select('drop_update_reaction', 'r')
    ->fields('r', array('uid_post', 'uid', 'emoji'))
    ->condition('r.uid_post', $uid_posts, 'IN')
    ->execute();
  foreach ($rows as $row) {
    $uid_post = (int) $row->uid_post;
    if (isset($out[$uid_post][$row->emoji])) {
      $out[$uid_post][$row->emoji][] = (int) $row->uid;
    }
  }
  return $out;
}

// ---------------------------------------------------------------------------
// Entity insert: Slack relay
// ---------------------------------------------------------------------------

/**
 * Implements hook_entity_insert().
 *
 * When a new update is saved, optionally cross-post a preview to a Slack
 * channel configured in dropupdates settings.
 */
function dropupdates_entity_insert($entity, $type) {
  if ($type !== 'drop_update') {
    return;
  }
  $channel = config_get('dropupdates.settings', 'slack_channel');
  if (empty($channel)) {
    return;
  }
  if (!function_exists('dropbridge_post_channel')) {
    return;
  }

  $author = user_load($entity->uid);
  $author_name = $author ? format_username($author) : t('Someone');
  $preview = _dropupdates_slack_preview($entity);
  $link = url('drop/updates', array('absolute' => TRUE, 'fragment' => 'u-' . $entity->uid_post));

  $message = t('*@name* posted a team update:', array('@name' => $author_name))
    . "\n\n> " . $preview
    . "\n\n<" . $link . '|' . t('Read more →') . '>';

  dropbridge_post_channel($channel, $message);
}

/**
 * Returns a one-line preview of an update body for Slack.
 */
function _dropupdates_slack_preview($update) {
  $plain = trim(strip_tags($update->body));
  // Collapse whitespace.
  $plain = preg_replace('/\s+/', ' ', $plain);
  if (backdrop_strlen($plain) > 180) {
    $plain = backdrop_substr($plain, 0, 180) . '…';
  }
  return $plain;
}
