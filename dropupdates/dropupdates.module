  $items = array();

  $items['drop/updates'] = array(
    'title'            => 'Updates',
    'page callback'    => 'dropupdates_feed_page',
    'access callback'  => 'user_access',
    'access arguments' => array('view drop updates'),
    'file'             => 'dropupdates.pages.inc',
    'type'             => MENU_NORMAL_ITEM,
  );

  $items['drop/updates/add'] = array(
    'title'            => 'Post update',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('dropupdates_post_form'),
    'access callback'  => 'user_access',
    'access arguments' => array('post drop updates'),
    'file'             => 'dropupdates.pages.inc',
    'type'             => MENU_CALLBACK,
  );

  $items['drop/updates/%drop_update/edit'] = array(
    'title'            => 'Edit update',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('dropupdates_post_form', 2),
    'access callback'  => 'dropupdates_update_access',
    'access arguments' => array('update', 2),
    'file'             => 'dropupdates.pages.inc',
    'type'             => MENU_CALLBACK,
  );

  $items['drop/updates/%drop_update/delete'] = array(
    'title'            => 'Delete update',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('dropupdates_delete_confirm', 2),
    'access callback'  => 'dropupdates_update_access',
    'access arguments' => array('delete', 2),
    'file'             => 'dropupdates.pages.inc',
    'type'             => MENU_CALLBACK,
  );

  // AJAX: mark update as seen.
  $items['drop/updates/seen/%drop_update'] = array(
    'page callback'    => 'dropupdates_seen_ajax',
    'page arguments'   => array(3),
    'access callback'  => 'user_access',
    'access arguments' => array('view drop updates'),
    'file'             => 'dropupdates.pages.inc',
    'type'             => MENU_CALLBACK,
    'delivery callback' => 'backdrop_json_deliver',
  );

  // AJAX: toggle a reaction. Emoji is supplied via POST body.
  $items['drop/updates/react/%drop_update'] = array(
    'page callback'    => 'dropupdates_react_ajax',
    'page arguments'   => array(3),
    'access callback'  => 'user_access',
    'access arguments' => array('view drop updates'),
    'file'             => 'dropupdates.pages.inc',
    'type'             => MENU_CALLBACK,
    'delivery callback' => 'backdrop_json_deliver',
  );

  // Settings.
  $items['drop/settings/updates'] = array(
    'title'            => 'Drop Updates',
    'description'      => 'Slack relay and feed settings.',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('dropupdates_settings_form'),
    'access callback'  => 'user_access',
    'access arguments' => array('administer drop updates'),
    'file'             => 'dropupdates.admin.inc',
    'type'             => MENU_CALLBACK,
  );

  return $items;
}

