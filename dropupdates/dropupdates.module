// ---------------------------------------------------------------------------
// Access
// ---------------------------------------------------------------------------

/**
 * Access callback for drop_update entities.
 *
 * @param string $op
 *   One of 'view', 'create', 'update', 'delete'.
 * @param DropUpdate|null $update
 *   The update entity, or NULL for create checks.
 * @param object|null $account
 *   The user account, or NULL for the current user.
 *
 * @return bool
 */
function dropupdates_update_access($op, $update = NULL, $account = NULL) {
  global $user;
  if (!$account) {
    $account = $user;
  }

  if (user_access('administer drop updates', $account)) {
    return TRUE;
  }

  switch ($op) {
    case 'view':
      return user_access('view drop updates', $account);

    case 'create':
      return user_access('post drop updates', $account);

    case 'update':
      return $update
        && $update->uid == $account->uid
        && user_access('edit own drop updates', $account);

    case 'delete':
      return $update
        && $update->uid == $account->uid
        && user_access('delete own drop updates', $account);
  }

  return FALSE;
}

// ---------------------------------------------------------------------------
// Menu loader
// ---------------------------------------------------------------------------

/**
 * Menu loader: load a drop_update by ID.
 */
function drop_update_load($uid_post) {
  $updates = entity_load('drop_update', array($uid_post));
  return $updates ? reset($updates) : FALSE;
}

