<?php
/**
 * @file
 * Install, schema, and update functions for DropUpdates.
 */

/**
 * Implements hook_schema().
 */
function dropupdates_schema() {
  $schema = array();

  $schema['drop_update'] = array(
    'description' => 'Team update posts.',
    'fields' => array(
      'uid_post' => array(
        'description' => 'Primary key: update ID.',
        'type'        => 'serial',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
      ),
      'uid' => array(
        'description' => 'The {users}.uid of the author.',
        'type'        => 'int',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
        'default'     => 0,
      ),
      'body' => array(
        'description' => 'The update body.',
        'type'        => 'text',
        'size'        => 'big',
        'not null'    => FALSE,
      ),
      'body_format' => array(
        'description' => 'Text format used for body.',
        'type'        => 'varchar',
        'length'      => 64,
        'not null'    => TRUE,
        'default'     => 'filtered_html',
      ),
      'created' => array(
        'description' => 'Unix timestamp the update was posted.',
        'type'        => 'int',
        'not null'    => TRUE,
        'default'     => 0,
      ),
      'changed' => array(
        'description' => 'Unix timestamp the update was last modified.',
        'type'        => 'int',
        'not null'    => TRUE,
        'default'     => 0,
      ),
    ),
    'primary key' => array('uid_post'),
    'indexes' => array(
      'uid'     => array('uid'),
      'created' => array('created'),
    ),
  );

  $schema['drop_update_view'] = array(
    'description' => 'Records which users have seen which updates.',
    'fields' => array(
      'uid_post' => array(
        'description' => 'The {drop_update}.uid_post.',
        'type'        => 'int',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
        'default'     => 0,
      ),
      'uid' => array(
        'description' => 'The {users}.uid of the viewer.',
        'type'        => 'int',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
        'default'     => 0,
      ),
      'viewed_at' => array(
        'description' => 'Unix timestamp when the viewer first saw the update.',
        'type'        => 'int',
        'not null'    => TRUE,
        'default'     => 0,
      ),
    ),
    'primary key' => array('uid_post', 'uid'),
    'indexes' => array(
      'uid' => array('uid'),
    ),
  );

  $schema['drop_update_reaction'] = array(
    'description' => 'Emoji reactions on updates.',
    'fields' => array(
      'uid_post' => array(
        'description' => 'The {drop_update}.uid_post.',
        'type'        => 'int',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
        'default'     => 0,
      ),
      'uid' => array(
        'description' => 'The {users}.uid of the reactor.',
        'type'        => 'int',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
        'default'     => 0,
      ),
      'emoji' => array(
        'description' => 'Emoji code (e.g. thumbsup, heart, tada, eyes).',
        'type'        => 'varchar',
        'length'      => 32,
        'not null'    => TRUE,
        'default'     => '',
      ),
      'created' => array(
        'description' => 'Unix timestamp the reaction was added.',
        'type'        => 'int',
        'not null'    => TRUE,
        'default'     => 0,
      ),
    ),
    'primary key' => array('uid_post', 'uid', 'emoji'),
    'indexes' => array(
      'uid_post' => array('uid_post'),
    ),
  );

  return $schema;
}

/**
 * Implements hook_install().
 *
 * Grants default permissions to the admin, administrator, and team_member
 * roles on fresh install so a newly enabled module is usable without a
 * manual visit to the permissions page.
 */
function dropupdates_install() {
  _dropupdates_grant_default_permissions();
}

/**
 * Grants default dropupdates permissions to common team roles.
 *
 * Shared between hook_install() and any future update hook so both fresh
 * installs and upgrades land in the same state.
 */
function _dropupdates_grant_default_permissions() {
  drop_base_grant_admin_permissions('dropupdates');

  if (user_role_load('team_member')) {
    user_role_grant_permissions('team_member', array(
      'view drop updates',
      'post drop updates',
      'edit own drop updates',
      'delete own drop updates',
    ));
  }
}
