<?php
/**
 * @file
 * Install, update, and uninstall functions for the DropFiles module.
 */

/**
 * Implements hook_schema().
 */
function dropfiles_schema() {
  // The dropfiles_tags join table was removed in update 1100 in favor of the
  // Field API field_file_tags taxonomy reference field.
  return array();
}

/**
 * Implements hook_install().
 */
function dropfiles_install() {
  // Create the file_tags taxonomy vocabulary if it doesn't exist.
  $existing = taxonomy_vocabulary_load('file_tags');
  if (!$existing) {
    $vocab = new TaxonomyVocabulary(array(
      'machine_name' => 'file_tags',
      'name' => t('File Tags'),
      'description' => t('Tags for categorizing shared files in the library.'),
    ));
    taxonomy_vocabulary_save($vocab);
  }

  // Create the field_file_tags taxonomy reference field and instances.
  _dropfiles_ensure_file_tags_field();

  drop_base_grant_admin_permissions('dropfiles');
}

/**
 * Create the field_file_tags field and attach to document/image file types.
 *
 * Safe to call multiple times; skips creation if field/instances exist.
 */
function _dropfiles_ensure_file_tags_field() {
  // Create the field if it doesn't exist yet.
  if (!field_info_field('field_file_tags')) {
    $field = array(
      'field_name' => 'field_file_tags',
      'type' => 'taxonomy_term_reference',
      'cardinality' => -1,
      'settings' => array(
        'allowed_values' => array(
          array(
            'vocabulary' => 'file_tags',
            'parent' => 0,
          ),
        ),
      ),
    );
    field_create_field($field);
  }

  // Attach instances to document and image file types.
  $bundles = array('document', 'image');
  foreach ($bundles as $bundle) {
    if (!field_info_instance('file', 'field_file_tags', $bundle)) {
      $instance = array(
        'field_name' => 'field_file_tags',
        'entity_type' => 'file',
        'bundle' => $bundle,
        'label' => t('Tags'),
        'widget' => array(
          'type' => 'taxonomy_autocomplete',
        ),
      );
      field_create_instance($instance);
    }
  }
}

/**
 * Add .md to allowed file extensions.
 */
function dropfiles_update_1000() {
  $config = config('dropfiles.settings');
  $extensions = $config->get('allowed_extensions');
  if (strpos($extensions, ' md ') === FALSE && !preg_match('/ md$/', $extensions)) {
    $config->set('allowed_extensions', $extensions . ' md');
    $config->save();
  }
}

/**
 * Migrate file tags from custom join table to Field API taxonomy reference.
 */
function dropfiles_update_1100() {
  // Ensure the file_tags vocabulary exists.
  $existing = taxonomy_vocabulary_load('file_tags');
  if (!$existing) {
    $vocab = new TaxonomyVocabulary(array(
      'machine_name' => 'file_tags',
      'name' => t('File Tags'),
      'description' => t('Tags for categorizing shared files in the library.'),
    ));
    taxonomy_vocabulary_save($vocab);
  }

  // Create the field and instances.
  _dropfiles_ensure_file_tags_field();

  // Migrate data from the old dropfiles_tags table.
  if (db_table_exists('dropfiles_tags')) {
    $rows = db_select('dropfiles_tags', 'dt')
      ->fields('dt', array('fid', 'tid'))
      ->execute()
      ->fetchAll();

    // Group tids by fid for efficient processing.
    $files_tags = array();
    foreach ($rows as $row) {
      $files_tags[$row->fid][] = $row->tid;
    }

    foreach ($files_tags as $fid => $tids) {
      $file = file_load($fid);
      if (!$file) {
        continue;
      }
      $file->field_file_tags[LANGUAGE_NONE] = array();
      foreach ($tids as $tid) {
        $file->field_file_tags[LANGUAGE_NONE][] = array('tid' => $tid);
      }
      file_save($file);
    }

    // Drop the old table.
    db_drop_table('dropfiles_tags');
  }
}

/**
 * Implements hook_requirements().
 */
function dropfiles_requirements($phase) {
  $requirements = array();

  if ($phase === 'runtime') {
    // Check for ImageMagick (used for PDF thumbnail generation).
    // shell_exec() returns NULL when the binary is not found — coerce to
    // string so trim() doesn't trigger a PHP 8.1+ deprecation notice.
    $convert = trim((string) shell_exec('which magick 2>/dev/null'));
    if (empty($convert)) {
      $convert = trim((string) shell_exec('which convert 2>/dev/null'));
    }
    $has_imagemagick = !empty($convert);

    // Check for Ghostscript (required by ImageMagick for PDF rendering).
    $gs = trim((string) shell_exec('which gs 2>/dev/null'));
    $has_gs = !empty($gs);

    if ($has_imagemagick && $has_gs) {
      // Test an actual PDF-to-PNG conversion to catch security policy blocks.
      $test_pdf = tempnam(sys_get_temp_dir(), 'dropfiles_test_') . '.pdf';
      $test_png = tempnam(sys_get_temp_dir(), 'dropfiles_test_') . '.png';
      // Minimal valid PDF.
      file_put_contents($test_pdf, "%PDF-1.4\n1 0 obj<</Type/Catalog/Pages 2 0 R>>endobj\n2 0 obj<</Type/Pages/Kids[3 0 R]/Count 1>>endobj\n3 0 obj<</Type/Page/MediaBox[0 0 612 792]/Parent 2 0 R/Resources<<>>>>endobj\nxref\n0 4\n0000000000 65535 f \n0000000009 00000 n \n0000000058 00000 n \n0000000115 00000 n \ntrailer<</Size 4/Root 1 0 R>>\nstartxref\n206\n%%EOF");
      $test_cmd = escapeshellcmd($convert) . ' -density 72 ' . escapeshellarg($test_pdf . '[0]') . ' ' . escapeshellarg($test_png) . ' 2>&1';
      exec($test_cmd, $test_output, $test_return);
      @unlink($test_pdf);
      $test_success = ($test_return === 0 && file_exists($test_png));
      @unlink($test_png);

      if ($test_success) {
        $requirements['dropfiles_imagemagick'] = array(
          'title' => t('DropFiles: PDF thumbnails'),
          'value' => t('Available'),
          'description' => t('ImageMagick and Ghostscript are installed and PDF conversion is working.'),
          'severity' => REQUIREMENT_OK,
        );
      }
      else {
        $requirements['dropfiles_imagemagick'] = array(
          'title' => t('DropFiles: PDF thumbnails'),
          'value' => t('PDF conversion blocked'),
          'description' => t('ImageMagick and Ghostscript are installed but PDF conversion failed. This is usually caused by an ImageMagick security policy blocking PDF reads. Check /etc/ImageMagick-*/policy.xml. Error: @error', array(
            '@error' => implode(' ', $test_output),
          )),
          'severity' => REQUIREMENT_WARNING,
        );
      }
    }
    elseif ($has_imagemagick && !$has_gs) {
      $requirements['dropfiles_imagemagick'] = array(
        'title' => t('DropFiles: PDF thumbnails'),
        'value' => t('Ghostscript not found'),
        'description' => t('ImageMagick is installed but Ghostscript is missing. PDF thumbnail generation requires both. Install Ghostscript to enable PDF previews.'),
        'severity' => REQUIREMENT_WARNING,
      );
    }
    else {
      $requirements['dropfiles_imagemagick'] = array(
        'title' => t('DropFiles: PDF thumbnails'),
        'value' => t('ImageMagick not found'),
        'description' => t('ImageMagick and Ghostscript are required for PDF thumbnail generation. Without them, PDF files will display a generic icon instead of a preview.'),
        'severity' => REQUIREMENT_WARNING,
      );
    }
  }

  return $requirements;
}

/**
 * Implements hook_uninstall().
 *
 * The dropfiles_tags table is dropped automatically via hook_schema().
 * We intentionally do NOT delete the taxonomy vocabulary, its terms,
 * or any managed files — that would risk destroying user content.
 */
function dropfiles_uninstall() {
  // Nothing extra needed. Schema-defined tables are dropped automatically.
}
