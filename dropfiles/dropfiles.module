    'title callback' => 'dropfiles_display_name',
    'page callback' => 'dropfiles_library_page',
    'access callback' => 'user_access',
    'access arguments' => array('access dropfiles'),
    'file' => 'dropfiles.pages.inc',
  );

  $items['drop/files/upload'] = array(
    'title' => 'Upload',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('dropfiles_upload_form'),
    'access callback' => 'user_access',
    'access arguments' => array('upload dropfiles'),
    'file' => 'dropfiles.pages.inc',
  );

  $items['drop/files/%file/view'] = array(
    'title' => 'File details',
    'page callback' => 'dropfiles_file_view_page',
    'page arguments' => array(2),
    'access callback' => 'dropfiles_library_file_access',
    'access arguments' => array(2),
    'file' => 'dropfiles.pages.inc',
  );

  $items['drop/files/%file/edit'] = array(
    'title' => 'Edit file',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('dropfiles_edit_form', 2),
    'access callback' => 'dropfiles_library_file_access',
    'access arguments' => array(2),
    'file' => 'dropfiles.pages.inc',
  );

  $items['drop/files/%file/replace'] = array(
    'title' => 'Replace file',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('dropfiles_replace_form', 2),
    'access callback' => 'dropfiles_library_file_access',
    'access arguments' => array(2),
    'file' => 'dropfiles.pages.inc',
  );

  $items['drop/files/%file/delete'] = array(
    'title' => 'Delete file',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('dropfiles_delete_form', 2),
    'access callback' => 'dropfiles_library_file_access',
    'access arguments' => array(2),
    'file' => 'dropfiles.pages.inc',
  );

  // AJAX upload endpoint for drag-and-drop.
  $items['drop/files/ajax-upload'] = array(
    'page callback' => 'dropfiles_ajax_upload',
    'access callback' => 'user_access',
    'access arguments' => array('upload dropfiles'),
    'file' => 'dropfiles.pages.inc',
    'type' => MENU_CALLBACK,
  );

  $items['drop/files/settings'] = array(
    'title' => 'Settings',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('dropfiles_settings_form'),
    'access callback' => 'user_access',
    'access arguments' => array('administer dropfiles'),
    'file' => 'dropfiles.pages.inc',
  );

  return $items;
}

/**
 * Access callback for library file operations.
 *
 * Checks that the current user has the 'upload dropfiles' permission and
 * that the file belongs to the dropfiles library (tracked via file_usage).
 *
 * @param object $file
 *   The file object loaded from the menu wildcard.
 *
 * @return bool
 *   TRUE if the user has access, FALSE otherwise.
 */
function dropfiles_library_file_access($file) {
  if (!user_access('upload dropfiles')) {
    return FALSE;
  }

  // Verify the file is in the dropfiles library.
  $usage = db_select('file_usage', 'fu')
    ->fields('fu', array('fid'))
    ->condition('fu.fid', $file->fid)
    ->condition('fu.module', 'dropfiles')
    ->condition('fu.type', 'library')
    ->range(0, 1)
    ->execute()
    ->fetchField();

  return !empty($usage);
}

/**
 * Implements hook_drop_nav_links().
 */
function dropfiles_drop_nav_links() {
  return array(
    array(
      'title'      => t('Files'),
      'path'       => 'drop/files',
      'permission' => 'access dropfiles',
      'weight'     => 45,
    ),
  );
}

/**
 * Implements hook_drop_section_links().
 */
function dropfiles_drop_section_links($section) {
  if ($section !== 'files') {
    return array();
  }

  $links = array();

  $links[] = array(
    'title' => t('All files'),
    'href' => 'drop/files',
    'weight' => -10,
    'active_paths' => array('drop/files', 'drop/files/list'),
  );

  $links[] = array(
    'title' => t('Upload'),
    'href' => 'drop/files/upload',
    'weight' => 0,
    'permission' => 'upload dropfiles',
  );

  return $links;
}

/**
 * Implements hook_drop_settings_info().
 */
function dropfiles_drop_settings_info() {
  return array(
    'dropfiles' => array(
      'title' => t('DropFiles'),
      'description' => t('File library settings.'),
      'path' => 'drop/files/settings',
      'permission' => 'administer dropfiles',
      'weight' => 45,
    ),
  );
}

/**
 * Get tags assigned to a file.
 *
 * @param int $fid
 *   The file ID.
 *
 * @return array
 *   Array of term objects with tid and name properties.
 */
function dropfiles_get_file_tags($fid) {
  $file = file_load($fid);
  if (!$file || empty($file->field_file_tags[LANGUAGE_NONE])) {
    return array();
  }

  $tags = array();
  foreach ($file->field_file_tags[LANGUAGE_NONE] as $item) {
    $term = taxonomy_term_load($item['tid']);
    if ($term) {
      $tags[] = (object) array('tid' => $term->tid, 'name' => $term->name);
    }
  }
  return $tags;
}

/**
 * Save tags for a file, replacing any existing tags.
 *
 * @param int $fid
 *   The file ID.
 * @param array $tag_names
 *   Array of tag name strings.
 */
function dropfiles_save_file_tags($fid, array $tag_names) {
  $file = file_load($fid);
  if (!$file) {
    return;
  }

  // Clear existing tags.
  $file->field_file_tags[LANGUAGE_NONE] = array();

  if (empty($tag_names)) {
    file_save($file);
    return;
  }

  // Load the file_tags vocabulary.
  $vocab = taxonomy_vocabulary_load('file_tags');
  if (!$vocab) {
    return;
  }

  foreach ($tag_names as $name) {
    $name = trim($name);
    if (empty($name)) {
      continue;
    }

    // Find existing term or create a new one.
    $terms = taxonomy_term_load_multiple_by_name($name, 'file_tags');
    if (!empty($terms)) {
      $term = reset($terms);
    }
    else {
      $term = new TaxonomyTerm(array(
        'vocabulary' => 'file_tags',
        'name' => $name,
      ));
      taxonomy_term_save($term);
    }

    $file->field_file_tags[LANGUAGE_NONE][] = array('tid' => $term->tid);
  }

  file_save($file);
}

/**
 * Return a thumbnail HTML string for a file.
 *
 * For images, uses Backdrop's thumbnail image style. For PDFs, checks for a
 * generated thumbnail. Falls back to a Phosphor icon.
 *
 * @param object $file
 *   A file object with uri and filemime properties.
 * @param int $size
 *   The icon size in pixels (used for fallback icons).
 *
 * @return string
 *   HTML for the thumbnail or icon.
 */
function dropfiles_file_thumbnail($file, $size = 40, $image_style = 'thumbnail') {
  // Image files: use core image style.
  if (strpos($file->filemime, 'image/') === 0) {
    $url = image_style_url($image_style, $file->uri);
    return '<img src="' . check_url($url) . '" alt="" class="dropfiles-thumb" style="max-width:' . $size . 'px">';
  }

  // PDF files: check for generated thumbnail.
  if ($file->filemime === 'application/pdf') {
    $thumb_uri = dropfiles_pdf_thumbnail_uri($file->fid);
    if (file_exists($thumb_uri)) {
      $url = file_create_url($thumb_uri);
      return '<img src="' . check_url($url) . '" alt="" class="dropfiles-thumb" style="max-width:' . $size . 'px">';
    }
  }

  // Fallback to Phosphor icon.
  $icon_name = dropfiles_file_icon($file->filemime);
  return icon($icon_name, array('attributes' => array('width' => $size, 'height' => $size)));
}

/**
 * Return the expected URI for a PDF thumbnail.
 *
 * @param int $fid
 *   The file ID.
 *
 * @return string
 *   A stream wrapper URI like public://dropfiles_thumbs/123.png.
 */
function dropfiles_pdf_thumbnail_uri($fid) {
  return 'public://dropfiles_thumbs/' . $fid . '.png';
}

/**
 * Generate a thumbnail for a PDF file using ImageMagick.
 *
 * Renders page 1 of the PDF as a PNG image.
 *
 * @param object $file
 *   A file object with fid, uri, and filemime properties.
 *
 * @return bool
 *   TRUE if the thumbnail was generated, FALSE otherwise.
 */
function dropfiles_generate_pdf_thumbnail($file) {
  if ($file->filemime !== 'application/pdf') {
    return FALSE;
  }

  $source = backdrop_realpath($file->uri);
  if (!$source || !file_exists($source)) {
    return FALSE;
  }

  // Check that ImageMagick is available (prefer magick, fall back to convert).
  $convert = trim(shell_exec('which magick 2>/dev/null'));
  if (empty($convert)) {
    $convert = trim(shell_exec('which convert 2>/dev/null'));
  }
  if (empty($convert)) {
    return FALSE;
  }

  $thumb_dir = 'public://dropfiles_thumbs';
  file_prepare_directory($thumb_dir, FILE_CREATE_DIRECTORY);
  $dest_dir = backdrop_realpath($thumb_dir);
  if (!$dest_dir || !is_writable($dest_dir)) {
    watchdog('dropfiles', 'PDF thumbnail directory not writable: @dir', array(
      '@dir' => $thumb_dir,
    ), WATCHDOG_WARNING);
    return FALSE;
  }
  $dest = $dest_dir . '/' . $file->fid . '.png';

  // Render page 1 at 200 DPI, resize to 400px wide.
  $cmd = escapeshellcmd($convert)
    . ' -density 200'
    . ' ' . escapeshellarg($source . '[0]')
    . ' -resize 400x'
    . ' -background white'
    . ' -flatten'
    . ' ' . escapeshellarg($dest);

  exec($cmd . ' 2>&1', $output, $return_code);

  if ($return_code !== 0) {
    watchdog('dropfiles', 'PDF thumbnail generation failed for fid @fid: @output', array(
      '@fid' => $file->fid,
      '@output' => implode("\n", $output),
    ), WATCHDOG_WARNING);
    return FALSE;
  }

  return file_exists($dest);
}

/**
 * Return a human-readable file type label.
 *
 * @param string $filemime
 *   The MIME type of the file.
 * @param string $filename
 *   The filename (used for extension fallback).
 *
 * @return string
 *   A human-readable type string, e.g. "PDF Document".
 */
function dropfiles_human_type($filemime, $filename = '') {
  $map = array(
    'application/pdf' => 'PDF Document',
    'application/msword' => 'Word Document',
    'application/vnd.openxmlformats-officedocument.wordprocessingml.document' => 'Word Document',
    'application/vnd.ms-excel' => 'Excel Spreadsheet',
    'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' => 'Excel Spreadsheet',
    'application/vnd.ms-powerpoint' => 'PowerPoint Presentation',
    'application/vnd.openxmlformats-officedocument.presentationml.presentation' => 'PowerPoint Presentation',
    'application/zip' => 'ZIP Archive',
    'application/x-rar-compressed' => 'RAR Archive',
    'text/plain' => 'Text File',
    'text/csv' => 'CSV Spreadsheet',
    'text/markdown' => 'Markdown Document',
    'text/x-markdown' => 'Markdown Document',
  );

  if (isset($map[$filemime])) {
    return $map[$filemime];
  }

  if (strpos($filemime, 'image/') === 0) {
    $subtype = strtoupper(substr($filemime, 6));
    return $subtype . ' Image';
  }

  // Fallback: use the file extension.
  if ($filename) {
    $ext = strtoupper(pathinfo($filename, PATHINFO_EXTENSION));
    if ($ext) {
      return $ext . ' File';
    }
  }

  return t('File');
}

/**
 * Return a Phosphor icon name based on a file's MIME type.
 *
 * @param string $filemime
 *   The MIME type of the file.
 *
 * @return string
 *   A Phosphor icon name.
 */
function dropfiles_file_icon($filemime) {
  if ($filemime === 'application/pdf') {
    return 'file-pdf';
  }

  if (strpos($filemime, 'image/') === 0) {
    return 'file-image';
  }

  // Excel / spreadsheet types.
  $spreadsheet_types = array(
    'application/vnd.ms-excel',
    'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
    'text/csv',
  );
  if (in_array($filemime, $spreadsheet_types)) {
    return 'file-xls';
  }

  // Word / document types.
  $doc_types = array(
    'application/msword',
    'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
  );
  if (in_array($filemime, $doc_types)) {
    return 'file-doc';
  }

  if (strpos($filemime, 'text/') === 0) {
    return 'file-text';
  }

  return 'file';
}
