<?php
/**
 * @file
 * Team file sharing library for the Drop Suite.
 */

/**
 * Return the configured display name for the file library.
 *
 * @param string $variant
 *   One of 'plural' (default) or 'singular'.
 *
 * @return string
 *   The display name.
 */
function dropfiles_display_name($variant = 'plural') {
  $name = config_get('dropfiles.settings', 'display_name');
  if (empty($name)) {
    $name = 'Files';
  }

  switch ($variant) {
    case 'singular':
      // Strip trailing 's' for simple singular form.
      return preg_match('/s$/i', $name) ? rtrim($name, 'sS') : $name;

    case 'plural':
    default:
      return $name;
  }
}

/**
 * Implements hook_permission().
 */
function dropfiles_permission() {
  return array(
    'access dropfiles' => array(
      'title' => t('View the file library'),
    ),
    'upload dropfiles' => array(
      'title' => t('Upload and manage files'),
    ),
    'administer dropfiles' => array(
      'title' => t('Manage file library settings'),
    ),
  );
}

