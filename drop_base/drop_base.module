<?php
/**
 * @file
 * Drop Base — shared utilities for DropCRM and DropTasks.
 *
 * Provides shared CSS variables and utility classes used across the Drop
 * module family. Neither DropCRM nor DropTasks should duplicate these values —
 * update here and both modules stay in sync.
 */

/**
 * @defgroup drop_nav Drop navigation bar
 *
 * Provides a shared top navigation bar across all Drop admin pages.
 *
 * Any module can register itself by implementing hook_drop_nav_links(),
 * returning an array of link definition arrays with keys:
 *   - title: (string) Human-readable label.
 *   - path: (string) Backdrop path for the link.
 *   - permission: (string) Permission required to see the link.
 *   - weight: (int) Sort order.
 */

/**
 * Implements hook_preprocess_layout().
 *
 * On most Drop admin pages: suppresses Backdrop's hardcoded $action_links
 * because modules render their own inline action bars. On report sub-tab
 * pages: replaces action_links with a pin/unpin button.
 */
function drop_base_preprocess_layout(&$variables) {
  $path = current_path();

  // Expose the configured narrow-page width as a CSS variable on every page
  // so static CSS can cap the Section Nav and Page Tabs blocks to the same
  // width on wide pages (keeps header elements in a stable position).
  $narrow_width = (int) config_get('drop_base.settings', 'narrow_page_width');
  if ($narrow_width) {
    backdrop_add_css(':root { --drop-narrow-page-width: ' . $narrow_width . 'px; }', 'inline');
  }

  // Narrow-page detection runs for ALL paths, since a few matched routes
  // live outside drop/* (e.g. node/add/doc).
  if (_drop_base_is_narrow_page($path)) {
    $variables['classes'][] = 'drop-narrow-page';
    if ($narrow_width) {
      backdrop_add_css('.drop-narrow-page .l-wrapper { max-width: ' . $narrow_width . 'px; margin: 0 auto; }', 'inline');
    }
  }

  if ($path !== 'drop' && strpos($path, 'drop/') !== 0) {
    return;
  }

  // If no sidebar regions have content, add a class so CSS can expand the
  // main content column to full width.
  $has_sidebar = FALSE;
  foreach ($variables['content'] as $region_name => $region_content) {
    if (strpos($region_name, 'sidebar') !== FALSE && !empty($region_content)) {
      $has_sidebar = TRUE;
      break;
    }
  }
  if (!$has_sidebar) {
    $variables['classes'][] = 'layout--no-sidebar';
  }
}

/**
 * Implements hook_theme_registry_alter().
 *
 * Ensures drop_base_preprocess_page_components() runs *after*
 * system_preprocess_page_components(), which sets $variables['messages']
 * via theme('status_messages'). Without this re-ordering our preprocess
 * would run first and then get overwritten.
 */
function drop_base_theme_registry_alter(&$registry) {
  if (!isset($registry['page_components']['preprocess functions'])) {
    return;
  }
  $funcs = &$registry['page_components']['preprocess functions'];
  $ours  = 'drop_base_preprocess_page_components';
  $funcs = array_values(array_diff($funcs, array($ours)));
  $funcs[] = $ours;
}

/**
 * Implements hook_preprocess_page_components().
 *
 * Prepends the dismissible site announcement banner to the messages
 * page-components block. The banner text comes from
 * dropbridge.settings:announcement_text (config kept in dropbridge for
 * backwards compatibility — the admin form still lives there). Each message
 * is hashed; dismissing sets a per-user state flag so the banner stays gone
 * until the admin changes the text.
 */
function drop_base_preprocess_page_components(&$variables) {
  global $user;

  if ($variables['child_delta'] !== 'messages') {
    return;
  }
  if (!backdrop_is_html() || !$user->uid) {
    return;
  }

  $text = (string) config_get('dropbridge.settings', 'announcement_text');
  if (empty(trim($text))) {
    return;
  }

  $hash = substr(md5($text), 0, 8);
  $dismissed = state_get('drop_base.announcement_dismissed_' . $user->uid, '');
  if ($dismissed === $hash) {
    return;
  }

  $dismiss_url = url('drop/announcement/dismiss', array(
    'query' => array('h' => $hash, 'destination' => current_path()),
  ));

  $banner  = '<div class="drop-announcement" id="drop-announcement">';
  $banner .= '<span class="drop-announcement-text">' . check_plain($text) . '</span>';
  $banner .= '<a class="drop-announcement-dismiss" href="' . $dismiss_url . '" title="' . t('Dismiss') . '">&#x2715;</a>';
  $banner .= '</div>';

  backdrop_add_css(backdrop_get_path('module', 'drop_base') . '/drop_base.css');

  $existing = isset($variables['messages']) ? $variables['messages'] : '';
  $variables['messages'] = $banner . $existing;
}

/**
 * Page callback: dismiss the current site announcement for the current user.
 */
function drop_base_announcement_dismiss() {
  global $user;

  $hash = isset($_GET['h']) ? preg_replace('/[^a-f0-9]/', '', $_GET['h']) : '';
  if ($hash && $user->uid) {
    state_set('drop_base.announcement_dismissed_' . $user->uid, $hash);
  }

  backdrop_goto(isset($_GET['destination']) ? $_GET['destination'] : 'drop');
}

/**
 * Checks whether the current path should use the narrow page layout.
 *
 * Narrow pages are individual entity views — not lists or kanban boards.
 *
 * @param string $path
 *   The current Backdrop path.
 *
 * @return bool
 */
function _drop_base_is_narrow_page($path) {
  $patterns = array(
    // Individual ticket view and forms: drop/tickets/{tid}, add, edit.
    '#^drop/tickets/\d+$#',
    '#^drop/tickets/add$#',
    '#^drop/tickets/\d+/edit$#',
    // Comment edit form on a ticket: drop/tickets/{tid}/comment/{tcid}/edit.
    '#^drop/tickets/\d+/comment/\d+/edit$#',
    // CRM contact view: drop/crm/contact/{cid}
    '#^drop/crm/contact/\d+$#',
    // CRM activity view: drop/crm/activity/{aid}
    '#^drop/crm/activity/\d+$#',
    // CRM contact method view: drop/crm/contact-method/{cmid} (entity_ui path)
    '#^drop/crm/contact-methods/\d+$#',
    // Individual task view and forms: drop/tasks/{tid}, add, edit.
    '#^drop/tasks/\d+$#',
    '#^drop/tasks/add$#',
    '#^drop/tasks/\d+/edit$#',
    // Goals list, individual goal view, and forms.
    '#^drop/goals$#',
    '#^drop/goals/manage/\d+$#',
    '#^drop/goals/manage/add$#',
    '#^drop/goals/manage/\d+/edit$#',
    // Time entry edit.
    '#^drop/time/entry/\d+/edit$#',
    // Docs list and add form. The canonical doc view path is node/{nid},
    // which is handled by the dropdocs sidebar layout (not narrow).
    '#^drop/docs$#',
    '#^node/add/doc$#',
    // Project view and forms: drop/projects/{pid}, add, edit.
    '#^drop/projects/\d+$#',
    '#^drop/projects/add$#',
    '#^drop/projects/\d+/edit$#',
    // CRM contact add/edit (entity_ui paths + alias path).
    '#^drop/crm/contacts/manage/crm_\w+/add$#',
    '#^drop/crm/contacts/manage/\d+/edit$#',
    '#^drop/crm/contacts/\d+/edit$#',
    // CRM activity add/edit (entity_ui paths).
    '#^drop/crm/activities/manage/add$#',
    '#^drop/crm/activities/manage/\d+/edit$#',
    // Membership add/edit/renew/cancel and payment + term CRUD forms.
    '#^drop/crm/memberships/add$#',
    '#^drop/crm/memberships/\d+/edit$#',
    '#^drop/crm/memberships/\d+/renew$#',
    '#^drop/crm/memberships/\d+/cancel$#',
    '#^drop/crm/memberships/\d+/payment/add$#',
    '#^drop/crm/memberships/\d+/payment/\d+/edit$#',
    '#^drop/crm/memberships/\d+/payment/\d+/delete$#',
    '#^drop/crm/memberships/\d+/term/\d+/edit$#',
    '#^drop/crm/memberships/\d+/term/\d+/delete$#',
    // File library: list, upload, view, replace.
    '#^drop/files$#',
    '#^drop/files/upload$#',
    '#^drop/files/\d+/view$#',
    '#^drop/files/\d+/edit$#',
    '#^drop/files/\d+/replace$#',
    '#^drop/files/\d+/delete$#',
    // Team updates feed and forms.
    '#^drop/updates$#',
    '#^drop/updates/add$#',
    '#^drop/updates/\d+/edit$#',
    '#^drop/updates/\d+/delete$#',
    // Meeting agenda.
    '#^drop/meeting$#',
    // Settings pages (main dashboard and per-module).
    '#^drop/settings#',
    '#^drop/tickets/settings#',
    '#^drop/crm/settings#',
    '#^drop/monitor/settings#',
    '#^drop/docs/settings#',
    '#^drop/time/settings#',
    '#^drop/files/settings#',
    // Drop Start setup wizard (overview + per-step pages).
    '#^drop/start#',
  );

  foreach ($patterns as $pattern) {
    if (preg_match($pattern, $path)) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Page callback: 301 redirect from /drop/settings/home-nav to the wizard step.
 *
 * The home-page-navigation tool moved into the Drop Start wizard. Any
 * bookmarks to the old path land here and get forwarded to the new home.
 */
function _drop_base_home_nav_redirect() {
  backdrop_goto('drop/start/step/home_page', array(), 301);
}

/**
 * Implements hook_layout_load_by_router_item_alter().
 *
 * Injects the drop_pages layout for any non-admin router path under /drop,
 * so Drop Suite pages use the drop_suite template while the rest of the
 * site falls through to the regular default layout. Enumerating 300+
 * concrete router paths in a layout's additional_paths is impractical;
 * this hook is the cleaner alternative.
 */
function drop_base_layout_load_by_router_item_alter(&$layouts, $router_item) {
  $path = isset($router_item['path']) ? $router_item['path'] : '';
  if ($path !== 'drop' && strpos($path, 'drop/') !== 0) {
    return;
  }
  // /admin/* paths use admin_default; leave them alone.
  if (path_is_admin($path)) {
    return;
  }
  $drop_pages = layout_load('drop_pages');
  if (!$drop_pages || !empty($drop_pages->disabled)) {
    return;
  }
  // Prepend so drop_pages wins over the default layout.
  $layouts = array('drop_pages' => $drop_pages) + $layouts;
}

/**
 * Returns a renderable local-action entry for the pin/unpin button, or NULL.
 *
 * Used by hook_menu_local_tasks_alter() to inject the pin action into the
 * Page Local Actions block on report pages. Returns NULL if the current path
 * is not a known report, or the viewer lacks access.
 *
 * The render structure matches Backdrop's local-action conventions: a
 * '#theme' => 'menu_local_action' wrapper with a '#link' array. When the
 * user is at the pin limit, a non-link <li> is returned via '#markup'
 * because there is no action to perform.
 *
 * @param string $path
 *   The current page path.
 *
 * @return array|null
 *   Render array suitable for $data['actions']['output'][], or NULL.
 */
function _drop_base_report_pin_action_item($path) {
  global $user;

  $all_reports = drop_base_get_all_reports();
  if (empty($all_reports)) {
    return NULL;
  }

  // Build a path → report_id lookup.
  // For reports marked as the default sub-task, also map their parent path
  // (e.g. drop/tickets/reports → droptickets_stale), since Backdrop
  // renders the default sub-task at the parent URL without redirecting.
  $report_by_path = array();
  foreach ($all_reports as $id => $report) {
    $report_by_path[$report['path']] = $id;
    if (!empty($report['is_default_subtask'])) {
      $parts  = explode('/', $report['path']);
      $parent = implode('/', array_slice($parts, 0, count($parts) - 1));
      if ($parent && !isset($report_by_path[$parent])) {
        $report_by_path[$parent] = $id;
      }
    }
  }
  if (!isset($report_by_path[$path])) {
    return NULL;
  }

  $report_id = $report_by_path[$path];
  $report    = $all_reports[$report_id];

  // Access check.
  if (!empty($report['access callback'])) {
    $args = !empty($report['access arguments']) ? $report['access arguments'] : array();
    if (!call_user_func_array($report['access callback'], $args)) {
      return NULL;
    }
  }

  $pins      = drop_base_get_pinned_reports($user->uid);
  $is_pinned = in_array($report_id, $pins);
  $at_limit  = (count($pins) >= 8);

  // At-limit state has no action — render as a plain non-link <li>.
  if (!$is_pinned && $at_limit) {
    $icon = icon('push-pin', array('attributes' => array('width' => 14, 'height' => 14)));
    return array(
      '#markup' => '<li><span class="drop-pin-link drop-pin-disabled">' . $icon . t('Pin limit reached (8)') . '</span></li>',
    );
  }

  if ($is_pinned) {
    $icon  = icon('push-pin-slash', array('attributes' => array('width' => 14, 'height' => 14)));
    $label = t('Unpin report');
    $class = 'drop-pin-link drop-pin-active';
  }
  else {
    $icon  = icon('push-pin', array('attributes' => array('width' => 14, 'height' => 14)));
    $label = t('Pin report');
    $class = 'drop-pin-link';
  }

  return array(
    '#theme' => 'menu_local_action',
    '#link' => array(
      'title' => $icon . $label,
      'href'  => 'drop-base/pin-report/' . $report_id,
      'localized_options' => array(
        'html'       => TRUE,
        'query'      => backdrop_get_destination(),
        'attributes' => array('class' => array($class)),
      ),
    ),
  );
}

/**
 * Implements hook_menu_local_tasks_alter().
 *
 * Injects the report pin/unpin button into the Page Local Actions list on
 * report pages. Replaces the deprecated drop_pin_action block — keeps the
 * action co-located with other local actions like "+ New ticket" rather
 * than occupying its own block slot in the layout.
 */
function drop_base_menu_local_tasks_alter(&$data, $router_item, $root_path) {
  $item = _drop_base_report_pin_action_item(current_path());
  if ($item) {
    $data['actions']['output'][] = $item;
  }
}

/**
 * Implements hook_theme().
 */
function drop_base_theme() {
  return array(
    'drop_base_navigation_form' => array(
      'render element' => 'form',
      'file' => 'drop_base.nav_admin.inc',
    ),
  );
}

/**
 * Implements hook_block_info().
 *
 * Exposes the Drop nav bar and section nav as placeable layout blocks.
 */
function drop_base_block_info() {
  $blocks['drop_nav'] = array(
    'info'        => t('Drop Navigation'),
    'description' => t('Primary navigation bar for the Drop module suite (CRM, Tasks, Tickets, Time, Goals).'),
    'cache'       => BACKDROP_NO_CACHE,
  );
  $blocks['drop_section_nav'] = array(
    'info'        => t('Drop Section Navigation'),
    'description' => t('Secondary navigation bar for the current Drop Suite section (module-specific links). Replaces Backdrop tabs on Drop pages.'),
    'cache'       => BACKDROP_NO_CACHE,
  );
  return $blocks;
}

/**
 * Implements hook_block_view().
 */
function drop_base_block_view($delta = '') {
  if ($delta === 'drop_nav') {
    $nav_html = _drop_base_render_nav();
    if (!$nav_html) {
      return array();
    }
    return array(
      'subject' => NULL,
      'content' => $nav_html,
    );
  }

  if ($delta === 'drop_section_nav') {
    $html = _drop_base_section_nav_block();
    if (!$html) {
      return array();
    }
    return array(
      'subject' => NULL,
      'content' => $html,
    );
  }

  return array();
}

/**
 * Collects all hook_drop_nav_links() items, keyed by path.
 *
 * Results are raw (no permission filter, no overrides applied) so that the
 * admin UI can show every module-declared item regardless of the viewing
 * user's role, and so that the renderer has a stable list to reconcile
 * against config overrides.
 *
 * The 'module' key is added so the admin UI can show which module each item
 * came from.
 *
 * @return array
 *   Associative array keyed by path; each value is the hook item plus a
 *   'module' key.
 */
function _drop_base_hook_nav_items() {
  $items = &backdrop_static(__FUNCTION__);
  if (isset($items)) {
    return $items;
  }
  $items = array();
  foreach (module_implements('drop_nav_links') as $module) {
    $links = module_invoke($module, 'drop_nav_links');
    if (!is_array($links)) {
      continue;
    }
    foreach ($links as $link) {
      if (empty($link['path'])) {
        continue;
      }
      if (!isset($items[$link['path']])) {
        $link['module'] = $module;
        if (!isset($link['weight'])) {
          $link['weight'] = 0;
        }
        $items[$link['path']] = $link;
      }
    }
  }
  return $items;
}

/**
 * Builds and returns the Drop nav HTML, or FALSE if no links are available.
 *
 * Combines hook_drop_nav_links() results with the drop_base.navigation config
 * overrides and Site Architect shortcuts, then renders the bar.
 *
 * @return string|false
 */
function _drop_base_render_nav() {
  $path = current_path();

  // Load hook items, overrides, and shortcuts.
  $hook_items = _drop_base_hook_nav_items();
  $config = config('drop_base.navigation');
  $overrides = $config->get('overrides');
  $shortcuts = $config->get('shortcuts');
  $show_icons = $config->get('show_icons');
  if ($show_icons === NULL) {
    $show_icons = TRUE;
  }
  if (!is_array($overrides)) {
    $overrides = array();
  }
  if (!is_array($shortcuts)) {
    $shortcuts = array();
  }

  // Apply overrides to hook items. Runtime visibility flags from the hook
  // still win (e.g. "Meeting" hidden when meeting_enabled is off).
  $links = array();
  foreach ($hook_items as $item_path => $link) {
    if (isset($overrides[$item_path])) {
      $override = $overrides[$item_path];
      if (!empty($override['hidden'])) {
        continue;
      }
      if (isset($override['title']) && $override['title'] !== '') {
        $link['title'] = $override['title'];
      }
      if (isset($override['icon']) && $override['icon'] !== '') {
        $link['icon'] = $override['icon'];
      }
      if (isset($override['weight'])) {
        $link['weight'] = (int) $override['weight'];
      }
    }
    $links[] = $link;
  }

  // Append shortcuts. Shortcuts are Site Architect-authored, so they have no
  // module-declared permission — they're visible to everyone who can see the
  // nav itself.
  foreach ($shortcuts as $shortcut) {
    if (!is_array($shortcut) || empty($shortcut['path'])) {
      continue;
    }
    if (!empty($shortcut['hidden'])) {
      continue;
    }
    $links[] = array(
      'title'  => isset($shortcut['title']) && $shortcut['title'] !== '' ? $shortcut['title'] : $shortcut['path'],
      'path'   => $shortcut['path'],
      'icon'   => isset($shortcut['icon']) ? $shortcut['icon'] : NULL,
      'weight' => isset($shortcut['weight']) ? (int) $shortcut['weight'] : 50,
    );
  }

  // Filter by access + runtime visibility flags from the hook.
  $links = array_filter($links, function($link) {
    if (isset($link['visible']) && !$link['visible']) {
      return FALSE;
    }
    if (!empty($link['hidden'])) {
      return FALSE;
    }
    return empty($link['permission']) || user_access($link['permission']);
  });
  if (empty($links)) {
    return FALSE;
  }
  uasort($links, 'drupal_sort_weight');

  // Render nav items, marking the active section.
  $items_html = '';
  foreach ($links as $link) {
    if (!empty($link['separator'])) {
      $items_html .= '<span class="drop-nav-separator"></span>';
    }
    $is_active = _drop_base_nav_is_active($link['path'], $path);
    $class = $is_active ? ' class="drop-nav-active"' : '';
    $badge_html = '';
    if (isset($link['badge']) && $link['badge'] !== '' && $link['badge'] !== 0) {
      $badge_html = ' <span class="drop-nav-badge">' . check_plain((string) $link['badge']) . '</span>';
    }
    $icon_html = '';
    if ($show_icons && !empty($link['icon']) && function_exists('icon')) {
      $rendered = icon(strtolower($link['icon']), array(
        'attributes' => array('width' => 16, 'height' => 16, 'class' => array('drop-nav-icon-svg')),
      ));
      if ($rendered) {
        $icon_html = '<span class="drop-nav-icon">' . $rendered . '</span>';
      }
    }
    $items_html .= '<a href="' . url($link['path']) . '"' . $class . '>' . $icon_html . check_plain($link['title']) . $badge_html . '</a>';
  }

  // Allow other modules to add content to the right side of the nav.
  $extras = module_invoke_all('drop_nav_extras');
  $extras_html = !empty($extras) ? '<span class="drop-nav-extras">' . implode('', $extras) . '</span>' : '';

  return '<nav class="drop-nav">' . $items_html . $extras_html . '</nav>';
}

/**
 * Determines whether a nav link's path matches the current page.
 *
 * @param string $link_path
 * @param string $current_path
 * @return bool
 */
function _drop_base_nav_is_active($link_path, $current_path) {
  // DropBridge dashboard lives at 'drop' exactly — don't treat it as a prefix match.
  if ($link_path === 'drop') {
    return $current_path === 'drop';
  }
  return $current_path === $link_path
    || strpos($current_path, $link_path . '/') === 0;
}

// ---------------------------------------------------------------------------
// Section navigation (hook_drop_section_links)
// ---------------------------------------------------------------------------

/**
 * @defgroup drop_section_nav Drop Suite section navigation
 *
 * Provides a per-module secondary navigation bar on Drop Suite pages.
 *
 * Any module can contribute links to a section by implementing
 * hook_drop_section_links($section). The section is derived from the second
 * path component (e.g. 'tickets' for drop/tickets/*).
 *
 * Each link is an associative array with:
 *   - title: (string) Human-readable label.
 *   - href: (string) Backdrop path for the link.
 *   - weight: (int) Sort order (lower = further left).
 *   - options: (array, optional) Options passed to l() — supports 'query',
 *     'fragment', 'attributes', etc.
 *   - badge: (int|string, optional) Short text rendered as a badge pill.
 *   - admin_only: (bool, optional) Renders link de-emphasised; does not
 *     enforce access — callers must check permissions before adding the link.
 *   - active_paths: (string[], optional) Additional paths (exact or prefix)
 *     that trigger the active state for this link.
 *   - pinned: (bool, optional) Added automatically for pinned reports.
 */

/**
 * Builds and returns the section nav HTML for the current page, or FALSE.
 *
 * Collects links via hook_drop_section_links(), injects any pinned reports
 * the current user has for this section, sorts by weight, and renders.
 *
 * @return string|false
 */
function _drop_base_section_nav_block() {
  $section = _drop_base_get_section();
  if (!$section) {
    return FALSE;
  }

  // Gather links from all modules.
  $links = module_invoke_all('drop_section_links', $section);
  backdrop_alter('drop_section_links', $links, $section);

  // Inject pinned reports that belong to this section.
  global $user;
  $pinned      = drop_base_get_pinned_reports($user->uid);
  $all_reports = drop_base_get_all_reports();
  $pin_weight  = 50;
  foreach ($pinned as $report_id) {
    if (!isset($all_reports[$report_id])) {
      continue;
    }
    $report = $all_reports[$report_id];
    if (!_drop_base_report_in_section($report, $section)) {
      continue;
    }
    if (!empty($report['access callback'])) {
      $args = !empty($report['access arguments']) ? $report['access arguments'] : array();
      if (!call_user_func_array($report['access callback'], $args)) {
        continue;
      }
    }
    $links['pinned_' . $report_id] = array(
      'title'  => $report['title'],
      'href'   => $report['path'],
      'weight' => $pin_weight++,
      'pinned' => TRUE,
    );
  }

  if (empty($links)) {
    return FALSE;
  }

  uasort($links, 'drupal_sort_weight');

  // Allow modules to add extras (e.g. action buttons) to the right side of
  // the section nav by implementing hook_drop_section_nav_extras($section).
  $extras = module_invoke_all('drop_section_nav_extras', $section);

  return _drop_base_render_section_nav($links, $extras);
}

/**
 * Returns the section identifier for the current path, or NULL.
 *
 * The section is the second path component for drop/* pages:
 *   drop/tickets/* → 'tickets'
 *   drop/crm/*     → 'crm'
 *   drop           → NULL  (dashboard — no section nav)
 *
 * @return string|null
 */
function _drop_base_get_section() {
  $path = current_path();
  // Settings sub-pages (drop/settings, drop/*/settings*) aren't working
  // views — they're admin surfaces. Suppress the section nav there so the
  // ticket/CRM/etc. working tabs don't spill into a settings context. See
  // tid 570.
  if ($path === 'drop/settings' || strpos($path, 'drop/settings/') === 0) {
    return NULL;
  }
  if (preg_match('#^drop/[^/]+/settings(/|$)#', $path)) {
    return NULL;
  }
  if (preg_match('#^drop/([^/]+)#', $path, $m)) {
    return $m[1];
  }
  return NULL;
}

/**
 * Checks whether a report belongs to a given section.
 *
 * @param array $report
 *   A report definition from hook_drop_reports().
 * @param string $section
 *   The section identifier (e.g. 'tickets').
 *
 * @return bool
 */
function _drop_base_report_in_section(array $report, $section) {
  if (empty($report['root_path'])) {
    return FALSE;
  }
  $prefix = 'drop/' . $section;
  return $report['root_path'] === $prefix
    || strpos($report['root_path'], $prefix . '/') === 0;
}

/**
 * Renders a sorted array of section nav links as HTML.
 *
 * @param array $links
 *   Sorted array of link definition arrays (see hook_drop_section_links).
 * @param array $extras
 *   Optional HTML strings to render flush-right in the nav bar.
 *
 * @return string|false
 *   Rendered nav HTML, or FALSE if no items to display.
 */
function _drop_base_render_section_nav(array $links, array $extras = array()) {
  $current       = current_path();
  $current_query = $_GET;
  unset($current_query['q']);
  $items = array();

  // Collect all query fingerprints used by query-bearing links so that plain
  // path links can exclude themselves when one of those fingerprints is active.
  $query_link_fingerprints = array();
  foreach ($links as $link) {
    if (!empty($link['options']['query'])) {
      $query_link_fingerprints[] = $link['options']['query'];
    }
  }

  foreach ($links as $link) {
    $href       = $link['href'];
    $link_query = !empty($link['options']['query']) ? $link['options']['query'] : NULL;

    if ($link_query) {
      // Query-bearing link: active only when path and all query params match.
      $path_match  = ($current === $href);
      $query_match = !array_diff_assoc($link_query, $current_query);
      $active = $path_match && $query_match;
    }
    else {
      // Plain path link: active on path match, but NOT when the current query
      // matches a query-bearing sibling link (e.g. ?status=discussions).
      $active = ($current === $href);
      if ($active) {
        foreach ($query_link_fingerprints as $fp) {
          if (!array_diff_assoc($fp, $current_query)) {
            $active = FALSE;
            break;
          }
        }
      }
      if (!$active && !empty($link['active_paths'])) {
        foreach ($link['active_paths'] as $ap) {
          if ($current === $ap || strpos($current, $ap . '/') === 0) {
            $active = TRUE;
            break;
          }
        }
      }
    }

    $classes = array('drop-snav__item');
    if ($active) {
      $classes[] = 'is-active';
    }
    if (!empty($link['admin_only'])) {
      $classes[] = 'drop-snav__item--admin';
    }
    if (!empty($link['pinned'])) {
      $classes[] = 'drop-snav__item--pinned';
    }

    $badge = '';
    if (!empty($link['badge'])) {
      $badge = '<span class="drop-snav__badge">' . check_plain((string) $link['badge']) . '</span>';
    }

    $title_html  = check_plain($link['title']) . $badge;
    $link_options = isset($link['options']) ? $link['options'] : array();
    $link_options['html'] = TRUE;
    $item_html  = l($title_html, $href, $link_options);
    $items[]    = '<li class="' . implode(' ', $classes) . '">' . $item_html . '</li>';
  }

  if (empty($items)) {
    return FALSE;
  }

  $extras_html = !empty($extras)
    ? '<div class="drop-snav__extras">' . implode('', $extras) . '</div>'
    : '';

  return '<nav class="drop-snav" aria-label="' . t('Section navigation') . '">'
    . '<ul class="drop-snav__list">' . implode('', $items) . '</ul>'
    . $extras_html
    . '</nav>';
}

/**
 * Implements hook_library().
 */
function drop_base_library() {
  return array(
    'drop_base' => array(
      'title'   => 'Drop Base styles',
      'website' => '',
      'version' => '1.x',
      'css'     => array(
        backdrop_get_path('module', 'drop_base') . '/drop_base.css' => array(),
      ),
    ),
  );
}

/**
 * Implements hook_page_build().
 *
 * Adds the shared CSS to every page so that DropCRM and DropTasks pages always
 * have access to the shared variables and utility classes without each page
 * callback needing to attach them individually.
 */
function drop_base_init() {
  backdrop_add_css(backdrop_get_path('module', 'drop_base') . '/drop_base.css');
}

/**
 * Returns the shared priority label array.
 *
 * @return array
 *   Keyed by integer priority value (0=none, 1=low, 2=normal, 3=high, 4=critical).
 */
function drop_base_priority_labels() {
  return array(
    0 => t('None'),
    1 => t('Low'),
    2 => t('Normal'),
    3 => t('High'),
    4 => t('Critical'),
  );
}

/**
 * Returns a CSS class suffix for a priority value.
 *
 * @param int $priority
 *   The priority integer value.
 *
 * @return string
 *   One of 'critical', 'high', 'normal', 'low', or 'none'.
 */
function drop_base_priority_class($priority) {
  $map = array(0 => 'none', 1 => 'low', 2 => 'normal', 3 => 'high', 4 => 'critical');
  return isset($map[$priority]) ? $map[$priority] : 'normal';
}

/**
 * Sets the page title with a "Lab" badge appended.
 *
 * Modules in Drop Suites Lab can call this instead of backdrop_set_title()
 * to visually flag their pages as experimental.
 *
 * @param string $title
 *   The page title (plain text — will be escaped).
 */
function drop_base_lab_title($title) {
  backdrop_set_title(
    check_plain($title) . ' <span class="drop-lab-badge">' . t('Lab') . '</span>',
    PASS_THROUGH
  );
}

/**
 * Returns a section header markup string for use in render arrays.
 *
 * Renders a flex row with the section title on the left and an optional
 * add-link (or group of add-links) on the right. Intended for entity view
 * pages across the Drop module family.
 *
 * @param string $title
 *   The section heading text (will be escaped).
 * @param string|null $add_link
 *   Optional already-rendered HTML to place on the right (e.g. from l() or a
 *   <span> of links). Passed through unescaped — callers are responsible for
 *   sanitising any user-derived values before passing them in.
 *
 * @return string
 *   HTML string for the section header div.
 */
function drop_base_section_header($title, $add_link = NULL) {
  $html = '<div class="drop-section-header"><h2>' . check_plain($title) . '</h2>';
  if ($add_link) {
    $html .= $add_link;
  }
  $html .= '</div>';
  return $html;
}

/**
 * Returns a page-level action links bar for entity view pages.
 *
 * Renders all links as plain anchors inside .drop-page-actions. The CSS
 * handles their appearance — callers must never add Backdrop button classes
 * ('button', 'button-secondary', etc.) to these links.
 *
 * @param array $links
 *   Array of already-rendered HTML strings produced by l() or equivalent.
 *   Empty entries are filtered out automatically.
 *
 * @return string
 *   HTML string for the action bar, or an empty string if no links provided.
 */
function drop_base_page_actions(array $links) {
  $links = array_filter($links);
  if (empty($links)) {
    return '';
  }
  return '<div class="drop-page-actions">' . implode('', $links) . '</div>';
}

