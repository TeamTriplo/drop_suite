/**
 * Page callback: Team directory.
 *
 * Displays all active team members with their last-seen time.
 */
function drop_base_team_page() {
  backdrop_set_title(t('Team'));

  $uids = db_select('users', 'u')
    ->fields('u', array('uid'))
    ->condition('u.status', 1)
    ->condition('u.uid', 0, '>')
    ->orderBy('u.access', 'DESC')
    ->execute()
    ->fetchCol();

  $accounts = $uids ? user_load_multiple($uids) : array();
  $ordered = array();
  foreach ($uids as $uid) {
    if (isset($accounts[$uid])) {
      $ordered[$uid] = $accounts[$uid];
    }
  }

  $role_labels = user_roles();
  $can_see_tickets = module_exists('droptickets') && user_access('access droptickets');
  $can_see_users   = user_access('access user profiles');
  $has_crm_link    = module_exists('dropcrm_user');

  $rows = array();
  foreach ($ordered as $account) {
    $last_seen = $account->access
      ? t('@time ago', array('@time' => format_interval(REQUEST_TIME - $account->access)))
      : t('Never');

    // Name links to user profile when available, otherwise plain.
    $name = $can_see_users
      ? l($account->name, 'user/' . $account->uid)
      : check_plain($account->name);

    $user_role_labels = array();
    $account_roles = !empty($account->roles) ? $account->roles : array();
    foreach ($account_roles as $role_name) {
      if ($role_name === BACKDROP_AUTHENTICATED_ROLE || $role_name === BACKDROP_ANONYMOUS_ROLE) {
        continue;
      }
      if (isset($role_labels[$role_name])) {
        $user_role_labels[] = check_plain($role_labels[$role_name]);
      }
    }
    $roles_display = $user_role_labels ? implode(', ', $user_role_labels) : '—';

    // Contextual links: Tickets + Contact (if each is available).
    $links = array();
    if ($can_see_tickets) {
      $links[] = l(t('Tickets'), 'drop/tickets/member/' . $account->uid);
    }
    if ($has_crm_link) {
      $contact = dropcrm_user_get_contact($account->uid);
      if ($contact) {
        $links[] = l(t('Contact'), 'drop/crm/contact/' . $contact->cid);
      }
    }
    $links_display = $links ? implode(' · ', $links) : '—';

    $rows[] = array($name, $roles_display, $last_seen, $links_display);
  }

  return array(
    '#theme'  => 'table',
    '#header' => array(t('Name'), t('Roles'), t('Last online'), t('Links')),
    '#rows'   => $rows,
    '#attributes' => array('class' => array('drop-team-table')),
  );
}

