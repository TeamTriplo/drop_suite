/**
 * Page callback: Team directory.
 *
 * Displays all active team members with their last-seen time.
 */
function drop_base_team_page() {
  backdrop_set_title(t('Team'));

  $accounts = db_select('users', 'u')
    ->fields('u', array('uid', 'name', 'access'))
    ->condition('u.status', 1)
    ->condition('u.uid', 0, '>')
    ->orderBy('u.access', 'DESC')
    ->execute()
    ->fetchAll();

  $can_see_tickets = module_exists('droptickets') && user_access('access droptickets');

  $rows = array();
  foreach ($accounts as $account) {
    $last_seen = $account->access
      ? t('@time ago', array('@time' => format_interval(REQUEST_TIME - $account->access)))
      : t('Never');
    $name = $can_see_tickets
      ? l($account->name, 'drop/tickets/member/' . $account->uid)
      : check_plain($account->name);
    $rows[] = array($name, $last_seen);
  }

  return array(
    '#theme'  => 'table',
    '#header' => array(t('Name'), t('Last online')),
    '#rows'   => $rows,
    '#attributes' => array('class' => array('drop-team-table')),
  );
}

// ---------------------------------------------------------------------------
// Drop Suite permissions page
// ---------------------------------------------------------------------------

/**
 * Page callback: filtered permissions form showing only Drop Suite modules.
 */
function drop_base_permissions_page() {
  module_load_include('inc', 'user', 'user.admin');
  return backdrop_get_form('user_admin_permissions');
}

/**
 * Grants all of a module's permissions to the site's administrator role.
 *
 * Call from a Drop module's hook_install() so that fresh sites don't require
 * a manual visit to the permissions page to unlock new permissions. Idempotent.
 *
 * @param string $module_name
 *   Machine name of the module whose permissions should be granted.
 */
function drop_base_grant_admin_permissions($module_name) {
  $admin_role = config_get('system.core', 'user_admin_role');
  if (!$admin_role || $admin_role === 'anonymous') {
    return;
  }
  $perms = module_invoke($module_name, 'permission');
  if (empty($perms)) {
    return;
  }
  user_role_grant_permissions($admin_role, array_keys($perms));
}

/**
 * Returns per-user display preferences merged with defaults.
 *
 * Prefs live in $account->data['drop_display'] so no schema change is needed.
 *
 * @param object|null $account
 *   The user account, or NULL to use the logged-in user.
 *
 * @return array
 *   Array with keys: page_width, kanban_col_width.
 */
function drop_base_get_user_display_prefs($account = NULL) {
  if ($account === NULL) {
    global $user;
    $account = $user;
  }
  $defaults = array(
    'page_width' => 'standard',
    'kanban_col_width' => 'standard',
  );
  if (empty($account->uid)) {
    return $defaults;
  }
  $saved = array();
  if (!empty($account->data) && is_array($account->data) && !empty($account->data['drop_display']) && is_array($account->data['drop_display'])) {
    $saved = $account->data['drop_display'];
  }
  return $saved + $defaults;
}

/**
 * Implements hook_preprocess_page().
 *
 * Adds body classes reflecting the current user's display preferences so that
 * CSS custom properties can cascade per-user without page-specific code.
 * Backdrop adds body classes in template_preprocess_page(), not _html().
 */
function drop_base_preprocess_page(&$variables) {
  $prefs = drop_base_get_user_display_prefs();
  if ($prefs['page_width'] !== 'standard') {
    $variables['classes'][] = 'drop-page-width-' . $prefs['page_width'];
  }
  if ($prefs['kanban_col_width'] !== 'standard') {
    $variables['classes'][] = 'drop-kanban-col-' . $prefs['kanban_col_width'];
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for user_profile_form.
 *
 * Adds a Display preferences fieldset to the user edit form.
 */
function drop_base_form_user_profile_form_alter(&$form, &$form_state, $form_id) {
  $account = isset($form['#user']) ? $form['#user'] : NULL;
  $prefs = drop_base_get_user_display_prefs($account);

  $form['drop_display'] = array(
    '#type' => 'fieldset',
    '#title' => t('Display preferences'),
    '#description' => t('Controls how Drop Suite pages are laid out for you. Other people see their own preferences.'),
    '#weight' => 5,
    '#tree' => TRUE,
  );
  $form['drop_display']['page_width'] = array(
    '#type' => 'select',
    '#title' => t('Page width'),
    '#description' => t('Maximum content width on Drop Suite pages.'),
    '#default_value' => $prefs['page_width'],
    '#options' => array(
      'narrow' => t('Narrow (1200px)'),
      'standard' => t('Standard (1600px)'),
      'wide' => t('Wide (1920px)'),
      'full' => t('Full (95% of viewport)'),
    ),
  );
  $form['drop_display']['kanban_col_width'] = array(
    '#type' => 'select',
    '#title' => t('Kanban column width'),
    '#description' => t('Width of columns on the Kanban board.'),
    '#default_value' => $prefs['kanban_col_width'],
    '#options' => array(
      'xcompact' => t('Extra compact (180px)'),
      'compact' => t('Compact (200px)'),
      'standard' => t('Standard (240px)'),
      'comfortable' => t('Comfortable (280px)'),
      'wide' => t('Wide (320px)'),
    ),
  );
}

/**
 * Implements hook_user_presave().
 *
 * Moves display preferences from the form-value property on the account into
 * the serialized {users}.data column.
 */
function drop_base_user_presave($account) {
  if (isset($account->drop_display) && is_array($account->drop_display)) {
    if (empty($account->data) || !is_array($account->data)) {
      $account->data = array();
    }
    $account->data['drop_display'] = $account->drop_display;
    unset($account->drop_display);
  }
}

/**
 * Returns the machine names of all modules in the "Drop Suite" package.
 *
 * Scanned dynamically from each module's .info file so new Drop modules are
 * picked up automatically without updating a hardcoded list.
 *
 * @return array
 *   Array of module machine names keyed by machine name (values are TRUE).
 */
function drop_base_get_drop_module_names() {
  $names = &backdrop_static(__FUNCTION__);
  if (isset($names)) {
    return $names;
  }
  $names = array();
  $all = system_rebuild_module_data();
  foreach ($all as $machine_name => $data) {
    if (!empty($data->info['package']) && $data->info['package'] === 'Drop Suite') {
      $names[$machine_name] = TRUE;
    }
  }
  return $names;
}

/**
 * Page callback: Drop Suite scoped modules form.
 */
function drop_base_modules_page() {
  module_load_include('inc', 'system', 'system.admin');
  return backdrop_get_form('system_modules');
}

/**
 * Implements hook_form_system_modules_alter().
 *
 * When rendering at drop/settings/modules, strips all non-Drop packages and
 * blocks enabling any Drop module whose non-Drop dependencies are not met.
 */
function drop_base_form_system_modules_alter(&$form, &$form_state, $form_id) {
  if (current_path() !== 'drop/settings/modules') {
    return;
  }

  backdrop_set_title(t('Drop Suite modules'));

  // Post the form back to our scoped path so users holding only
  // "administer drop suite modules" can submit it. Core's default action
  // points at admin/modules/list/confirm, which requires "administer modules".
  $form['#action'] = url('drop/settings/modules');

  // Hide the core filter reset link's path to stay within our scope.
  if (isset($form['filter']['reset']['#path'])) {
    $form['filter']['reset']['#path'] = 'drop/settings/modules';
  }

  $drop_modules = drop_base_get_drop_module_names();
  $all          = system_rebuild_module_data();

  // Strip every package fieldset except "Drop Suite".
  foreach (element_children($form['modules']) as $package) {
    if ($package !== 'Drop Suite') {
      unset($form['modules'][$package]);
    }
  }

  if (!isset($form['modules']['Drop Suite'])) {
    // Nothing to show — no Drop modules detected.
    return;
  }

  // For each Drop module, disable the checkbox if any non-Drop dependency is
  // not currently enabled. We do not auto-enable non-Drop modules — doing so
  // would silently widen the "administer drop suite modules" permission.
  foreach (element_children($form['modules']['Drop Suite']) as $module_name) {
    if (empty($all[$module_name]) || empty($all[$module_name]->requires)) {
      continue;
    }
    $missing = array();
    foreach ($all[$module_name]->requires as $dep => $v) {
      if (isset($drop_modules[$dep])) {
        // Drop-to-Drop dependency — core will handle it via its standard
        // confirmation flow.
        continue;
      }
      if (empty($all[$dep]) || empty($all[$dep]->status)) {
        $dep_label  = !empty($all[$dep]->info['name']) ? $all[$dep]->info['name'] : $dep;
        $missing[] = $dep_label;
      }
    }
    if (!empty($missing)) {
      $row = &$form['modules']['Drop Suite'][$module_name];
      if (isset($row['enable']['#type']) && $row['enable']['#type'] === 'checkbox') {
        $row['enable']['#disabled'] = TRUE;
      }
      $row['description']['#markup'] .= '<div class="admin-missing">' . t('Requires: @deps (not enabled). Ask a site administrator to enable these first.', array(
        '@deps' => implode(', ', $missing),
      )) . '</div>';
    }
  }

  // Defensive validate: refuse to enable anything not in the Drop package.
  $form['#validate'][] = 'drop_base_modules_form_validate';
}

/**
 * Form validation for the scoped modules form.
 *
 * Belt-and-suspenders — the form already strips non-Drop packages, but if a
 * user crafts a POST targeting a non-Drop module we reject it here rather than
 * hand it to system_modules_submit().
 */
function drop_base_modules_form_validate($form, &$form_state) {
  if (empty($form_state['values']['modules']) || !is_array($form_state['values']['modules'])) {
    return;
  }
  $drop_modules = drop_base_get_drop_module_names();
  foreach ($form_state['values']['modules'] as $package => $rows) {
    if ($package !== 'Drop Suite') {
      form_set_error('modules', t('You do not have permission to modify modules outside the Drop Suite package.'));
      return;
    }
    foreach ($rows as $module_name => $row) {
      if (!isset($drop_modules[$module_name])) {
        form_set_error('modules', t('You do not have permission to modify %module.', array('%module' => $module_name)));
        return;
      }
    }
  }
}

/**
 * Implements hook_form_user_admin_permissions_alter().
 *
 * When rendering at admin/drop/permissions, strips all non-Drop-Suite
 * permissions so only Drop module rows remain.
 */
function drop_base_form_user_admin_permissions_alter(&$form, &$form_state, $form_id) {
  if (current_path() !== 'admin/drop/permissions') {
    return;
  }

  $drop_modules = array(
    'drop_base',
    'drop_start',
    'dropbridge',
    'dropcrm',
    'dropdocs',
    'dropemail',
    'dropfiles',
    'dropgoals',
    'dropmonitor',
    'dropnewsletter',
    'dropstrategic',
    'droptasks',
    'droptickets',
    'droptime',
  );

  // Collect all permission keys that belong to Drop Suite modules.
  $drop_perms = array();
  foreach ($drop_modules as $module) {
    if (module_exists($module)) {
      $perms = module_invoke($module, 'permission');
      if ($perms) {
        foreach (array_keys($perms) as $perm_key) {
          $drop_perms[$perm_key] = TRUE;
        }
      }
    }
  }

  // Remove non-Drop rows from the permission list (module headers and perms).
  foreach (array_keys($form['permission']) as $key) {
    if (is_numeric($key)) {
      // Module header row — keep only Drop Suite module headers.
      if (!in_array($form['permission'][$key]['#id'], $drop_modules)) {
        unset($form['permission'][$key]);
      }
    }
    elseif (!isset($drop_perms[$key])) {
      // Permission row not in Drop Suite — remove it.
      unset($form['permission'][$key]);
    }
  }

  // Filter checkbox options to only Drop Suite permissions.
  foreach (array_keys($form['checkboxes']) as $role_name) {
    $form['checkboxes'][$role_name]['#options'] = array_intersect_key(
      $form['checkboxes'][$role_name]['#options'],
      $drop_perms
    );
    $form['checkboxes'][$role_name]['#default_value'] = array_values(array_intersect(
      $form['checkboxes'][$role_name]['#default_value'],
      array_keys($drop_perms)
    ));
  }
}

// ---------------------------------------------------------------------------
// Review mode helpers (shared across modules)
// ---------------------------------------------------------------------------

/**
 * Returns the IDs a user has marked as reviewed in a given namespace.
 *
 * @param string $namespace
 *   A module-specific key, e.g. 'tickets', 'organizations'.
 * @param int $uid
 *   The user ID.
 *
 * @return array
 *   Flat array of integer entity IDs.
 */
function drop_base_review_get($namespace, $uid) {
  $all = state_get('drop_review.' . $namespace, array());
  return isset($all[$uid]) && is_array($all[$uid]) ? $all[$uid] : array();
}

/**
 * Toggles the reviewed state of an entity for a user.
 *
 * @param string $namespace
 *   A module-specific key.
 * @param int $uid
 *   The user ID.
 * @param int $id
 *   The entity ID to toggle.
 *
 * @return bool
 *   TRUE if the entity is now reviewed, FALSE if it was unmarked.
 */
function drop_base_review_toggle($namespace, $uid, $id) {
  $state_key = 'drop_review.' . $namespace;
  $all  = state_get($state_key, array());
  $ids  = isset($all[$uid]) && is_array($all[$uid]) ? $all[$uid] : array();
  if (in_array($id, $ids)) {
    $ids = array_values(array_diff($ids, array($id)));
    $reviewed = FALSE;
  }
  else {
    $ids[]    = $id;
    $reviewed = TRUE;
  }
  $all[$uid] = $ids;
  state_set($state_key, $all);
  return $reviewed;
}

/**
 * Clears all reviewed flags for a user in a given namespace.
 *
 * @param string $namespace
 *   A module-specific key.
 * @param int $uid
 *   The user ID.
 */
function drop_base_review_clear($namespace, $uid) {
  $state_key = 'drop_review.' . $namespace;
  $all = state_get($state_key, array());
  unset($all[$uid]);
  state_set($state_key, $all);
}

/**
 * Implements hook_form_field_ui_field_overview_form_alter().
 *
 * Attaches Drop Suite admin CSS to the Field UI manage fields page when it is
 * displayed under a Drop entity admin path.
 */
function drop_base_form_field_ui_field_overview_form_alter(&$form, &$form_state) {
  // Only attach on Drop admin pages (paths starting with drop/).
  if (strpos(current_path(), 'drop/') === 0) {
    $form['#attached']['css'][] = backdrop_get_path('module', 'drop_base') . '/drop_base.admin.css';
  }
}

/**
 * Implements hook_form_field_ui_display_overview_form_alter().
 *
 * Attaches Drop Suite admin CSS to the Field UI manage display page when it is
 * displayed under a Drop entity admin path.
 */
function drop_base_form_field_ui_display_overview_form_alter(&$form, &$form_state) {
  if (strpos(current_path(), 'drop/') === 0) {
    $form['#attached']['css'][] = backdrop_get_path('module', 'drop_base') . '/drop_base.admin.css';
  }
}

// ---------------------------------------------------------------------------
// Shared emoji reactions (consumed by droptickets, dropupdates, etc.)
// ---------------------------------------------------------------------------

/**
 * Returns the canonical reaction palette as code => emoji character.
 *
 * Codes are ASCII-safe and stored in consumer tables. Characters are display
 * only. All Drop Suite modules that support reactions should call this so the
 * palette stays consistent.
 */
function drop_base_reaction_emojis() {
  return array(
    'thumbsup' => '👍',
    'heart'    => '❤️',
    'tada'     => '🎉',
    'eyes'     => '👀',
  );
}

/**
 * Renders a reaction button bar.
 *
 * Returns an HTML string: a `.drop-reactions` container with one `.react-btn`
 * per emoji in the palette. Empty buttons get the `react-btn--empty` class so
 * the CSS can hide them until the host element is hovered.
 *
 * @param array $reactions
 *   Reactions keyed by emoji code, each value an array of uids who reacted
 *   (consumer-provided).
 * @param array $accounts
 *   Optional uid => account lookup for building tooltip names.
 * @param array $options
 *   - react_url: (required) AJAX endpoint to POST {emoji: code} to.
 *   - data: optional associative array of extra data-* attributes for the bar.
 *
 * @return string
 */
function drop_base_render_reactions(array $reactions, array $accounts = array(), array $options = array()) {
  global $user;
  $emojis   = drop_base_reaction_emojis();
  $react_url = isset($options['react_url']) ? $options['react_url'] : '';

  $data_attrs = ' data-react-url="' . check_plain($react_url) . '"';
  if (!empty($options['data']) && is_array($options['data'])) {
    foreach ($options['data'] as $key => $val) {
      $data_attrs .= ' data-' . check_plain($key) . '="' . check_plain((string) $val) . '"';
    }
  }

  $html = '<div class="drop-reactions"' . $data_attrs . '>';
  foreach ($emojis as $code => $char) {
    $uids   = isset($reactions[$code]) ? $reactions[$code] : array();
    $count  = count($uids);
    $active = in_array((int) $user->uid, $uids) ? ' is-active' : '';
    $empty  = $count === 0 ? ' react-btn--empty' : '';
    $label  = $count > 0 ? $char . ' ' . $count : $char;

    $names = array();
    foreach ($uids as $uid) {
      if ($uid == $user->uid) {
        $names[] = t('You');
      }
      elseif (isset($accounts[$uid])) {
        $names[] = check_plain($accounts[$uid]->name);
      }
    }
    $title = $names ? $char . ' ' . implode(' · ', $names) : $char;

    $html .= '<button type="button" class="react-btn' . $active . $empty . '"'
      . ' data-emoji="' . check_plain($code) . '"'
      . ' data-char="' . check_plain($char) . '"'
      . ' title="' . check_plain($title) . '">' . $label . '</button>';
  }
  $html .= '</div>';
  return $html;
}

/**
 * Formats a reactions payload for the AJAX response.
 *
 * Consumers call this from their react AJAX handler after loading the fresh
 * reaction state from their own table. Returns the normalised shape the
 * shared JS behavior expects: { code: { count, user_reacted, names } }.
 */
function drop_base_format_reactions_response(array $reactions, $current_uid) {
  $all_uids = array();
  foreach ($reactions as $uids) {
    $all_uids = array_merge($all_uids, $uids);
  }
  $accounts = $all_uids ? user_load_multiple(array_unique($all_uids)) : array();

  $result = array();
  foreach ($reactions as $code => $uids) {
    $names = array();
    foreach ($uids as $uid) {
      if ($uid == $current_uid) {
        $names[] = t('You');
      }
      elseif (isset($accounts[$uid])) {
        $names[] = check_plain($accounts[$uid]->name);
      }
    }
    $result[$code] = array(
      'count'        => count($uids),
      'user_reacted' => in_array((int) $current_uid, $uids),
      'names'        => $names,
    );
  }
  return $result;
}

/**
 * Returns the #attached assets for a page that renders a reaction bar.
 *
 * Modules using drop_base_render_reactions() should merge this into their
 * page's #attached so the shared CSS/JS load.
 */
function drop_base_reactions_attached() {
  $path = backdrop_get_path('module', 'drop_base');
  return array(
    'css' => array($path . '/drop_base.reactions.css'),
    'js'  => array($path . '/drop_base.reactions.js'),
  );
}
