/**
 * Returns the effective health check URL for a project.
 *
 * If health_url is set, returns it directly. Otherwise calculates a
 * platform-appropriate URL from site_url that bypasses caching.
 *
 * @param object $project
 *   A project entity with site_url, platform, and health_url properties.
 *
 * @return string
 *   The URL to check, or empty string if no site_url is set.
 */
function drop_base_project_health_url($project) {
  // Manual override takes precedence.
  if (!empty($project->health_url)) {
    return $project->health_url;
  }

  if (empty($project->site_url)) {
    return '';
  }

  $base = rtrim($project->site_url, '/');
  $platform = isset($project->platform) ? $project->platform : '';

  switch ($platform) {
    case 'backdrop':
    case 'drupal':
      return $base . '/user/login';

    case 'wordpress':
      return $base . '/wp-login.php';

    default:
      // Cache-busting query parameter for unknown platforms.
      return $base . '?_monitor=' . time();
  }
}

