/**
 * Loads a single project entity by pid.
 *
 * Used as a menu wildcard loader for %drop_project.
 */
function drop_project_load($pid) {
  $projects = entity_load('drop_project', array((int) $pid));
  return $projects ? reset($projects) : FALSE;
}

/**
 * Title callback for project view pages.
 */
function drop_base_project_title($project) {
  return $project->name;
}

/**
 * View access callback for project listing pages.
 */
function drop_base_project_view_access() {
  return user_access('administer projects')
    || user_access('access projects');
}

/**
 * Access callback for drop_project entities.
 */
function drop_base_project_access($op, $project = NULL, $account = NULL) {
  global $user;
  if (!$account) {
    $account = $user;
  }

  if (user_access('administer projects', $account)) {
    return TRUE;
  }

  // View access.
  if ($op === 'view') {
    return user_access('access projects', $account);
  }

  if (!user_access('access projects', $account)) {
    return FALSE;
  }

  // Create access for anyone with project access.
  if ($op === 'create') {
    return TRUE;
  }

  // Update/delete: owner or admin only.
  return $project && $project->uid == $account->uid;
}

/**
 * Returns active projects as pid => name options array.
 *
 * @param int $uid
 *   Optional user ID to filter by owner. Pass 0 for all projects.
 *
 * @return array
 */
function drop_base_project_options($uid = 0) {
  $query = db_select('drop_project', 'p')
    ->fields('p', array('pid', 'name'))
    ->condition('p.active', 1)
    ->orderBy('p.name', 'ASC');
  if ($uid) {
    $query->condition('p.uid', $uid);
  }
  return $query->execute()->fetchAllKeyed();
}

