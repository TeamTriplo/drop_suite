<?php
/**
 * @file
 * Install, update, and uninstall functions for the Drop Base module.
 */

/**
 * Implements hook_schema().
 */
function drop_base_schema() {
  $schema = array();

  $schema['drop_project'] = array(
    'description' => 'Projects used across the Drop Suite for tickets, time tracking, and monitoring.',
    'fields' => array(
      'pid' => array(
        'type'     => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'name' => array(
        'type'     => 'varchar',
        'length'   => 255,
        'not null' => TRUE,
        'default'  => '',
        'description' => 'Project name.',
      ),
      'color' => array(
        'type'     => 'varchar',
        'length'   => 7,
        'not null' => TRUE,
        'default'  => '#1565c0',
        'description' => 'Display color as a CSS hex value.',
      ),
      'active' => array(
        'type'     => 'int',
        'size'     => 'tiny',
        'not null' => TRUE,
        'default'  => 1,
        'description' => '1 = active, 0 = archived.',
      ),
      'cid' => array(
        'description' => 'Optional linked CRM contact ID.',
        'type'        => 'int',
        'unsigned'    => TRUE,
        'not null'    => FALSE,
        'default'     => NULL,
      ),
      'prefix' => array(
        'description' => 'Short prefix for ticket numbers, e.g. TRIP for TRIP-42.',
        'type'        => 'varchar',
        'length'      => 10,
        'not null'    => FALSE,
        'default'     => NULL,
      ),
      'ticket_counter' => array(
        'description' => 'Auto-incrementing counter for ticket labels within this project.',
        'type'        => 'int',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
        'default'     => 0,
      ),
      'site_url' => array(
        'description' => 'Website URL for the project (used by uptime monitoring).',
        'type'        => 'varchar',
        'length'      => 255,
        'not null'    => TRUE,
        'default'     => '',
      ),
      'platform' => array(
        'description' => 'CMS platform: backdrop, drupal, wordpress, or other.',
        'type'        => 'varchar',
        'length'      => 20,
        'not null'    => TRUE,
        'default'     => '',
      ),
      'health_url' => array(
        'description' => 'Custom health check URL. If empty, auto-calculated from site_url + platform.',
        'type'        => 'varchar',
        'length'      => 255,
        'not null'    => TRUE,
        'default'     => '',
      ),
      'gentle_monitor' => array(
        'description' => 'Use gentle monitoring: homepage check, browser-like User-Agent, HEAD request.',
        'type'        => 'int',
        'size'        => 'tiny',
        'not null'    => TRUE,
        'default'     => 0,
      ),
      'check_interval' => array(
        'description' => 'Uptime check interval in minutes. Default 5.',
        'type'        => 'int',
        'size'        => 'small',
        'not null'    => TRUE,
        'default'     => 5,
      ),
      'server_sid' => array(
        'description' => 'Linked Drop Monitor server ID.',
        'type'        => 'int',
        'unsigned'    => TRUE,
        'not null'    => FALSE,
        'default'     => NULL,
      ),
      'agent_site_key' => array(
        'description' => 'Site key from the monitoring agent (matches the label in the agent JSON).',
        'type'        => 'varchar',
        'length'      => 255,
        'not null'    => TRUE,
        'default'     => '',
      ),
      'uid' => array(
        'type'     => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default'  => 0,
      ),
      'created' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'changed' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
    ),
    'primary key' => array('pid'),
    'indexes' => array(
      'uid'    => array('uid'),
      'active' => array('active'),
      'server_sid' => array('server_sid'),
      'cid'    => array('cid'),
    ),
  );

  return $schema;
}

/**
 * Implements hook_install().
 */
function drop_base_install() {
  // Rebuild the menu router first so that drop/settings (defined in
  // drop_base_menu()) is a known path. Without this, menu_link_save()
  // silently fails because it can't find a matching router_path.
  menu_rebuild();

  // Create a "Drop Suite" link in the primary navigation menu.
  $item = array(
    'link_title' => 'Drop Suite',
    'link_path'  => 'drop/settings',
    'weight'     => 50,
  );
  $mlid = menu_link_save($item);

  if ($mlid) {
    backdrop_set_message(t('Drop Suite menu link created in primary navigation (mlid: @mlid).', array('@mlid' => $mlid)));
  }
  else {
    backdrop_set_message(t('Failed to create Drop Suite menu link. The path drop/settings may not be registered yet.'), 'warning');
  }

  // Switch the default layout to the Drop Suite layout template, then add
  // Drop Suite blocks to the TOP region.
  _drop_base_setup_default_layout();

  // Grant drop_base's own permissions to the site administrator role.
  drop_base_grant_admin_permissions('drop_base');

  // The Backdrop home page uses its own layout, so Drop Suite navigation is
  // not shown there by default. Point the Site Architect at an opt-in page
  // that can add the nav blocks to the home layout when they're ready.
  backdrop_set_message(t('The Backdrop home page uses its own layout. If you want Drop Suite navigation to appear there, visit !link.', array(
    '!link' => l(t('Home page navigation setup'), 'drop/settings/home-nav'),
  )));
}

/**
 * Switches the default layout to the Drop Suite template and sets up the
 * TOP region with Drop Suite blocks.
 *
 * - Changes the layout template to drop_suite
 * - Removes the "Page title combo" block
 * - Adds: Page title, Drop Navigation, Drop Pin Action, Drop Section Navigation
 */
function _drop_base_setup_default_layout() {
  $layout = layout_load('default');
  if (!$layout) {
    backdrop_set_message(t('Could not load the default layout to add Drop Suite blocks.'), 'warning');
    return;
  }

  // Switch to the Drop Suite layout template.
  $layout->layout_template = 'drop_suite';

  // Ensure the positions array has all Drop Suite regions.
  foreach (array('header', 'navigation', 'messages', 'top', 'content', 'sidebar', 'bottom', 'footer') as $region) {
    if (!isset($layout->positions[$region])) {
      $layout->positions[$region] = array();
    }
  }

  // Remove the "Page title combo" block if present.
  foreach ($layout->content as $uuid => $block) {
    if (isset($block->plugin) && $block->plugin === 'system:page_components:title_combo') {
      $layout->removeBlock($uuid);
      break;
    }
  }

  // Ensure essential PageComponents blocks are present. Check each one and
  // add it if missing — the core default layout may not include all of them.
  $essential_blocks = array(
    'system:page_components:tabs',
    'system:page_components:messages',
    'system:page_components:action_links',
  );
  foreach ($essential_blocks as $plugin) {
    $found = FALSE;
    foreach ($layout->content as $block) {
      if (isset($block->plugin) && $block->plugin === $plugin) {
        $found = TRUE;
        break;
      }
    }
    if (!$found) {
      // Plugin format is "module:delta" where delta may contain colons.
      $colon = strpos($plugin, ':');
      $module = substr($plugin, 0, $colon);
      $delta = substr($plugin, $colon + 1);
      $layout->addBlock($module, $delta, 'top');
    }
  }

  // Add Drop Suite blocks to the TOP region.
  $layout->addBlock('system', 'page_components:title', 'top');
  $layout->addBlock('drop_base', 'drop_nav', 'top');
  $layout->addBlock('drop_base', 'drop_pin_action', 'top');
  $layout->addBlock('drop_base', 'drop_section_nav', 'top');

  // Reorder the TOP region so Local Tasks (page_components:tabs) renders
  // below Drop Section Navigation, not above the main nav. Core's default
  // layout places tabs first; Drop Suite's two-tier nav (drop_nav +
  // drop_section_nav) renders inside the same region, so left alone the
  // tabs bar visually precedes the nav. Per the Drop Suite style guide's
  // Navigation section, Local Tasks should sit between the section nav
  // and the page title/content.
  _drop_base_reorder_tabs_below_section_nav($layout);

  $layout->save();
  backdrop_set_message(t('Drop Suite layout and blocks configured.'));
}

/**
 * Moves the page_components:tabs block in the TOP region so it renders
 * immediately after drop_base:drop_section_nav. Idempotent — if either
 * block is missing or the order is already correct, does nothing.
 *
 * Used by drop_base_install and the corresponding update hook so existing
 * sites self-heal on bee updb.
 */
function _drop_base_reorder_tabs_below_section_nav($layout) {
  if (empty($layout->positions['top'])) {
    return;
  }
  $tabs_uuid = NULL;
  $snav_uuid = NULL;
  foreach ($layout->content as $uuid => $block) {
    if (!isset($block->plugin)) {
      continue;
    }
    if ($block->plugin === 'system:page_components:tabs') {
      $tabs_uuid = $uuid;
    }
    elseif ($block->plugin === 'drop_base:drop_section_nav') {
      $snav_uuid = $uuid;
    }
  }
  if (!$tabs_uuid || !$snav_uuid) {
    return;
  }
  $positions = $layout->positions['top'];
  $tabs_pos = array_search($tabs_uuid, $positions, TRUE);
  $snav_pos = array_search($snav_uuid, $positions, TRUE);
  if ($tabs_pos === FALSE || $snav_pos === FALSE || $tabs_pos > $snav_pos) {
    // Already in correct order (or blocks missing from the region).
    return;
  }
  // Remove tabs from current position and insert immediately after snav.
  array_splice($positions, $tabs_pos, 1);
  // Recompute snav position after the removal.
  $snav_pos = array_search($snav_uuid, $positions, TRUE);
  array_splice($positions, $snav_pos + 1, 0, array($tabs_uuid));
  $layout->positions['top'] = $positions;
}

/**
 * Establish schema version baseline for Drop Base.
 *
 * The drop_project table already exists (created by dropcrm). This update
 * registers Drop Base as the schema owner going forward.
 */
function drop_base_update_1000() {
  return t('Drop Base now owns the drop_project table schema.');
}

/**
 * Schema version bump (menu link now created in hook_install only).
 */
function drop_base_update_1100() {
  // No-op. Drop Suite menu link is only created on fresh installs.
}

/**
 * Add platform and health_url columns to drop_project.
 */
function drop_base_update_1200() {
  if (!db_field_exists('drop_project', 'platform')) {
    db_add_field('drop_project', 'platform', array(
      'description' => 'CMS platform: backdrop, drupal, wordpress, or other.',
      'type'        => 'varchar',
      'length'      => 20,
      'not null'    => TRUE,
      'default'     => '',
    ));
  }
  if (!db_field_exists('drop_project', 'health_url')) {
    db_add_field('drop_project', 'health_url', array(
      'description' => 'Custom health check URL. If empty, auto-calculated from site_url + platform.',
      'type'        => 'varchar',
      'length'      => 255,
      'not null'    => TRUE,
      'default'     => '',
    ));
  }
  if (!db_field_exists('drop_project', 'gentle_monitor')) {
    db_add_field('drop_project', 'gentle_monitor', array(
      'type'    => 'int',
      'size'    => 'tiny',
      'not null' => TRUE,
      'default' => 0,
    ));
  }
  if (!db_field_exists('drop_project', 'check_interval')) {
    db_add_field('drop_project', 'check_interval', array(
      'type'    => 'int',
      'size'    => 'small',
      'not null' => TRUE,
      'default' => 5,
    ));
  }
}

/**
 * Import the drop_projects view if it doesn't exist.
 */
function drop_base_update_1201() {
  $view = views_get_view('drop_projects');
  if (!$view) {
    $module_path = backdrop_get_path('module', 'drop_base');
    $config_path = $module_path . '/config/views.view.drop_projects.json';
    if (file_exists($config_path)) {
      $data = json_decode(file_get_contents($config_path), TRUE);
      $config = config('views.view.drop_projects');
      $config->setData($data);
      $config->save();
      return t('Imported the drop_projects view.');
    }
  }
  return t('drop_projects view already exists.');
}

/**
 * Add server_sid and agent_site_key columns to drop_project.
 */
function drop_base_update_1202() {
  if (!db_field_exists('drop_project', 'server_sid')) {
    db_add_field('drop_project', 'server_sid', array(
      'description' => 'Linked Drop Monitor server ID.',
      'type'        => 'int',
      'unsigned'    => TRUE,
      'not null'    => FALSE,
      'default'     => NULL,
    ));
    db_add_index('drop_project', 'server_sid', array('server_sid'));
  }
  if (!db_field_exists('drop_project', 'agent_site_key')) {
    db_add_field('drop_project', 'agent_site_key', array(
      'description' => 'Site key from the monitoring agent.',
      'type'        => 'varchar',
      'length'      => 255,
      'not null'    => TRUE,
      'default'     => '',
    ));
  }
}

/**
 * Bump default narrow_page_width from 900 to 1000 (fits 3 settings cards across).
 *
 * Only migrates sites still holding the old default; leaves custom values alone.
 */
function drop_base_update_1203() {
  $config = config('drop_base.settings');
  if ((int) $config->get('narrow_page_width') === 900) {
    $config->set('narrow_page_width', 1000);
    $config->save();
  }
}

/**
 * Reorder the TOP region so Local Tasks renders below Drop Section Nav.
 *
 * Previously the page_components:tabs block sat at position 0 of the TOP
 * region, causing the View/Edit tabs bar to render above the main Drop Nav.
 * Per the Drop Suite style guide's Navigation section, tabs belong below
 * both navs and above the page title. Runs across every layout that uses
 * the Drop Suite template and has both tabs and drop_section_nav blocks.
 * Idempotent — re-running is a no-op.
 */
function drop_base_update_1204() {
  $layouts = layout_load_all();
  $updated = array();
  foreach ($layouts as $name => $layout) {
    if ($layout->layout_template !== 'drop_suite') {
      continue;
    }
    $before = isset($layout->positions['top']) ? $layout->positions['top'] : array();
    _drop_base_reorder_tabs_below_section_nav($layout);
    $after = isset($layout->positions['top']) ? $layout->positions['top'] : array();
    if ($before !== $after) {
      $layout->save();
      $updated[] = $name;
    }
  }
  if ($updated) {
    return t('Reordered the Local Tasks block in @count Drop Suite layout(s): @list.', array(
      '@count' => count($updated),
      '@list'  => implode(', ', $updated),
    ));
  }
  return t('No Drop Suite layouts needed reordering.');
}

