{
    "_config_name": "views.view.drop_projects",
    "name": "drop_projects",
    "description": "Project listing for the Drop Suite.",
    "module": "drop_base",
    "tag": "Drop Suite",
    "disabled": false,
    "base_table": "drop_project",
    "human_name": "Projects",
    "core": "1.x",
    "display": {
        "default": {
            "display_title": "Default",
            "display_plugin": "default",
            "display_options": {
                "query": {
                    "type": "views_query",
                    "options": []
                },
                "title": "Projects",
                "access": {
                    "type": "perm",
                    "perm": "access projects"
                },
                "style_plugin": "table",
                "style_options": {
                    "columns": {
                        "name": "name",
                        "prefix": "prefix",
                        "active": "active",
                        "site_url": "site_url"
                    },
                    "default": "name",
                    "info": {
                        "name": {
                            "sortable": true,
                            "default_sort_order": "asc",
                            "align": "",
                            "separator": ""
                        },
                        "prefix": {
                            "sortable": true,
                            "default_sort_order": "asc",
                            "align": "",
                            "separator": ""
                        },
                        "active": {
                            "sortable": true,
                            "default_sort_order": "desc",
                            "align": "",
                            "separator": ""
                        },
                        "site_url": {
                            "sortable": false,
                            "default_sort_order": "asc",
                            "align": "",
                            "separator": ""
                        }
                    }
                },
                "fields": {
                    "name": {
                        "id": "name",
                        "table": "drop_project",
                        "field": "name",
                        "label": "Project",
                        "element_label_colon": true
                    },
                    "prefix": {
                        "id": "prefix",
                        "table": "drop_project",
                        "field": "prefix",
                        "label": "Prefix",
                        "empty": "\u2014"
                    },
                    "active": {
                        "id": "active",
                        "table": "drop_project",
                        "field": "active",
                        "label": "Status",
                        "type": "custom",
                        "type_custom_true": "Active",
                        "type_custom_false": "Archived",
                        "not": false
                    },
                    "site_url": {
                        "id": "site_url",
                        "table": "drop_project",
                        "field": "site_url",
                        "label": "Website",
                        "empty": "\u2014"
                    },
                    "pid": {
                        "id": "pid",
                        "table": "drop_project",
                        "field": "pid",
                        "label": "Actions",
                        "alter": {
                            "alter_text": true,
                            "text": "<a href=\"/drop/projects/[pid]/edit\">Edit</a> · <a href=\"/drop/projects/[pid]/delete\">Delete</a>"
                        }
                    }
                },
                "sorts": {
                    "active": {
                        "id": "active",
                        "table": "drop_project",
                        "field": "active",
                        "order": "DESC"
                    },
                    "name": {
                        "id": "name",
                        "table": "drop_project",
                        "field": "name",
                        "order": "ASC"
                    }
                },
                "empty": {
                    "area": {
                        "id": "area",
                        "table": "views",
                        "field": "area",
                        "content": "No projects yet. <a href=\"/drop/projects/add\">Add your first project</a>."
                    }
                }
            }
        },
        "page": {
            "display_title": "Page",
            "display_plugin": "page",
            "display_options": {
                "path": "drop/projects",
                "menu": {
                    "type": "none"
                }
            }
        }
    }
}
