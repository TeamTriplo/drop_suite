<?php
/**
 * @file
 * Install, update, and uninstall functions for Drop Start.
 */

/**
 * Implements hook_install().
 */
function drop_start_install() {
  drop_base_grant_admin_permissions('drop_start');

  // Place the persistent wizard-progress block at the top of the default
  // layout's TOP region. The block renders empty once setup is complete.
  _drop_start_install_progress_block();

  backdrop_set_message(t('Drop Suite installed. <a href="@wizard">Run the setup wizard</a> to configure your site.', array(
    '@wizard' => url('drop/start'),
  )));
}

/**
 * Adds drop_start:wizard_progress to the default layout's TOP region, at
 * position 0 (above the Drop Navigation). Idempotent — does nothing if the
 * block is already placed.
 */
function _drop_start_install_progress_block() {
  module_load_include('install', 'drop_base');
  $layout = layout_load('default');
  if (!$layout) {
    return;
  }
  $uuid = _drop_base_ensure_block_in_region($layout, 'drop_start:wizard_progress', 'top');
  if (!$uuid) {
    // Already present — nothing to do. Don't re-save.
    return;
  }
  // Move the newly-added block to position 0 in the TOP region so it renders
  // above the Drop Navigation.
  if (!empty($layout->positions['top'])) {
    $positions = $layout->positions['top'];
    $positions = array_values(array_diff($positions, array($uuid)));
    array_unshift($positions, $uuid);
    $layout->positions['top'] = $positions;
  }
  $layout->save();
}

/**
 * Implements hook_schema().
 */
function drop_start_schema() {
  $schema['drop_start_content'] = array(
    'description' => 'Tracks sample content created by Drop Start for safe deletion.',
    'fields' => array(
      'id' => array(
        'description' => 'Primary key.',
        'type'        => 'serial',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
      ),
      'entity_type' => array(
        'description' => 'The entity type (e.g. drop_ticket, crm_contact, node).',
        'type'        => 'varchar',
        'length'      => 64,
        'not null'    => TRUE,
        'default'     => '',
      ),
      'entity_id' => array(
        'description' => 'The entity ID.',
        'type'        => 'int',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
        'default'     => 0,
      ),
      'created' => array(
        'description' => 'Unix timestamp when the sample content was created.',
        'type'        => 'int',
        'not null'    => TRUE,
        'default'     => 0,
      ),
    ),
    'primary key' => array('id'),
    'indexes' => array(
      'entity' => array('entity_type', 'entity_id'),
    ),
  );

  return $schema;
}

/**
 * Implements hook_uninstall().
 */
function drop_start_uninstall() {
  // Remove the tracking table — but do NOT delete the sample content itself.
  // If users want to clean up content they should use the UI before uninstalling.
}

/**
 * Place the persistent wizard-progress block on existing installs.
 *
 * Fresh installs get this via drop_start_install(). This update hook covers
 * sites that already had drop_start enabled before the block existed.
 */
function drop_start_update_1100() {
  _drop_start_install_progress_block();
  return t('Added the wizard-progress block to the default layout.');
}
