<?php
/**
 * @file
 * Drop CRM — A lightweight CRM for Backdrop CMS.
 *
 * Provides three entity types:
 *  - crm_contact: persons, organizations, and households
 *  - crm_contact_method: email, telephone, and address records
 *  - crm_activity: logged interactions and planned tasks
 */

/**
 * Default number of days before a client is flagged as needing an update.
 *
 * Used by the Clients report when drop_crm.settings:client_stale_days is unset.
 */
define('DROP_CRM_CLIENT_STALE_DAYS', 5);

// ---------------------------------------------------------------------------
// Autoload
// ---------------------------------------------------------------------------

/**
 * Implements hook_autoload_info().
 */
function drop_crm_autoload_info() {
  return array(
    'CrmContact'                    => 'drop_crm.entity.inc',
    'CrmContactController'          => 'drop_crm.entity.inc',
    'CrmContactUIController'        => 'drop_crm.entity.inc',
    'CrmContactMethod'              => 'drop_crm.entity.inc',
    'CrmContactMethodController'    => 'drop_crm.entity.inc',
    'CrmContactMethodUIController'  => 'drop_crm.entity.inc',
    'CrmActivity'                   => 'drop_crm.entity.inc',
    'CrmActivityController'         => 'drop_crm.entity.inc',
    'CrmActivityUIController'       => 'drop_crm.entity.inc',
    'CrmContribution'               => 'drop_crm.entity.inc',
    'CrmContributionController'     => 'drop_crm.entity.inc',
    'CrmContactInlineEntityFormController'                   => 'drop_crm.inline_entity_form.inc',
    'EntityReferenceSelectionHandlerGeneric_crm_contact'     => 'drop_crm.entity.inc',
  );
}

