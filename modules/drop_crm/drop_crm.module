/**
 * Implements hook_entity_info().
 */
function drop_crm_entity_info() {
  $info = array();

  // --- crm_contact ---
  $info['crm_contact'] = array(
    'label'         => t('CRM Contact'),
    'plural label'  => t('CRM Contacts'),
    'description'   => t('A person, organization, or household tracked by the CRM.'),
    'entity class'  => 'CrmContact',
    'controller class' => 'CrmContactController',
    'base table'    => 'crm_contact',
    'fieldable'     => TRUE,
    'entity keys'   => array(
      'id'     => 'cid',
      'bundle' => 'type',
      'label'  => 'name',
    ),
    'bundle keys'   => array('bundle' => 'type'),
    'bundles'       => array(
      'crm_person' => array(
        'label' => t('Person'),
        'admin' => array(
          'path'             => 'drop/crm/contacts/manage/crm_person',
          'access arguments' => array('administer crm'),
        ),
      ),
      'crm_organization' => array(
        'label' => t('Organization'),
        'admin' => array(
          'path'             => 'drop/crm/contacts/manage/crm_organization',
          'access arguments' => array('administer crm'),
        ),
      ),
      'crm_household' => array(
        'label' => t('Household'),
        'admin' => array(
          'path'             => 'drop/crm/contacts/manage/crm_household',
          'access arguments' => array('administer crm'),
        ),
      ),
    ),
    'view modes'    => array(
      'full'   => array('label' => t('Full'),   'custom settings' => FALSE),
      'teaser' => array('label' => t('Teaser'), 'custom settings' => TRUE),
    ),
    'uri callback'  => 'entity_class_uri',
    'access callback' => 'drop_crm_contact_access',
    'inline entity form' => array(
      'controller' => 'CrmContactInlineEntityFormController',
    ),
    'module'        => 'drop_crm',
    'admin ui'      => array(
      'path'             => 'drop/crm/contacts',
      'file'             => 'drop_crm.admin.inc',
      'controller class' => 'CrmContactUIController',
      'menu wildcard'    => '%crm_contact',
    ),
  );

  // --- crm_contact_method ---
  $info['crm_contact_method'] = array(
    'label'         => t('Contact Details'),
    'plural label'  => t('Contact Details'),
    'description'   => t('An email address, telephone number, postal address, or website/social URL for a contact.'),
    'entity class'  => 'CrmContactMethod',
    'controller class' => 'CrmContactMethodController',
    'base table'    => 'crm_contact_method',
    'fieldable'     => TRUE,
    'entity keys'   => array(
      'id'     => 'cmid',
      'bundle' => 'type',
      'label'  => 'value',
    ),
    'bundle keys'   => array('bundle' => 'type'),
    'bundles'       => array(
      'email'     => array('label' => t('Email')),
      'telephone' => array('label' => t('Telephone')),
      'address'   => array('label' => t('Address')),
      'url'       => array('label' => t('Website / Social')),
    ),
    'uri callback'  => 'entity_class_uri',
    'access callback' => 'drop_crm_contact_method_access',
    'module'        => 'drop_crm',
    'admin ui'      => array(
      'path'             => 'drop/crm/contact-methods',
      'file'             => 'drop_crm.admin.inc',
      'controller class' => 'CrmContactMethodUIController',
      'menu wildcard'    => '%crm_contact_method',
    ),
  );

  // --- crm_activity ---
  // Single implicit bundle (same name as entity type). Activity type is a
  // base-table field, not a bundle, so all activities share the same fields.
  $info['crm_activity'] = array(
    'label'         => t('CRM Activity'),
    'plural label'  => t('CRM Activities'),
    'description'   => t('A logged interaction or planned task associated with one or more contacts.'),
    'entity class'  => 'CrmActivity',
    'controller class' => 'CrmActivityController',
    'base table'    => 'crm_activity',
    'fieldable'     => TRUE,
    'entity keys'   => array(
      'id'    => 'aid',
      'label' => 'subject',
    ),
    'view modes'    => array(
      'full' => array('label' => t('Full'), 'custom settings' => FALSE),
    ),
    'uri callback'  => 'entity_class_uri',
    'access callback' => 'drop_crm_activity_access',
    'module'        => 'drop_crm',
    'admin ui'      => array(
      'path'             => 'drop/crm/activities',
      'file'             => 'drop_crm.admin.inc',
      'controller class' => 'CrmActivityUIController',
      'menu wildcard'    => '%crm_activity',
    ),
  );

  // --- crm_contribution ---
  $info['crm_contribution'] = array(
    'label'         => t('CRM Contribution'),
    'plural label'  => t('CRM Contributions'),
    'description'   => t('A donation, membership dues payment, event fee, or other incoming revenue record.'),
    'entity class'  => 'CrmContribution',
    'controller class' => 'CrmContributionController',
    'base table'    => 'crm_contribution',
    'fieldable'     => TRUE,
    'entity keys'   => array(
      'id' => 'cnid',
    ),
    'view modes'    => array(
      'full' => array('label' => t('Full'), 'custom settings' => FALSE),
    ),
    'uri callback'  => 'entity_class_uri',
    'access callback' => 'drop_crm_contribution_access',
    'module'        => 'drop_crm',
  );

  return $info;
}

// ---------------------------------------------------------------------------
// Entity property info (drives Views, metadata wrappers, tokens)
// ---------------------------------------------------------------------------

/**
 * Implements hook_entity_property_info_alter().
 *
 * Upgrades the project cid property to a crm_contact entity reference so
 * Views can create a relationship from projects to contacts.
 */
function drop_crm_entity_property_info_alter(&$info) {
  if (isset($info['drop_project']['properties']['cid'])) {
    $info['drop_project']['properties']['cid']['type'] = 'crm_contact';
    $info['drop_project']['properties']['cid']['label'] = t('Contact');
    $info['drop_project']['properties']['cid']['description'] = t('The CRM contact linked to this project.');
  }
}

/**
 * Implements hook_field_extra_fields().
 *
 * Exposes hardcoded contact properties to the Field UI "Manage display"
 * interface so they can be reordered and toggled per bundle.
 */
function drop_crm_field_extra_fields() {
  $extra = array();

  // Display pseudo-fields shared by all bundles.
  $shared_display = array(
    'status' => array(
      'label' => t('Status'),
      'description' => t('Active or inactive status badge.'),
      'weight' => -5,
    ),
    'contact_methods' => array(
      'label' => t('Contact details'),
      'description' => t('Phone, email, address, URL.'),
      'weight' => 10,
    ),
    'relationships' => array(
      'label' => t('Relationships'),
      'description' => t('Relationships to other contacts.'),
      'weight' => 15,
    ),
    'activities' => array(
      'label' => t('Activities'),
      'description' => t('Activity history.'),
      'weight' => 20,
    ),
  );

  // Person-specific display fields.
  $extra['crm_contact']['crm_person']['display'] = $shared_display;
  $extra['crm_contact']['crm_person']['display']['hero'] = array(
    'label' => t('Hero section'),
    'description' => t('Rating, job title, employer, tags, and action links.'),
    'weight' => -90,
  );

  // Organization-specific display fields.
  $extra['crm_contact']['crm_organization']['display'] = $shared_display;
  $extra['crm_contact']['crm_organization']['display']['affiliated_contacts'] = array(
    'label' => t('Affiliated people'),
    'description' => t('People who list this organization as their employer.'),
    'weight' => 5,
  );

  // Household display fields.
  $extra['crm_contact']['crm_household']['display'] = $shared_display;

  return $extra;
}

