// ---------------------------------------------------------------------------
// Permissions and access
// ---------------------------------------------------------------------------

/**
 * Returns whether the Outreach Goal feature's UI should be exposed.
 *
 * Gated on the drop_crm.settings:outreach_goal_enabled config flag, which
 * defaults to FALSE. Flipped via Drop Labs (drop_labs module) or, on
 * grandfathered sites, by drop_crm_update_1204().
 *
 * Only guards user-visible surfaces. The underlying schema column
 * (crm_activity.is_outreach), config keys, and state key stay in place
 * regardless so disabling the flag doesn't lose data.
 */
function _drop_crm_outreach_enabled() {
  return (bool) config_get('drop_crm.settings', 'outreach_goal_enabled');
}

/**
 * Implements hook_drop_labs_info().
 *
 * Declares Outreach Goal as an experimental feature that Drop Labs can
 * toggle. Has no effect unless drop_labs is installed — the hook is
 * dormant data then.
 */
function drop_crm_drop_labs_info() {
  return array(
    'outreach_goal' => array(
      'title'       => t('Outreach Goal'),
      'description' => t('Track an outreach pace (e.g. "@n calls per day") and see progress on the CRM settings dashboard and a dedicated report. Adds a "Count as outreach" checkbox to the activity edit form.', array('@n' => 3)),
      'caveats'     => t('Niche, Triplo-specific workflow that may not suit other users. Off by default on new sites.'),
      'module'      => 'drop_crm',
      'config_name' => 'drop_crm.settings',
      'config_key'  => 'outreach_goal_enabled',
      'default'     => FALSE,
    ),
  );
}

