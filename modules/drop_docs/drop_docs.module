<?php
/**
 * @file
 * Drop Docs — internal team documentation and wiki for the Drop Suite.
 *
 * Provides a 'doc' content type that is book-enabled. Navigation, ordering,
 * and parent/child relationships are handled by the core Book module. Doc
 * nodes are viewed at Backdrop's canonical node/{nid} path; this module just
 * provides the drop/docs landing page, the docs layout (with a book
 * navigation sidebar), and the Drop Suite nav/settings integration.
 */

// ---------------------------------------------------------------------------
// Display name helper
// ---------------------------------------------------------------------------

/**
 * Returns the configured display name for the docs section.
 *
 * @param string $variant
 *   Optional variant: 'singular', 'plural', 'full'. Defaults to 'plural'.
 *
 * @return string
 */
function drop_docs_display_name($variant = 'plural') {
  $name = config_get('drop_docs.settings', 'display_name');
  if (empty($name)) {
    $name = 'Docs';
  }

  switch ($variant) {
    case 'singular':
      return preg_match('/s$/i', $name) ? rtrim($name, 'sS') : $name;

    case 'full':
      $map = array(
        'Docs' => t('Documentation'),
        'Notes' => t('Notebook'),
        'Wiki' => t('Wiki'),
        'Knowledge Base' => t('Knowledge Base'),
        'Resources' => t('Resources'),
      );
      return isset($map[$name]) ? $map[$name] : $name;

    default:
      return $name;
  }
}

// ---------------------------------------------------------------------------
// Menu
// ---------------------------------------------------------------------------

/**
 * Implements hook_menu().
 */
function drop_docs_menu() {
  $items = array();

  $items['drop/docs'] = array(
    'title'            => 'Docs',
    'page callback'    => 'drop_docs_index_page',
    'access callback'  => 'user_access',
    'access arguments' => array('access drop_docs'),
    'file'             => 'drop_docs.pages.inc',
  );

  $items['drop/docs/settings'] = array(
    'title'            => 'Settings',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('drop_docs_settings_form'),
    'access callback'  => 'user_access',
    'access arguments' => array('administer drop_docs'),
    'type'             => MENU_LOCAL_TASK,
    'weight'           => 20,
    'file'             => 'drop_docs.pages.inc',
  );

  return $items;
}

// ---------------------------------------------------------------------------
// Permissions
// ---------------------------------------------------------------------------

/**
 * Implements hook_permission().
 */
function drop_docs_permission() {
  return array(
    'access drop_docs' => array(
      'title'       => t('Access Drop Docs'),
      'description' => t('View the internal documentation section.'),
    ),
    'administer drop_docs' => array(
      'title'       => t('Administer Drop Docs'),
      'description' => t('Manage documentation settings and structure.'),
    ),
    'view drop docs book content' => array(
      'title'       => t('View Drop Docs book content'),
      'description' => t('View any node that is a member of a book outline. Without this permission, anonymous (and other) users cannot view individual doc pages. The permission covers any content type used as a book page, not just Doc nodes.'),
    ),
  );
}

// ---------------------------------------------------------------------------
// Node access — gate book-member pages behind a permission
// ---------------------------------------------------------------------------

/**
 * Implements hook_node_access().
 *
 * Denies 'view' access to any node that is part of a book outline unless the
 * user has the 'view drop docs book content' permission. Book membership is
 * the test on purpose: "doc" isn't a dedicated content type in Backdrop's
 * book module — any content type configured as a book-child type becomes a
 * book page when it's placed in a book outline. Protecting by book
 * membership picks those up regardless of type, and leaves standalone doc
 * nodes (nodes not in any book) untouched.
 *
 * Admins with 'administer nodes' or 'bypass node access' are not affected,
 * because this hook only runs for the 'view' op and core handles those
 * bypass permissions elsewhere for non-view ops.
 */
/**
 * Implements hook_node_presave().
 *
 * Auto-assigns doc nodes to a new book outline if the caller didn't place them
 * in one. Orphan docs don't show on /drop/docs because the index only lists
 * book-rooted docs. Runs before book_node_insert/book_node_update, which pick
 * up the bid and create the menu link.
 */
function drop_docs_node_presave($node) {
  if (!isset($node->type) || $node->type !== 'doc') {
    return;
  }
  // Caller explicitly placed this node in a book (or ticked "Create a new
  // book" on the form). Leave it alone.
  if (!empty($node->book['bid']) && $node->book['bid'] !== 0 && $node->book['bid'] !== '0') {
    return;
  }
  // Existing node that's already in the book outline — don't re-root it.
  if (!empty($node->nid)) {
    $existing_bid = db_query(
      "SELECT bid FROM {book} WHERE nid = :nid",
      array(':nid' => $node->nid)
    )->fetchField();
    if ($existing_bid) {
      return;
    }
  }
  // Orphan doc — make it its own new book so it appears on /drop/docs.
  if (!isset($node->book) || !is_array($node->book)) {
    $node->book = array();
  }
  $node->book['bid'] = 'new';
}

function drop_docs_node_access($node, $op, $account) {
  if ($op !== 'view') {
    return NODE_ACCESS_IGNORE;
  }
  if (!is_object($node) || empty($node->book)) {
    return NODE_ACCESS_IGNORE;
  }
  // Admins short-circuit. 'bypass node access' and 'administer nodes' are the
  // Backdrop-standard escape hatches; we honour them so this can't lock a
  // site architect out of their own docs.
  if (user_access('bypass node access', $account) || user_access('administer nodes', $account)) {
    return NODE_ACCESS_IGNORE;
  }
  if (user_access('view drop docs book content', $account)) {
    return NODE_ACCESS_IGNORE;
  }
  return NODE_ACCESS_DENY;
}

// ---------------------------------------------------------------------------
// Drop Nav integration
// ---------------------------------------------------------------------------

/**
 * Implements hook_menu_local_tasks_alter().
 *
 * Strip all local tasks on the Docs landing page.
 */
function drop_docs_menu_local_tasks_alter(&$data, $router_item, $root_path) {
  if ($root_path !== 'drop/docs') {
    return;
  }
  if (!empty($data['tabs'][0]['output'])) {
    $data['tabs'][0]['output'] = array();
  }
}

/**
 * Implements hook_drop_nav_links().
 */
function drop_docs_drop_nav_links() {
  return array(
    array(
      'title'      => drop_docs_display_name(),
      'path'       => 'drop/docs',
      'permission' => 'access drop_docs',
      'weight'     => 50,
      'icon'       => 'book-open',
    ),
  );
}

/**
 * Implements hook_drop_section_links().
 */
function drop_docs_drop_section_links($section) {
  if ($section !== 'docs') {
    return array();
  }

  $links = array();
  $links['all'] = array(
    'title'  => t('All @name', array('@name' => drop_docs_display_name())),
    'href'   => 'drop/docs',
    'weight' => -10,
  );
  return $links;
}

// ---------------------------------------------------------------------------
// Settings dashboard integration
// ---------------------------------------------------------------------------

/**
 * Implements hook_drop_settings_info().
 */
function drop_docs_drop_settings_info() {
  return array(
    'drop_docs' => array(
      'title' => t('Drop Docs'),
      'description' => t('Display name and other settings.'),
      'path' => 'drop/docs/settings',
      'permission' => 'administer drop_docs',
      'weight' => 40,
    ),
  );
}

// ---------------------------------------------------------------------------
// Node form integration
// ---------------------------------------------------------------------------

/**
 * Implements hook_form_BASE_FORM_ID_alter() for doc_node_form.
 *
 * Sets Drop Suite breadcrumbs on the add/edit form.
 */
function drop_docs_form_doc_node_form_alter(&$form, &$form_state, $form_id) {
  $node    = $form['#node'];
  $is_edit = !empty($node->nid);

  $crumb = array(
    l(t('Home'), '<front>'),
    l(t('Drop Suite'), 'drop'),
    l(drop_docs_display_name(), 'drop/docs'),
  );
  if ($is_edit) {
    $crumb[] = l($node->title, 'node/' . $node->nid);
  }
  backdrop_set_breadcrumb($crumb);
}

// ---------------------------------------------------------------------------
// Node view tweaks
// ---------------------------------------------------------------------------

/**
 * Implements hook_preprocess_node() for doc nodes.
 *
 * Suppresses submitted-by metadata on doc views.
 */
function drop_docs_preprocess_node(&$variables) {
  if ($variables['node']->type !== 'doc') {
    return;
  }
  $variables['display_submitted'] = FALSE;
}

/**
 * Implements hook_preprocess_layout().
 *
 * Sets a Drop Suite breadcrumb on doc node view pages that includes a link
 * to the book root. Runs before blocks render so the breadcrumbs block picks
 * it up. Book module itself does not set breadcrumbs on node view.
 */
function drop_docs_preprocess_layout(&$variables) {
  $node = menu_get_object();
  if (empty($node) || empty($node->type) || $node->type !== 'doc') {
    return;
  }
  if (empty($node->book['bid'])) {
    return;
  }

  $crumb = array(
    l(t('Home'), '<front>'),
    l(t('Drop Suite'), 'drop'),
    l(drop_docs_display_name(), 'drop/docs'),
  );

  // If this node is not itself the book root, link to the root ancestor.
  if ($node->book['bid'] != $node->nid) {
    $root = node_load($node->book['bid']);
    if ($root) {
      $crumb[] = l($root->title, 'node/' . $root->nid);
    }
  }

  backdrop_set_breadcrumb($crumb);
}
